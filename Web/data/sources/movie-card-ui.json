{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Movie Card UI</title>\r\n\r\n    <link rel=\"stylesheet\" href=\"styles.css\">\r\n</head>\r\n<body>\r\n    <div id=\"card_container\" data-offset=\"2\">\r\n        <div class=\"pg\">\r\n          <img src=\"pngwing.png\" alt=\"\">\r\n        </div>\r\n        <div id=\"card\">\r\n          <div class=\"shine\"></div>\r\n          <div class=\"text-block\">\r\n            <h1>Deadpool 3 <small>(2024)</small></h1>\r\n            <h3>Action | Sci-fi</h3>\r\n            <p>\r\n                Wolverine is recovering from his injuries when he crosses paths with the loudmouth, Deadpool. They team up to defeat a common enemy.\r\n            </p>\r\n            <button>Watch Trailer</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/movie-card-ui/index.html","archivePath":"movie-card-ui/index.html"},{"name":"pngwing.png","relativePath":"pngwing.png","path":"../BibliotecaDeHtml_CSS/movie-card-ui/pngwing.png","archivePath":"movie-card-ui/pngwing.png"},{"name":"styles.css","relativePath":"styles.css","path":"../BibliotecaDeHtml_CSS/movie-card-ui/styles.css","archivePath":"movie-card-ui/styles.css"}]}
