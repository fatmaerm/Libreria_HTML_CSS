{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Fourier Epicycles</title>\n<meta name=\"description\" content=\"Rotating vectors of geometrically decaying radius rebuild a word from its own Fourier spectrum while the tip draws a glowing epicycle trace.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"scene\">\n  <div class=\"mesh\" aria-hidden=\"true\"></div>\n  <div class=\"halo halo-a\" aria-hidden=\"true\"></div>\n  <div class=\"halo halo-b\" aria-hidden=\"true\"></div>\n\n  <header class=\"masthead\">\n    <p class=\"eyebrow\"><span class=\"pip\"></span>Harmonic analysis engine</p>\n    <h1>Fourier Epicycles</h1>\n    <p class=\"lede\">A word is sampled, its centre subtracted, and the residual is expanded into a complex spectrum. Every kept coefficient becomes a rotating vector of fixed radius, and the chained tips redraw the letterforms one revolution at a time.</p>\n  </header>\n\n  <section class=\"stage\">\n    <div class=\"plate\">\n      <canvas id=\"plot\"></canvas>\n      <div class=\"layer mesh-fine\" aria-hidden=\"true\"></div>\n      <div class=\"layer scan\" aria-hidden=\"true\"></div>\n      <div class=\"layer grain\" aria-hidden=\"true\"></div>\n      <div class=\"layer vignette\" aria-hidden=\"true\"></div>\n      <div class=\"split\" aria-hidden=\"true\">\n        <div class=\"cell\"><span class=\"tag\">A &middot; Spectrum</span></div>\n        <div class=\"cell\"><span class=\"tag\">B &middot; Reconstruction</span></div>\n      </div>\n    </div>\n\n    <div class=\"readout\">\n      <div class=\"stat\"><span class=\"sk\">Harmonics</span><span class=\"sv\" id=\"sHarm\">0</span></div>\n      <div class=\"stat\"><span class=\"sk\">Live terms</span><span class=\"sv\" id=\"sTerms\">0</span></div>\n      <div class=\"stat\"><span class=\"sk\">Sweep</span><span class=\"sv\" id=\"sSweep\">0%</span></div>\n      <div class=\"stat\"><span class=\"sk\">Largest radius</span><span class=\"sv\" id=\"sRad\">0</span></div>\n      <div class=\"stat wide\"><span class=\"sk\">Cycle</span><span class=\"sv\" id=\"sLoop\">0.0 s</span></div>\n    </div>\n  </section>\n\n  <footer class=\"footing\">\n    <ul class=\"legend\">\n      <li><span class=\"swatch sw-a\"></span>Harmonic vector</li>\n      <li><span class=\"swatch sw-b\"></span>Construction circle</li>\n      <li><span class=\"swatch sw-c\"></span>Accumulated trace</li>\n    </ul>\n    <p class=\"note\">The trace never stops chasing the spectrum &mdash; each revolution closes the loop exactly where it began.</p>\n  </footer>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/fourier-epicycles/index.html","archivePath":"animaciones-fourier-epicycles/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/fourier-epicycles/script.js","archivePath":"animaciones-fourier-epicycles/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/fourier-epicycles/styles.css","archivePath":"animaciones-fourier-epicycles/styles.css"}]}
