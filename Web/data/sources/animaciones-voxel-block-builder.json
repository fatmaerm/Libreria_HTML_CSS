{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Voxel Block Builder</title>\n<meta name=\"description\" content=\"An isometric voxel monolith assembles block by block with edge glow, a build progress readout and a slowly drifting camera.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"glowfield\" aria-hidden=\"true\"></div>\n<main class=\"vox\">\n  <canvas class=\"vox-canvas\" id=\"stage\" role=\"img\" aria-label=\"An isometric voxel structure assembling itself one block at a time on a glowing plinth.\"></canvas>\n  <div class=\"vox-scan\" aria-hidden=\"true\"></div>\n  <div class=\"vox-edge\" aria-hidden=\"true\"></div>\n  <header class=\"vox-head\">\n    <span class=\"eyebrow\">Isometric Assembly</span>\n    <h1>Voxel Block Builder</h1>\n    <p>Each cube drops into the lattice along the build order, edge-lit, while the camera drifts around the plinth.</p>\n  </header>\n  <div class=\"vox-hud\">\n    <div class=\"hud-line\">\n      <span class=\"hud-key\">Stage</span>\n      <span class=\"hud-val\" id=\"stageLabel\">Standby</span>\n    </div>\n    <div class=\"vox-segs\" id=\"segs\" aria-hidden=\"true\"></div>\n    <div class=\"hud-line hud-foot\">\n      <span class=\"hud-dim\" id=\"countLabel\">000 / 000 voxels</span>\n      <span class=\"hud-dim\" id=\"pctLabel\">0%</span>\n    </div>\n  </div>\n  <div class=\"vox-meta\" aria-hidden=\"true\">\n    <span>Lattice</span>\n    <span id=\"metaStamp\">7 x 7 x 7</span>\n  </div>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/voxel-block-builder/index.html","archivePath":"animaciones-voxel-block-builder/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/voxel-block-builder/script.js","archivePath":"animaciones-voxel-block-builder/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/voxel-block-builder/styles.css","archivePath":"animaciones-voxel-block-builder/styles.css"}]}
