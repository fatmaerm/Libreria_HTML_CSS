{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Shopping Cart Preloader</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n    <div class=\"preloader\">\r\n        <svg class=\"cart\" role=\"img\" aria-label=\"Shopping cart line animation\" viewBox=\"0 0 128 128\" width=\"128px\" height=\"128px\" xmlns=\"http://www.w3.org/2000/svg\">\r\n            <g fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"8\">\r\n                <g class=\"cart__track\" stroke=\"hsla(0,10%,10%,0.1)\">\r\n                    <polyline points=\"4,4 21,4 26,22 124,22 112,64 35,64 39,80 106,80\" />\r\n                    <circle cx=\"43\" cy=\"111\" r=\"13\" />\r\n                    <circle cx=\"102\" cy=\"111\" r=\"13\" />\r\n                </g>\r\n                <g class=\"cart__lines\" stroke=\"currentColor\">\r\n                    <polyline class=\"cart__top\" points=\"4,4 21,4 26,22 124,22 112,64 35,64 39,80 106,80\" stroke-dasharray=\"338 338\" stroke-dashoffset=\"-338\" />\r\n                    <g class=\"cart__wheel1\" transform=\"rotate(-90,43,111)\">\r\n                        <circle class=\"cart__wheel-stroke\" cx=\"43\" cy=\"111\" r=\"13\" stroke-dasharray=\"81.68 81.68\" stroke-dashoffset=\"81.68\" />\r\n                    </g>\r\n                    <g class=\"cart__wheel2\" transform=\"rotate(90,102,111)\">\r\n                        <circle class=\"cart__wheel-stroke\" cx=\"102\" cy=\"111\" r=\"13\" stroke-dasharray=\"81.68 81.68\" stroke-dashoffset=\"81.68\" />\r\n                    </g>\r\n                </g>\r\n            </g>\r\n        </svg>\r\n        <div class=\"preloader__text\">\r\n            <p class=\"preloader__msg\">Bringing you the goods…</p>\r\n            <p class=\"preloader__msg preloader__msg--last\">This is taking long. Something’s wrong.</p>\r\n        </div>\r\n    </div>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/shopping-cart-preloader/index.html","archivePath":"shopping-cart-preloader/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/shopping-cart-preloader/style.css","archivePath":"shopping-cart-preloader/style.css"}]}
