{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>CSS Tab Indicator</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n    <div class=\"popup\">\r\n        <div class=\"tabs\">\r\n              <input type=\"radio\" id=\"tab1\" name=\"tab\" checked=\"true\">        \r\n            <label for=\"tab1\">Home</label>\r\n              <input type=\"radio\" id=\"tab2\" name=\"tab\">\r\n            <label for=\"tab2\">Blogs</label>\r\n              <input type=\"radio\" id=\"tab3\" name=\"tab\">\r\n            <label for=\"tab3\">Products</label>\r\n              <input type=\"radio\" id=\"tab4\" name=\"tab\">\r\n            <label for=\"tab4\">About Us</label>\r\n              <input type=\"radio\" id=\"tab5\" name=\"tab\">\r\n            <label for=\"tab5\">Contact Us</label>\r\n              <input type=\"radio\" id=\"tab6\" name=\"tab\">\r\n            <label for=\"tab6\">Service</label>\r\n            <div class=\"marker\">\r\n               <div id=\"top\"></div>\r\n               <div id=\"bottom\"></div>\r\n            </div>\r\n        </div>\r\n        \r\n      </div>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/css-tab-indicator/index.html","archivePath":"css-tab-indicator/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/css-tab-indicator/style.css","archivePath":"css-tab-indicator/style.css"}]}
