{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Teletext 80s Weather Screen</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"teletext-card\">\n    <div class=\"tt-header\">P101 CEEFAX 101 DOM 26 SEP</div>\n    <div class=\"tt-title\">CLIMA NACIONAL</div>\n    <div class=\"tt-body\">\n      <div class=\"row\"><span class=\"c-cyan\">CIUDAD</span><span class=\"c-yellow\">ESTADO</span><span class=\"c-green\">TEMP</span></div>\n      <div class=\"row\"><span>MADRID</span><span>DESPEJADO</span><span>24°C</span></div>\n      <div class=\"row\"><span>LONDRES</span><span>LLUVIA</span><span>16°C</span></div>\n      <div class=\"row\"><span>BERLÍN</span><span>NUBLADO</span><span>18°C</span></div>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/teletext-80s-weather-screen/index.html","archivePath":"teletext-80s-weather-screen/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/teletext-80s-weather-screen/LICENSE","archivePath":"teletext-80s-weather-screen/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/teletext-80s-weather-screen/styles.css","archivePath":"teletext-80s-weather-screen/styles.css"}]}
