{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Trick And Treat Toggle</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n\r\n<body>\r\n    <div class=\"content\">\r\n\r\n        <input type=\"checkbox\" id=\"btn\" checked>\r\n        <label for=\"btn\">\r\n            <span class=\"thumb\">\r\n                <div class=\"trick\">\r\n                    <div class=\"eyes\"></div>\r\n                    <div class=\"nose\"></div>\r\n                    <div class=\"mouth\"></div>\r\n                </div>\r\n                <div class=\"treat\"></div>\r\n            </span>\r\n            <span class=\"arms\">\r\n                <span class=\"arm-human\">\r\n                    <span class=\"hand-human\">\r\n                        <span class=\"finger\"></span>\r\n                        <span class=\"finger\"></span>\r\n                        <span class=\"finger\"></span>\r\n                        <span class=\"finger\"></span>\r\n                    </span>\r\n                    <span class=\"big-human\"></span>\r\n                </span>\r\n                <span class=\"arm-bones\">\r\n                    <span class=\"bone\"></span>\r\n                    <span class=\"bone\"></span>\r\n                    <span class=\"hand-bones\">\r\n                        <span class=\"bone\"></span>\r\n                        <span class=\"bone\"></span>\r\n                        <span class=\"bone\"></span>\r\n                        <span class=\"bone\"></span>\r\n                    </span>\r\n                    <span class=\"big-bones\"></span>\r\n                </span>\r\n            </span>\r\n        </label>\r\n\r\n    </div>\r\n</body>\r\n\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/trick-and-treat-toggle/index.html","archivePath":"trick-and-treat-toggle/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/trick-and-treat-toggle/style.css","archivePath":"trick-and-treat-toggle/style.css"}]}
