{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Icon Segmented Switch</title>\n<meta name=\"description\" content=\"Segmented control switcher with animated sliding pill indicator.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"seg-wrap\">\n  <div class=\"seg\" id=\"seg\">\n    <div class=\"seg-pill\" id=\"pill\"></div>\n    <button class=\"seg-btn active\" data-i=\"0\">☀️ Light</button>\n    <button class=\"seg-btn\" data-i=\"1\">🌙 Dark</button>\n    <button class=\"seg-btn\" data-i=\"2\">💻 System</button>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/icon-segmented-switch/index.html","archivePath":"icon-segmented-switch/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/icon-segmented-switch/LICENSE","archivePath":"icon-segmented-switch/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/icon-segmented-switch/script.js","archivePath":"icon-segmented-switch/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/icon-segmented-switch/styles.css","archivePath":"icon-segmented-switch/styles.css"}]}
