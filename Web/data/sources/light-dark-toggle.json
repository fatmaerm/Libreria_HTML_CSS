{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Light Dark Toggle</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n    <label for=\"theme\" class=\"theme\">\r\n        <span>Light</span>\r\n        <span class=\"theme__toggle-wrap\">\r\n            <input id=\"theme\" class=\"theme__toggle\" type=\"checkbox\" role=\"switch\" name=\"theme\" value=\"dark\">\r\n            <span class=\"theme__fill\"></span>\r\n            <span class=\"theme__icon\">\r\n                <span class=\"theme__icon-part\"></span>\r\n                <span class=\"theme__icon-part\"></span>\r\n                <span class=\"theme__icon-part\"></span>\r\n                <span class=\"theme__icon-part\"></span>\r\n                <span class=\"theme__icon-part\"></span>\r\n                <span class=\"theme__icon-part\"></span>\r\n                <span class=\"theme__icon-part\"></span>\r\n                <span class=\"theme__icon-part\"></span>\r\n                <span class=\"theme__icon-part\"></span>\r\n            </span>\r\n        </span>\r\n        <span>Dark</span>\r\n    </label>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/light-dark-toggle/index.html","archivePath":"light-dark-toggle/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/light-dark-toggle/style.css","archivePath":"light-dark-toggle/style.css"}]}
