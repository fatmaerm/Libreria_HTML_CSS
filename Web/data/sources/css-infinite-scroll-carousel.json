{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>CSS Infinite Scroll Carousel</title>\n<meta name=\"description\" content=\"Pure CSS infinite looping horizontal carousel with pause on hover.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"scroll-track\">\n  <div class=\"scroll-inner\">\n    <div class=\"scroll-card\"><span>React</span></div><div class=\"scroll-card\"><span>Vue</span></div><div class=\"scroll-card\"><span>Angular</span></div><div class=\"scroll-card\"><span>Svelte</span></div><div class=\"scroll-card\"><span>Next.js</span></div><div class=\"scroll-card\"><span>Nuxt</span></div><div class=\"scroll-card\"><span>Remix</span></div><div class=\"scroll-card\"><span>Astro</span></div><div class=\"scroll-card\"><span>SolidJS</span></div><div class=\"scroll-card\"><span>Qwik</span></div>\n    <div class=\"scroll-card\" aria-hidden=\"true\"><span>React</span></div><div class=\"scroll-card\" aria-hidden=\"true\"><span>Vue</span></div><div class=\"scroll-card\" aria-hidden=\"true\"><span>Angular</span></div><div class=\"scroll-card\" aria-hidden=\"true\"><span>Svelte</span></div><div class=\"scroll-card\" aria-hidden=\"true\"><span>Next.js</span></div><div class=\"scroll-card\" aria-hidden=\"true\"><span>Nuxt</span></div><div class=\"scroll-card\" aria-hidden=\"true\"><span>Remix</span></div><div class=\"scroll-card\" aria-hidden=\"true\"><span>Astro</span></div><div class=\"scroll-card\" aria-hidden=\"true\"><span>SolidJS</span></div><div class=\"scroll-card\" aria-hidden=\"true\"><span>Qwik</span></div>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/css-infinite-scroll-carousel/index.html","archivePath":"css-infinite-scroll-carousel/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../Creacione