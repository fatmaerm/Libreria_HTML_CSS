{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Color Palette Generator</title>\n<meta name=\"description\" content=\"Random color palette generator with copy-to-clipboard on click.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"palette-wrap\">\n  <h2>Color Palette</h2>\n  <p class=\"sub\">Click a swatch to copy the hex</p>\n  <div class=\"palette\" id=\"palette\"></div>\n  <button class=\"gen-btn\" id=\"genBtn\">🎲 Generate</button>\n  <div class=\"toast\" id=\"toast\"></div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/color-palette-generator/index.html","archivePath":"color-palette-generator/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/color-palette-generator/LICENSE","archivePath":"color-palette-generator/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/color-palette-generator/script.js","archivePath":"color-palette-generator/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/color-palette-generator/styles.css","archivePath":"color-palette-generator/styles.css"}]}
