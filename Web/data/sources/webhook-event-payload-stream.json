{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Webhook Event Payload Stream</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"stream-card\">\n    <div class=\"stream-head\">\n      <span class=\"live-tag\"><span class=\"dot\"></span>WEBHOOK LIVE</span>\n      <span class=\"event-type\">payment.succeeded</span>\n    </div>\n    <div class=\"stream-code\">\n      <div class=\"line\"><span class=\"k\">\"id\"</span>: <span class=\"s\">\"evt_3Mvw88\"</span>,</div>\n      <div class=\"line\"><span class=\"k\">\"amount\"</span>: <span class=\"n\">4900</span>,</div>\n      <div class=\"line\"><span class=\"k\">\"currency\"</span>: <span class=\"s\">\"usd\"</span>,</div>\n      <div class=\"line\"><span class=\"k\">\"status\"</span>: <span class=\"s\">\"paid\"</span></div>\n    </div>\n    <div class=\"stream-foot\">\n      <span class=\"resp-code\">HTTP 200 OK</span>\n      <span class=\"timestamp\">hace 2s</span>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/webhook-event-payload-stream/index.html","archivePath":"webhook-event-payload-stream/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/webhook-event-payload-stream/LICENSE","archivePath":"webhook-event-payload-stream/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/webhook-event-payload-stream/styles.css","archivePath":"webhook-event-payload-stream/styles.css"}]}
