{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>CSS Particle Orbit Animation</title>\n<meta name=\"description\" content=\"Multiple orbiting particles around a glowing core in pure CSS.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"orbit-system\">\n  <div class=\"core\"></div>\n  <div class=\"orbit-ring r1\"><div class=\"particle\"></div></div><div class=\"orbit-ring r2\"><div class=\"particle\"></div></div><div class=\"orbit-ring r3\"><div class=\"particle\"></div></div><div class=\"orbit-ring r4\"><div class=\"particle\"></div></div><div class=\"orbit-ring r5\"><div class=\"particle\"></div></div><div class=\"orbit-ring r6\"><div class=\"particle\"></div></div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/css-particle-orbit-animation/index.html","archivePath":"css-particle-orbit-animation/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/css-particle-orbit-animation/LICENSE","archivePath":"css-particle-orbit-animation/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/css-particle-orbit-animation/styles.css","archivePath":"css-particle-orbit-animation/styles.css"}]}
