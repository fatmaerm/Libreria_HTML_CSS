{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Expandable Info Card</title>\n<meta name=\"description\" content=\"Accordion-style expandable card with smooth height animation.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"exp-card\" id=\"card\">\n  <div class=\"card-header\" id=\"cardHeader\">\n    <div class=\"card-icon\">🧠</div>\n    <div>\n      <h2>AI Model Overview</h2>\n      <p>Click to expand details</p>\n    </div>\n    <span class=\"chevron\" id=\"chev\">▾</span>\n  </div>\n  <div class=\"card-body\" id=\"cardBody\">\n    <div class=\"body-inner\">\n      <p>This model was trained on 1T tokens using a distributed pipeline across 512 A100 GPUs.</p>\n      <ul><li>Parameters: 70B</li><li>Context: 128K tokens</li><li>Latency: 40ms p50</li></ul>\n    </div>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/expandable-info-card/index.html","archivePath":"expandable-info-card/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/expandable-info-card/LICENSE","archivePath":"expandable-info-card/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/expandable-info-card/script.js","archivePath":"expandable-info-card/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/expandable-info-card/styles.css","archivePath":"expandable-info-card/styles.css"}]}
