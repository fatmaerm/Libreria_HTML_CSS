{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Tab Menu Neon Underline</title>\n<meta name=\"description\" content=\"Tab navigation with sliding neon underline indicator.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"tabs-wrap\">\n  <div class=\"tabs\" id=\"tabs\">\n    <button class=\"tab active\" data-tab=\"overview\">Overview</button>\n    <button class=\"tab\" data-tab=\"code\">Code</button>\n    <button class=\"tab\" data-tab=\"preview\">Preview</button>\n    <button class=\"tab\" data-tab=\"settings\">Settings</button>\n    <div class=\"underline\" id=\"ul\"></div>\n  </div>\n  <div class=\"tab-content\" id=\"tc\">Content: Overview</div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/tab-menu-neon-underline/index.html","archivePath":"tab-menu-neon-underline/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/tab-menu-neon-underline/LICENSE","archivePath":"tab-menu-neon-underline/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/tab-menu-neon-underline/script.js","archivePath":"tab-menu-neon-underline/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/tab-menu-neon-underline/styles.css","archivePath":"tab-menu-neon-underline/styles.css"}]}
