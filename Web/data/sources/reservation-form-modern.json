{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Reservation Form Modern</title>\n<meta name=\"description\" content=\"Restaurant table reservation form with date picker and party size.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"res-card\">\n  <div class=\"res-header\"><span>🍽️</span><h2>Reserve a Table</h2></div>\n  <form class=\"res-form\" id=\"resForm\" novalidate>\n    <div class=\"res-row\">\n      <div class=\"res-field\"><label>Date</label><input type=\"date\" id=\"resDate\" required></div>\n      <div class=\"res-field\"><label>Time</label>\n        <select id=\"resTime\">\n          <option>12:00</option><option>12:30</option><option>13:00</option><option>18:00</option><option>18:30</option><option>19:00</option><option>19:30</option><option>20:00</option><option>20:30</option><option>21:00</option>\n        </select>\n      </div>\n    </div>\n    <div class=\"res-field\"><label>Guests</label>\n      <div class=\"stepper-ctrl\">\n        <button type=\"button\" id=\"rdec\">−</button><span id=\"guestCount\">2</span><button type=\"button\" id=\"rinc\">+</button>\n      </div>\n    </div>\n    <div class=\"res-field\"><label>Name</label><input type=\"text\" placeholder=\"Full name\" required></div>\n    <button class=\"res-btn\" type=\"submit\">Confirm Reservation</button>\n    <div class=\"res-ok\" id=\"resOk\" hidden>✅ Reservation confirmed!</div>\n  </form>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/reservation-form-modern/index.html","archivePath":"reservation-form-modern/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/reservation-form-modern/LICENSE","archivePath":"reservation-form-modern/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/reservation-form-modern/script.js","archivePath":"reservation-form-modern/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/reservation-form-modern/styles.css","archivePath":"reservation-form-modern/styles.css"}]}
