{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Spotlight Photo Gallery</title>\n<meta name=\"description\" content=\"Gallery with mouse-tracking spotlight that follows hover across items.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"spot-grid\" id=\"spotGrid\">\n  <div class=\"spot-item\" style=\"background:#0f172a\"><span class=\"spot-icon\">⚡</span><p class=\"spot-lbl\">Panel 1</p></div><div class=\"spot-item\" style=\"background:#1a1a2e\"><span class=\"spot-icon\">🌌</span><p class=\"spot-lbl\">Panel 2</p></div><div class=\"spot-item\" style=\"background:#1c1917\"><span class=\"spot-icon\">🔥</span><p class=\"spot-lbl\">Panel 3</p></div><div class=\"spot-item\" style=\"background:#14532d\"><span class=\"spot-icon\">🌿</span><p class=\"spot-lbl\">Panel 4</p></div><div class=\"spot-item\" style=\"background:#1c3547\"><span class=\"spot-icon\">🌊</span><p class=\"spot-lbl\">Panel 5</p></div><div class=\"spot-item\" style=\"background:#3b0764\"><span class=\"spot-icon\">💜</span><p class=\"spot-lbl\">Panel 6</p></div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/spotlight-photo-gallery/index.html","archivePath":"spotlight-photo-gallery/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/spotlight-photo-gallery/LICENSE","archivePath":"spotlight-photo-gallery/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/spotlight-photo-gallery/script.js","archivePath":"spotlight-photo-gallery/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/spotlight-photo-gallery/styles.css","archivePath":"spotlight-photo-gallery/styles.css"}]}
