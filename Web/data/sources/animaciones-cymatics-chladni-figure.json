{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Cymatics Chladni Figure</title>\n<meta name=\"description\" content=\"Real Chladni nodal figures computed from the square-plate standing wave equation and rendered as accumulating sand grains on a vibrating steel plate.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n\n<div class=\"lab\" aria-hidden=\"true\">\n  <div class=\"lab__grid\"></div>\n  <div class=\"lab__key\"></div>\n  <div class=\"lab__floor\"></div>\n</div>\n\n<main class=\"stage\">\n\n  <section class=\"rig\" aria-label=\"Chladni plate on an electrodynamic shaker\">\n\n    <div class=\"plate\">\n      <div class=\"plate__bezel\" aria-hidden=\"true\"></div>\n      <div class=\"plate__inner\">\n        <canvas class=\"plate__canvas\" id=\"plate\" width=\"480\" height=\"480\" role=\"img\" aria-label=\"Chladni nodal figure rendered from the square plate standing wave equation\"></canvas>\n        <div class=\"plate__sheen\" aria-hidden=\"true\"></div>\n        <div class=\"plate__grain\" aria-hidden=\"true\">\n          <svg><filter id=\"steelGrain\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.9\" numOctaves=\"2\" seed=\"31\" stitchTiles=\"stitch\" result=\"n\"/><feColorMatrix in=\"n\" type=\"saturate\" values=\"0\"/><feComponentTransfer><feFuncA type=\"linear\" slope=\"0.5\" intercept=\"0\"/></feComponentTransfer></filter><rect width=\"100%\" height=\"100%\" filter=\"url(#steelGrain)\"/></svg>\n        </div>\n        <div class=\"plate__vignette\" aria-hidden=\"true\"></div>\n        <div class=\"plate__axes\" aria-hidden=\"true\"><i></i><b></b></div>\n        <div class=\"ring\" aria-hidden=\"true\"></div>\n        <div class=\"ring ring--b\" aria-hidden=\"true\"></div>\n      </div>\n      <div class=\"plate__clamp\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></div>\n      <div class=\"plate__stem\" aria-hidden=\"true\"></div>\n    </div>\n\n    <div class=\"readout\" aria-hidden=\"true\">\n      <p class=\"readout__head\">\n        <span class=\"readout__dot\"></span>\n        <span>Standing wave analysis</span>\n      </p>\n      <dl class=\"rows\">\n        <div class=\"row\"><dt>Mode</dt><dd id=\"modeOut\">m 2 / n 3</dd></div>\n        <div class=\"row\"><dt>Frequency</dt><dd id=\"freqOut\">450 Hz</dd></div>\n        <div class=\"row\"><dt>Wavelength</dt><dd id=\"waveOut\">0.44 L</dd></div>\n        <div class=\"row\"><dt>Symmetry</dt><dd id=\"symOut\">4-fold</dd></div>\n        <div class=\"row\"><dt>Loop</dt><dd id=\"loopOut\">0 %</dd></div>\n        <div class=\"row\"><dt>Drive</dt><dd><span class=\"meter\"><span class=\"meter__fill\" id=\"driveBar\"></span></span></dd></div>\n      </dl>\n      <div class=\"spectrum\" id=\"spectrum\"></div>\n    </div>\n\n  </section>\n\n  <header class=\"hud hud--tl\">\n    <p class=\"eyebrow\">Acoustic Study Number Six</p>\n    <h1 class=\"title\">Cymatics Chladni Figure</h1>\n    <p class=\"lede\">Sand on a 240&nbsp;mm steel plate, electrodynamic exciter</p>\n  </header>\n\n  <footer class=\"hud hud--br\">\n    <p class=\"gauge\"><span class=\"gauge__k\">Equation</span><span class=\"gauge__v\">cos m&#960;x cos n&#960;y &#8722; cos n&#960;x cos m&#960;y</span></p>\n    <p class=\"gauge\"><span class=\"gauge__k\">Buffer</span><span class=\"gauge__v\" id=\"bufOut\">200 px</span></p>\n  </footer>\n\n  <p class=\"hint hud--bl\">Tap the plate to jump to the next eigenmode</p>\n\n</main>\n\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/cymatics-chladni-figure/index.html","archivePath":"animaciones-cymatics-chladni-figure/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/cymatics-chladni-figure/script.js","archivePath":"animaciones-cymatics-chladni-figure/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/cymatics-chladni-figure/styles.css","archivePath":"animaciones-cymatics-chladni-figure/styles.css"}]}
