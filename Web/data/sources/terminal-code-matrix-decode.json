{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Terminal Code Matrix Decode</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"terminal-box\">\n    <div class=\"terminal-bar\">\n      <div class=\"term-dots\">\n        <span></span><span></span><span></span>\n      </div>\n      <span class=\"term-title\">CIPHER_DECRYPTOR.SH</span>\n    </div>\n    <div class=\"terminal-body\">\n      <div class=\"prompt-line\">\n        <span class=\"prompt-user\">root@matrix:~$</span>\n        <span class=\"prompt-cmd\">decrypt --quantum-key 0x7F</span>\n      </div>\n      <div class=\"decode-target\" id=\"decodeTarget\" data-text=\"PROTOCOLO QUANTUM COMPLETO\">\n        PROTOCOLO QUANTUM COMPLETO\n      </div>\n      <div class=\"status-msg\">\n        <span class=\"status-badge\" id=\"statusBadge\">DESCRIPTADO CON ÉXITO</span>\n      </div>\n      <button class=\"rerun-btn\" id=\"rerunBtn\">Reiniciar descifrado</button>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/terminal-code-matrix-decode/index.html","archivePath":"terminal-code-matrix-decode/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/terminal-code-matrix-decode/LICENSE","archivePath":"terminal-code-matrix-decode/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/terminal-code-matrix-decode/script.js","archivePath":"terminal-code-matrix-decode/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/terminal-code-matrix-decode/styles.css","archivePath":"terminal-code-matrix-decode/styles.css"}]}
