{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Morphing Shape Animation</title>\n<meta name=\"description\" content=\"Pure CSS SVG path morphing blob animation with gradient fill.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"morph-wrap\">\n  <svg class=\"morph-svg\" viewBox=\"0 0 200 200\">\n    <defs>\n      <linearGradient id=\"mg\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n        <stop offset=\"0%\" stop-color=\"#6366f1\"/>\n        <stop offset=\"100%\" stop-color=\"#ec4899\"/>\n      </linearGradient>\n    </defs>\n    <path class=\"blob\" fill=\"url(#mg)\"/>\n  </svg>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/morphing-shape-animation/index.html","archivePath":"morphing-shape-animation/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/morphing-shape-animation/LICENSE","archivePath":"morphing-shape-animation/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/morphing-shape-animation/styles.css","archivePath":"morphing-shape-animation/styles.css"}]}
