{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Haptic Checkbox Toggle</title>\n<meta name=\"description\" content=\"Custom animated checkbox with checkmark stroke draw animation.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"checks\">\n  <label class=\"hcheck\"><input type=\"checkbox\"><div class=\"box\"><svg viewBox=\"0 0 20 20\"><polyline class=\"check-mark\" points=\"4,10 8,14 16,6\"/></svg></div><span>Enable notifications</span></label><label class=\"hcheck\"><input type=\"checkbox\"><div class=\"box\"><svg viewBox=\"0 0 20 20\"><polyline class=\"check-mark\" points=\"4,10 8,14 16,6\"/></svg></div><span>Dark mode</span></label><label class=\"hcheck\"><input type=\"checkbox\"><div class=\"box\"><svg viewBox=\"0 0 20 20\"><polyline class=\"check-mark\" points=\"4,10 8,14 16,6\"/></svg></div><span>Auto-save</span></label><label class=\"hcheck\"><input type=\"checkbox\"><div class=\"box\"><svg viewBox=\"0 0 20 20\"><polyline class=\"check-mark\" points=\"4,10 8,14 16,6\"/></svg></div><span>Send analytics</span></label>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/haptic-checkbox-toggle/index.html","archivePath":"haptic-checkbox-toggle/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/haptic-checkbox-toggle/LICENSE","archivePath":"haptic-checkbox-toggle/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/haptic-checkbox-toggle/styles.css","archivePath":"haptic-checkbox-toggle/styles.css"}]}
