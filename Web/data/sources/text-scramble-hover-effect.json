{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Text Scramble Hover Effect</title>\n<meta name=\"description\" content=\"Hover text scramble effect that randomly cycles characters before settling.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"scramble-wrap\">\n  <h1 class=\"scramble-text\" data-text=\"SCRAMBLE\" id=\"stxt\">SCRAMBLE</h1>\n  <p class=\"sub-hint\">Hover to glitch</p>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/text-scramble-hover-effect/index.html","archivePath":"text-scramble-hover-effect/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/text-scramble-hover-effect/LICENSE","archivePath":"text-scramble-hover-effect/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/text-scramble-hover-effect/script.js","archivePath":"text-scramble-hover-effect/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/text-scramble-hover-effect/styles.css","archivePath":"text-scramble-hover-effect/styles.css"}]}
