{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Snow Glacier Cascade</title>\n<meta name=\"description\" content=\"Four parallax layers of cascading snowfall drifting over a cold blue glacier wall and still meltwater lagoon in pure CSS.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"glacier\">\n  <div class=\"sky\"></div>\n  <div class=\"stars\"></div>\n  <div class=\"moon\"></div>\n  <div class=\"peaks peaks--far\"></div>\n  <div class=\"peaks peaks--mid\"></div>\n  <div class=\"haze\"></div>\n  <div class=\"shelf\"></div>\n  <div class=\"lagoon\"><span></span></div>\n  <div class=\"snow snow--mist\"><div class=\"fall fall--mist\"></div></div>\n  <div class=\"snow snow--mid\"><div class=\"fall fall--mid\"></div></div>\n  <div class=\"snow snow--near\"><div class=\"fall fall--near\"></div></div>\n  <div class=\"snow snow--bokeh\"><div class=\"fall fall--bokeh\"></div></div>\n  <div class=\"vignette\"></div>\n  <div class=\"grain\"></div>\n  <p class=\"caption\">Snow Glacier Cascade</p>\n</div>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/snow-glacier-cascade/index.html","archivePath":"animaciones-snow-glacier-cascade/index.html"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/snow-glacier-cascade/styles.css","archivePath":"animaciones-snow-glacier-cascade/styles.css"}]}
