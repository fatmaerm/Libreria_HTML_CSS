{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>File Upload Dropzone Modern</title>\n<meta name=\"description\" content=\"Modern drag-and-drop file upload zone with animated border and file list.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"dropzone\" id=\"dz\" tabindex=\"0\">\n  <div class=\"dz-inner\">\n    <span class=\"dz-icon\">📁</span>\n    <p class=\"dz-main\">Drop files here or <label class=\"dz-browse\" for=\"fileInput\">browse</label></p>\n    <p class=\"dz-hint\">PNG, JPG, PDF up to 10MB</p>\n    <input type=\"file\" id=\"fileInput\" multiple hidden>\n  </div>\n</div>\n<ul class=\"file-list\" id=\"fileList\"></ul>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/file-upload-dropzone-modern/index.html","archivePath":"file-upload-dropzone-modern/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/file-upload-dropzone-modern/LICENSE","archivePath":"file-upload-dropzone-modern/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/file-upload-dropzone-modern/script.js","archivePath":"file-upload-dropzone-modern/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/file-upload-dropzone-modern/styles.css","archivePath":"file-upload-dropzone-modern/styles.css"}]}
