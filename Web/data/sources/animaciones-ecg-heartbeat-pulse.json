{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>ECG Heartbeat Pulse</title>\n<meta name=\"description\" content=\"A PQRST electrocardiogram trace sweeps across medical grid paper with a glowing sweep line, live BPM readout and a heart pulse locked to the R spike.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"glowfield\" aria-hidden=\"true\"></div>\n<main class=\"ecg\">\n  <section class=\"ecg-screen\">\n    <canvas class=\"ecg-canvas\" id=\"trace\" role=\"img\" aria-label=\"A live ECG trace sweeping across medical grid paper, repeating the P Q R S T waveform once per heartbeat.\"></canvas>\n    <div class=\"ecg-scan\" aria-hidden=\"true\"></div>\n    <div class=\"ecg-inner\" aria-hidden=\"true\"></div>\n    <header class=\"ecg-head\">\n      <span class=\"eyebrow\">Lead II</span>\n      <h1>Heartbeat Pulse</h1>\n      <p>One PQRST complex per cycle, drawn from gaussian pulses and scrolled by a constant sweep.</p>\n    </header>\n    <div class=\"ecg-monitor\">\n      <div class=\"mon-heart\" id=\"heartWrap\">\n        <span class=\"heart-shape\" id=\"heart\"></span>\n        <span class=\"heart-ring\" id=\"ring\"></span>\n      </div>\n      <div class=\"mon-rate\">\n        <span class=\"mon-num\" id=\"bpm\">72</span>\n        <span class=\"mon-unit\">bpm</span>\n      </div>\n    </div>\n    <div class=\"ecg-meta\">\n      <div class=\"meta-row\"><span>RR</span><span id=\"rrVal\">833 ms</span></div>\n      <div class=\"meta-row\"><span>Beats</span><span id=\"beatVal\">0000</span></div>\n      <div class=\"meta-row\"><span>Gain</span><span>10 mm/mV</span></div>\n    </div>\n    <div class=\"ecg-phase\" id=\"phaseBar\" aria-hidden=\"true\">\n      <span data-p=\"p\">P</span>\n      <span data-p=\"qrs\">QRS</span>\n      <span data-p=\"t\">T</span>\n    </div>\n  </section>\n  <div class=\"ecg-strip\">\n    <canvas class=\"ecg-strip-canvas\" id=\"strip\" role=\"img\" aria-label=\"Reference strip labelling the P, Q, R, S and T components of a single cardiac cycle.\"></canvas>\n  </div>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/ecg-heartbeat-pulse/index.html","archivePath":"animaciones-ecg-heartbeat-pulse/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/ecg-heartbeat-pulse/script.js","archivePath":"animaciones-ecg-heartbeat-pulse/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/ecg-heartbeat-pulse/styles.css","archivePath":"animaciones-ecg-heartbeat-pulse/styles.css"}]}
