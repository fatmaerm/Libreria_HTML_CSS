{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Candle Flame Flicker</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"candle-scene\" aria-label=\"Vela cálida encendida con llama titilante\">\n    <div class=\"ambient-glow\"></div>\n    <div class=\"candle-assembly\">\n      <div class=\"flame-wrap\">\n        <div class=\"flame\">\n          <div class=\"flame-inner\"></div>\n          <div class=\"flame-blue\"></div>\n        </div>\n      </div>\n      <div class=\"wick\"></div>\n      <div class=\"wax-pool\"></div>\n      <div class=\"candle-cylinder\"></div>\n    </div>\n    <div class=\"candle-title\">LUZ SERENA // LLAMA VIVA</div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/candle-flame-flicker/index.html","archivePath":"candle-flame-flicker/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/candle-flame-flicker/LICENSE","archivePath":"candle-flame-flicker/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/candle-flame-flicker/styles.css","archivePath":"candle-flame-flicker/styles.css"}]}
