{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Zoom Hover Photo Gallery</title>\n<meta name=\"description\" content=\"Grid gallery with magnetic zoom reveal on hover.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"zoom-grid\">\n  <figure class=\"zfig\"><div class=\"zimg\" style=\"background:linear-gradient(135deg,#1a1a2e,#4a0080)\"></div><figcaption>Image 1</figcaption></figure><figure class=\"zfig\"><div class=\"zimg\" style=\"background:linear-gradient(135deg,#002040,#0080ff)\"></div><figcaption>Image 2</figcaption></figure><figure class=\"zfig\"><div class=\"zimg\" style=\"background:linear-gradient(135deg,#1a2e00,#40a000)\"></div><figcaption>Image 3</figcaption></figure><figure class=\"zfig\"><div class=\"zimg\" style=\"background:linear-gradient(135deg,#2e0000,#800000)\"></div><figcaption>Image 4</figcaption></figure><figure class=\"zfig\"><div class=\"zimg\" style=\"background:linear-gradient(135deg,#2e2000,#806000)\"></div><figcaption>Image 5</figcaption></figure><figure class=\"zfig\"><div class=\"zimg\" style=\"background:linear-gradient(135deg,#002e2e,#006060))\"></div><figcaption>Image 6</figcaption></figure>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/zoom-hover-photo-gallery/index.html","archivePath":"zoom-hover-photo-gallery/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/zoom-hover-photo-gallery/LICENSE","archivePath":"zoom-hover-photo-gallery/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/zoom-hover-photo-gallery/styles.css","archivePath":"zoom-hover-photo-gallery/styles.css"}]}
