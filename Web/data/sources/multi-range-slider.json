{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Multi Range Slider</title>\n<meta name=\"description\" content=\"Dual-handle price range slider with fill track between handles.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"mrange-wrap\">\n  <h3>Price Range</h3>\n  <div class=\"mrange\">\n    <div class=\"fill-track\" id=\"fillTrack\"></div>\n    <input type=\"range\" id=\"rmin\" min=\"0\" max=\"1000\" value=\"200\">\n    <input type=\"range\" id=\"rmax\" min=\"0\" max=\"1000\" value=\"700\">\n  </div>\n  <div class=\"labels\"><span id=\"lmin\">$200</span><span id=\"lmax\">$700</span></div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/multi-range-slider/index.html","archivePath":"multi-range-slider/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/multi-range-slider/LICENSE","archivePath":"multi-range-slider/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/multi-range-slider/script.js","archivePath":"multi-range-slider/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/multi-range-slider/styles.css","archivePath":"multi-range-slider/styles.css"}]}
