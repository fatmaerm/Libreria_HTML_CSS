{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Mobius Infinity Loop</title>\n<meta name=\"description\" content=\"A morphing Mobius strip drawn by an animated dash reveal while a rotating lemniscate links through its loop.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"scene\">\n  <div class=\"field\"></div>\n  <div class=\"nebula nebula-a\"></div>\n  <div class=\"nebula nebula-b\"></div>\n  <div class=\"grid\"></div>\n\n  <div class=\"stage\">\n    <svg class=\"figure\" id=\"mobius\" viewBox=\"0 0 1000 640\" role=\"img\" aria-label=\"A Mobius strip that morphs and draws itself while an infinity loop rotates and links through it\">\n      <defs>\n        <linearGradient id=\"silkGrad\" gradientUnits=\"userSpaceOnUse\" x1=\"120\" y1=\"60\" x2=\"880\" y2=\"580\" gradientTransform=\"rotate(18 500 320)\">\n          <stop offset=\"0\" stop-color=\"#22d3ee\"></stop>\n          <stop offset=\".26\" stop-color=\"#5b8cf8\"></stop>\n          <stop offset=\".52\" stop-color=\"#a970f2\"></stop>\n          <stop offset=\".78\" stop-color=\"#f472b6\"></stop>\n          <stop offset=\"1\" stop-color=\"#fbbf24\"></stop>\n        </linearGradient>\n        <linearGradient id=\"loopGrad\" gradientUnits=\"userSpaceOnUse\" x1=\"330\" y1=\"200\" x2=\"670\" y2=\"440\" gradientTransform=\"rotate(18 500 320)\">\n          <stop offset=\"0\" stop-color=\"#fbbf24\"></stop>\n          <stop offset=\".5\" stop-color=\"#fb7185\"></stop>\n          <stop offset=\"1\" stop-color=\"#a78bfa\"></stop>\n        </linearGradient>\n      </defs>\n\n      <g id=\"lobeBack\" class=\"lobe lobe-back\"></g>\n      <path id=\"body\" class=\"body\" fill=\"url(#silkGrad)\" fill-rule=\"evenodd\"></path>\n      <path id=\"ribsMajor\" class=\"ribs ribs-major\"></path>\n      <path id=\"ribsMinor\" class=\"ribs ribs-minor\"></path>\n      <path id=\"edgeHalo\" class=\"edge-halo\" stroke=\"url(#silkGrad)\"></path>\n      <path id=\"edge\" class=\"edge\" stroke=\"url(#silkGrad)\"></path>\n      <path id=\"comet\" class=\"comet\" stroke=\"url(#silkGrad)\"></path>\n      <path id=\"spineHalo\" class=\"spine-halo\" stroke=\"url(#silkGrad)\"></path>\n      <path id=\"spine\" class=\"spine\" stroke=\"url(#silkGrad)\"></path>\n      <path id=\"reveal\" class=\"reveal\" stroke=\"url(#silkGrad)\"></path>\n      <g id=\"lobeFront\" class=\"lobe lobe-front\"></g>\n    </svg>\n  </div>\n\n  <svg class=\"grain\" viewBox=\"0 0 800 500\" preserveAspectRatio=\"none\" aria-hidden=\"true\" focusable=\"false\">\n    <defs>\n      <filter id=\"mobGrain\">\n        <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.87\" numOctaves=\"2\" stitchTiles=\"stitch\"></feTurbulence>\n        <feColorMatrix type=\"saturate\" values=\"0\"></feColorMatrix>\n      </filter>\n    </defs>\n    <rect width=\"800\" height=\"500\" filter=\"url(#mobGrain)\"></rect>\n  </svg>\n\n  <div class=\"vignette\"></div>\n\n  <header class=\"hud\">\n    <p class=\"eyebrow\">Mobius / Infinity Loop</p>\n    <p class=\"lede\">A single twisted surface drawn by its own stroke, linked by a lemniscate turning through three dimensions.</p>\n  </header>\n\n  <section class=\"panel\">\n    <div class=\"row\"><span class=\"k\">Surface</span><span class=\"v\">Mobius</span></div>\n    <div class=\"row\"><span class=\"k\">Twist</span><span class=\"v\">180&deg;</span></div>\n    <div class=\"row\"><span class=\"k\">Link figure</span><span class=\"v\">Lemniscate</span></div>\n    <div class=\"row\"><span class=\"k\">Reveal</span><span class=\"v\" id=\"revealOut\">0%</span></div>\n    <div class=\"meter\"><i id=\"revealBar\"></i></div>\n    <div class=\"row\"><span class=\"k\">Bands</span><span class=\"v\" id=\"bandOut\">0 px</span></div>\n  </section>\n\n  <footer class=\"legend\">\n    <span class=\"hint\">Drag to turn / double tap to reset</span>\n    <span class=\"readout\">parametric surface / dash reveal</span>\n  </footer>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/mobius-infinity-loop/index.html","archivePath":"animaciones-mobius-infinity-loop/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/mobius-infinity-loop/script.js","archivePath":"animaciones-mobius-infinity-loop/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/mobius-infinity-loop/styles.css","archivePath":"animaciones-mobius-infinity-loop/styles.css"}]}
