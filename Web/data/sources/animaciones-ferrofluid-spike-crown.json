{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Ferrofluid Spike Crown</title>\n<meta name=\"description\" content=\"A magnet sweeps above a pool of iron fluid, raising glossy black spikes crowned with iridescent highlights.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"scene\">\n  <div class=\"field-a\"></div>\n  <div class=\"field-b\"></div>\n  <div class=\"horizon\"></div>\n  <div class=\"grid-floor\"></div>\n  <canvas class=\"stage\" id=\"stage\" role=\"img\" aria-label=\"A black magnetic liquid pools in a basin while a magnet passes overhead, raising a crown of glossy spikes\"></canvas>\n  <div class=\"grain\"></div>\n  <div class=\"vignette\"></div>\n  <div class=\"frame\"></div>\n\n  <header class=\"hud\">\n    <p class=\"kicker\">Experiment 02 &middot; Ferrofluid</p>\n    <h1>Spike&nbsp;Crown</h1>\n    <p class=\"sub\">Field strength is sampled along the meniscus, lifting jet&#8209;black columns that lean toward the magnet and shimmer with a thin film of interference colour.</p>\n  </header>\n\n  <section class=\"readout\" aria-label=\"Field readout\">\n    <dl class=\"stats\">\n      <div class=\"stat\"><dt>Columns</dt><dd id=\"rCols\">&mdash;</dd></div>\n      <div class=\"stat\"><dt>Peak</dt><dd id=\"rPeak\">&mdash;</dd></div>\n      <div class=\"stat\"><dt>Field</dt><dd id=\"rField\">&mdash;</dd></div>\n      <div class=\"stat\"><dt>State</dt><dd id=\"rState\">Running</dd></div>\n    </dl>\n    <div class=\"meter\" aria-hidden=\"true\"><span class=\"meter-fill\" id=\"rBar\"></span></div>\n    <div class=\"controls\">\n      <button class=\"btn\" type=\"button\" data-gain=\"0.55\">Weak</button>\n      <button class=\"btn is-on\" type=\"button\" data-gain=\"1\">Nominal</button>\n      <button class=\"btn\" type=\"button\" data-gain=\"1.75\">Saturate</button>\n    </div>\n  </section>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/ferrofluid-spike-crown/index.html","archivePath":"animaciones-ferrofluid-spike-crown/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/ferrofluid-spike-crown/script.js","archivePath":"animaciones-ferrofluid-spike-crown/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/ferrofluid-spike-crown/styles.css","archivePath":"animaciones-ferrofluid-spike-crown/styles.css"}]}
