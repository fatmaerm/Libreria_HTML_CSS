{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Slider Bar</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n    <div class=\"slider-container\">\r\n        <div class=\"slider\">\r\n            <input type=\"range\" min=\"0\" max=\"100\" value=\"50\">\r\n            <progress min=\"0\" max=\"100\" value=\"50\"> </progress>\r\n        </div>\r\n        <div class=\"slidervalue\">50</div>\r\n    </div>\r\n\r\n    <script>\r\n        window.onload = function(){\r\n            slider = document.querySelector(\".slider input\");\r\n            slider.oninput = function() {\r\n                progressBar = document.querySelector(\".slider progress\");\r\n                progressBar.value = slider.value;\r\n                slidervalue = document.querySelector(\".slidervalue\");\r\n                slidervalue.innerHTML = slider.value;\r\n            }\r\n        }\r\n    </script>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":["window.onload = function(){\r\n            slider = document.querySelector(\".slider input\");\r\n            slider.oninput = function() {\r\n                progressBar = document.querySelector(\".slider progress\");\r\n                progressBar.value = slider.value;\r\n                slidervalue = document.querySelector(\".slidervalue\");\r\n                slidervalue.innerHTML = slider.value;\r\n            }\r\n        }"],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/slider-bar/index.html","archivePath":"slider-bar/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/slider-bar/style.css","archivePath":"slider-bar/style.css"}]}
