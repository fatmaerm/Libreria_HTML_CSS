{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Rigid Domino Topple</title>\n<meta name=\"description\" content=\"A curved row of dominoes topples in a gapless chain reaction with gravity-driven angular acceleration and a damped impact rebound.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"halo\" aria-hidden=\"true\"></div>\n<main class=\"rig\">\n  <canvas class=\"rig-canvas\" id=\"stage\" tabindex=\"0\" role=\"img\" aria-label=\"A curved row of dominoes toppling one after another. Press to replay the cascade.\"></canvas>\n  <div class=\"rig-scan\" aria-hidden=\"true\"></div>\n  <div class=\"rig-edge\" aria-hidden=\"true\"></div>\n  <header class=\"rig-head\">\n    <span class=\"eyebrow\">Rigid Body Cascade</span>\n    <h1>Rigid Domino Topple</h1>\n    <p>Each slab rotates about its base edge under gravity torque until its crown strikes the next one.</p>\n  </header>\n  <div class=\"rig-hud\">\n    <div class=\"hud-line\">\n      <span class=\"hud-key\">Chain</span>\n      <span class=\"hud-val\" id=\"chainState\">Primed</span>\n    </div>\n    <div class=\"hud-bar\"><i id=\"chainBar\"></i></div>\n    <div class=\"hud-line hud-foot\">\n      <span class=\"hud-dim\" id=\"downCount\">0 / 0 down</span>\n      <span class=\"hud-dim\" id=\"impactCount\">0 impacts</span>\n    </div>\n  </div>\n  <div class=\"rig-meta\" aria-hidden=\"true\">\n    <span>Gravity</span>\n    <span id=\"metaStamp\">21.0 rad/s2</span>\n  </div>\n  <button class=\"rig-replay\" id=\"replay\" type=\"button\">Replay cascade</button>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/rigid-domino-topple/index.html","archivePath":"animaciones-rigid-domino-topple/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/rigid-domino-topple/script.js","archivePath":"animaciones-rigid-domino-topple/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/rigid-domino-topple/styles.css","archivePath":"animaciones-rigid-domino-topple/styles.css"}]}
