{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Analog CRT Oscilloscope</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"oscilloscope-frame\">\n    <div class=\"screen-housing\">\n      <div class=\"crt-overlay\"></div>\n      <div class=\"graticule-grid\"></div>\n      <canvas id=\"scopeCanvas\" width=\"360\" height=\"240\"></canvas>\n    </div>\n    \n    <div class=\"control-panel\">\n      <span class=\"brand-tag\">TEKTRONIX // LAB-6000</span>\n      <div class=\"btn-group\">\n        <button class=\"mode-btn active\" data-mode=\"sine\">SENOIDAL</button>\n        <button class=\"mode-btn\" data-mode=\"lissajous\">LISSAJOUS</button>\n        <button class=\"mode-btn\" data-mode=\"square\">MODULADA</button>\n      </div>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/analog-crt-oscilloscope/index.html","archivePath":"analog-crt-oscilloscope/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/analog-crt-oscilloscope/LICENSE","archivePath":"analog-crt-oscilloscope/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/analog-crt-oscilloscope/script.js","archivePath":"analog-crt-oscilloscope/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/analog-crt-oscilloscope/styles.css","archivePath":"analog-crt-oscilloscope/styles.css"}]}
