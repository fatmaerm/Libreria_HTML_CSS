{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Neumorphic Stat Card</title>\n<meta name=\"description\" content=\"Soft neumorphism stats dashboard card with animated counters.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"nm-card\">\n  <h3 class=\"nm-title\">Dashboard</h3>\n  <div class=\"stats\">\n    <div class=\"stat-item\">\n      <div class=\"stat-icon\">📈</div>\n      <div><strong class=\"count\" data-target=\"12847\">0</strong><span>Revenue</span></div>\n    </div>\n    <div class=\"stat-item\">\n      <div class=\"stat-icon\">👥</div>\n      <div><strong class=\"count\" data-target=\"3921\">0</strong><span>Users</span></div>\n    </div>\n    <div class=\"stat-item\">\n      <div class=\"stat-icon\">🛒</div>\n      <div><strong class=\"count\" data-target=\"643\">0</strong><span>Orders</span></div>\n    </div>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/neumorphic-stat-card/index.html","archivePath":"neumorphic-stat-card/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/neumorphic-stat-card/LICENSE","archivePath":"neumorphic-stat-card/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/neumorphic-stat-card/script.js","archivePath":"neumorphic-stat-card/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/neumorphic-stat-card/styles.css","archivePath":"neumorphic-stat-card/styles.css"}]}
