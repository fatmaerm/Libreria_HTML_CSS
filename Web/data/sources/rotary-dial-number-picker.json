{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Rotary Dial Number Picker</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"rotary-card\">\n    <div class=\"number-display\" id=\"numDisplay\">NÚMERO: 5</div>\n    <div class=\"dial-wheel\" id=\"dialWheel\">\n      <div class=\"hole\" data-num=\"1\" style=\"top:15px; left:95px\">1</div>\n      <div class=\"hole\" data-num=\"2\" style=\"top:35px; right:40px\">2</div>\n      <div class=\"hole\" data-num=\"3\" style=\"top:90px; right:20px\">3</div>\n      <div class=\"hole\" data-num=\"4\" style=\"bottom:45px; right:40px\">4</div>\n      <div class=\"hole\" data-num=\"5\" style=\"bottom:15px; left:95px\">5</div>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/rotary-dial-number-picker/index.html","archivePath":"rotary-dial-number-picker/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/rotary-dial-number-picker/LICENSE","archivePath":"rotary-dial-number-picker/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/rotary-dial-number-picker/script.js","archivePath":"rotary-dial-number-picker/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/rotary-dial-number-picker/styles.css","archivePath":"rotary-dial-number-picker/styles.css"}]}
