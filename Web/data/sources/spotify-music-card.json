{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Spotify Music Card</title>\n<meta name=\"description\" content=\"Music player card with animated progress bar and controls.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"music-card\">\n  <div class=\"album\" id=\"album\">🎵</div>\n  <div class=\"info\">\n    <h2 id=\"trackName\">Midnight Drive</h2>\n    <p id=\"artistName\">Neon Horizons</p>\n  </div>\n  <div class=\"progress-wrap\">\n    <div class=\"bar\"><div class=\"fill\" id=\"fill\"></div></div>\n    <div class=\"times\"><span id=\"cur\">0:00</span><span>3:42</span></div>\n  </div>\n  <div class=\"controls\">\n    <button id=\"prev\">⏮</button>\n    <button id=\"play\" class=\"play-btn\">▶</button>\n    <button id=\"next\">⏭</button>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/spotify-music-card/index.html","archivePath":"spotify-music-card/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/spotify-music-card/LICENSE","archivePath":"spotify-music-card/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/spotify-music-card/script.js","archivePath":"spotify-music-card/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/spotify-music-card/styles.css","archivePath":"spotify-music-card/styles.css"}]}
