{"html":"<!doctype html>\n<html lang=\"en\" data-theme=\"dark\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Multi Theme Switcher</title>\n<meta name=\"description\" content=\"Multi-theme color switcher with CSS custom properties and smooth transition.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"theme-demo\">\n  <div class=\"theme-bar\" id=\"themeBar\">\n    <button class=\"theme-btn active\" data-theme=\"dark\">🌑 Dark</button><button class=\"theme-btn\" data-theme=\"light\">☀️ Light</button><button class=\"theme-btn\" data-theme=\"ocean\">🌊 Ocean</button><button class=\"theme-btn\" data-theme=\"forest\">🌲 Forest</button><button class=\"theme-btn\" data-theme=\"candy\">🍭 Candy</button>\n  </div>\n  <div class=\"demo-card\">\n    <h2>Theme Preview</h2>\n    <p>Watch colors change across the entire page.</p>\n    <button class=\"demo-btn\">Action Button</button>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/theme-switcher-multi/index.html","archivePath":"theme-switcher-multi/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/theme-switcher-multi/LICENSE","archivePath":"theme-switcher-multi/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/theme-switcher-multi/script.js","archivePath":"theme-switcher-multi/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/theme-switcher-multi/styles.css","archivePath":"theme-switcher-multi/styles.css"}]}
