{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Vertical Volume Slider</title>\n<meta name=\"description\" content=\"Vertical audio volume fader with level meter visualization.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"vol-panel\">\n  <div class=\"vol-meter\" id=\"meter\">\n    <div class=\"meter-bar\" data-i=\"11\"></div><div class=\"meter-bar\" data-i=\"10\"></div><div class=\"meter-bar\" data-i=\"9\"></div><div class=\"meter-bar\" data-i=\"8\"></div><div class=\"meter-bar\" data-i=\"7\"></div><div class=\"meter-bar\" data-i=\"6\"></div><div class=\"meter-bar\" data-i=\"5\"></div><div class=\"meter-bar\" data-i=\"4\"></div><div class=\"meter-bar\" data-i=\"3\"></div><div class=\"meter-bar\" data-i=\"2\"></div><div class=\"meter-bar\" data-i=\"1\"></div><div class=\"meter-bar\" data-i=\"0\"></div>\n  </div>\n  <div class=\"fader-wrap\">\n    <input type=\"range\" orient=\"vertical\" class=\"fader\" id=\"fader\" min=\"0\" max=\"100\" value=\"70\">\n  </div>\n  <div class=\"vol-label\" id=\"volLbl\">70</div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/vertical-volume-slider/index.html","archivePath":"vertical-volume-slider/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/vertical-volume-slider/LICENSE","archivePath":"vertical-volume-slider/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/vertical-volume-slider/script.js","archivePath":"vertical-volume-slider/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/vertical-volume-slider/styles.css","archivePath":"vertical-volume-slider/styles.css"}]}
