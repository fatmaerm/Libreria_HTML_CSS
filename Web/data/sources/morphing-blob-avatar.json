{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Morphing Blob Avatar</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"avatar-card\">\n    <div class=\"blob-frame\">\n      <div class=\"blob-aura\"></div>\n      <div class=\"blob-shape\">\n        <div class=\"avatar-portrait\">\n          <svg viewBox=\"0 0 100 100\" class=\"portrait-svg\">\n            <circle cx=\"50\" cy=\"38\" r=\"20\" fill=\"#f8fafc\" opacity=\"0.9\" />\n            <path d=\"M 20 85 C 20 65, 35 58, 50 58 C 65 58, 80 65, 80 85 Z\" fill=\"#f8fafc\" opacity=\"0.9\" />\n          </svg>\n        </div>\n      </div>\n      <div class=\"status-indicator\" title=\"En línea\"></div>\n    </div>\n    \n    <div class=\"avatar-bio\">\n      <h3>ALYA VEX</h3>\n      <span class=\"role\">Directora Creativa // 3D</span>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/morphing-blob-avatar/index.html","archivePath":"morphing-blob-avatar/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/morphing-blob-avatar/LICENSE","archivePath":"morphing-blob-avatar/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/morphing-blob-avatar/styles.css","archivePath":"morphing-blob-avatar/styles.css"}]}
