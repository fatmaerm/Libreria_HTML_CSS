{"html":"\r\n<!DOCTYPE html>\r\n<html lang=\"en\" >\r\n\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <title>Order Confirm Animation</title>\r\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css\">\r\n\r\n  <link rel='stylesheet' href='https://fonts.googleapis.com/css?family=Roboto:400,500,700&amp;display=swap'>\r\n  <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n\r\n<body>\r\n  <button class=\"order\"><span class=\"default\">Complete Order</span><span class=\"success\">Order Placed\r\n    <svg viewbox=\"0 0 12 10\">\r\n      <polyline points=\"1.5 6 4.5 9 10.5 1\"></polyline>\r\n    </svg></span>\r\n  <div class=\"box\"></div>\r\n  <div class=\"truck\">\r\n    <div class=\"back\"></div>\r\n    <div class=\"front\">\r\n      <div class=\"window\"></div>\r\n    </div>\r\n    <div class=\"light top\"></div>\r\n    <div class=\"light bottom\"></div>\r\n  </div>\r\n  <div class=\"lines\"></div>\r\n  <script src='https://cdnjs.cloudflare.com/ajax/libs/jquery/3.4.1/jquery.min.js'></script>\r\n  <script src=\"main.js\"></script>\r\n</body>\r\n\r\n</html>\r\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/order-confirm-animation/index.html","archivePath":"order-confirm-animation/index.html"},{"name":"main.js","relativePath":"main.js","path":"../BibliotecaDeHtml_CSS/order-confirm-animation/main.js","archivePath":"order-confirm-animation/main.js"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/order-confirm-animation/style.css","archivePath":"order-confirm-animation/style.css"}]}
