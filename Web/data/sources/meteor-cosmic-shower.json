{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Meteor Cosmic Shower</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"night-sky\" aria-label=\"Lluvia de meteoros cósmica\">\n    <div class=\"stars-layer\"></div>\n    <div class=\"shooting-star star-1\"></div>\n    <div class=\"shooting-star star-2\"></div>\n    <div class=\"shooting-star star-3\"></div>\n    <div class=\"shooting-star star-4\"></div>\n    <div class=\"shooting-star star-5\"></div>\n    \n    <div class=\"sky-title\">\n      <h2>LLUVIA DE PERSEIDAS</h2>\n      <p>Observatorio Espacial Austral</p>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/meteor-cosmic-shower/index.html","archivePath":"meteor-cosmic-shower/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/meteor-cosmic-shower/LICENSE","archivePath":"meteor-cosmic-shower/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/meteor-cosmic-shower/styles.css","archivePath":"meteor-cosmic-shower/styles.css"}]}
