{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Floating Astronaut Visor</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"helmet-viewport\" aria-label=\"Casco de astronauta en gravedad cero\">\n    <div class=\"helmet\">\n      <div class=\"helmet-shell\">\n        <div class=\"visor\">\n          <div class=\"visor-reflection\"></div>\n          <div class=\"visor-nebula\"></div>\n          <div class=\"hud-reticle\"></div>\n        </div>\n        <div class=\"oxygen-vent vent-left\"></div>\n        <div class=\"oxygen-vent vent-right\"></div>\n      </div>\n      <div class=\"neck-collar\"></div>\n    </div>\n    <div class=\"helmet-caption\">MÓDULO EXTRAVEHICULAR // EVA-01</div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/floating-astronaut-visor/index.html","archivePath":"floating-astronaut-visor/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/floating-astronaut-visor/LICENSE","archivePath":"floating-astronaut-visor/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/floating-astronaut-visor/styles.css","archivePath":"floating-astronaut-visor/styles.css"}]}
