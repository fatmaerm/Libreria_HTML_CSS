{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Breadcrumb Collapse Animation</title>\r\n\r\n    <link href=\"https://netdna.bootstrapcdn.com/twitter-bootstrap/2.3.2/css/bootstrap-combined.no-icons.min.css\" rel=\"stylesheet\">\r\n    <link href=\"https://netdna.bootstrapcdn.com/font-awesome/3.2.1/css/font-awesome.css\" rel=\"stylesheet\">\r\n\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n    \r\n    <ul class=\"breadcrumb\">\r\n      <li>\r\n        <a href=\"#\">\r\n          <span class=\"icon icon-file\"></span>\r\n          <span class=\"text\">File</span>\r\n        </a>\r\n      </li>\r\n\r\n        <li>\r\n        <a href=\"#\">\r\n          <span class=\"icon icon-folder-open\"></span>\r\n          <span class=\"text\">Folder</span>\r\n        </a>\r\n      </li>\r\n\r\n        <li>\r\n        <a href=\"#\">\r\n          <span class=\"icon icon-code\"></span>\r\n          <span class=\"text\">HTML</span>\r\n        </a>\r\n      </li>\r\n\r\n        <li>\r\n        <a href=\"#\">\r\n          <span class=\"icon icon-beaker\"></span>\r\n          <span class=\"text\">Lab</span>\r\n        </a>\r\n      </li>\r\n\r\n        <li>\r\n        <a href=\"#\">\r\n          <span class=\"icon icon-home\"></span>\r\n        \r\n        </a>\r\n      </li>\r\n    </ul>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/breadcrumb-collapse-animation/index.html","archivePath":"breadcrumb-collapse-animation/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/breadcrumb-collapse-animation/style.css","archivePath":"breadcrumb-collapse-animation/style.css"}]}
