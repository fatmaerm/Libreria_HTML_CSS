{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Glassmorphism Product Card</title>\n<meta name=\"description\" content=\"Frosted glass product card with floating badge and action button.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"bg-blobs\">\n  <div class=\"blob b1\"></div><div class=\"blob b2\"></div><div class=\"blob b3\"></div>\n</div>\n<div class=\"product-card\">\n  <div class=\"badge\">NEW</div>\n  <div class=\"product-img\">🎧</div>\n  <div class=\"product-info\">\n    <h2>Pro Studio Headphones</h2>\n    <p>Immersive sound, zero noise.</p>\n    <div class=\"price-row\">\n      <span class=\"price\">$249</span>\n      <button class=\"add-btn\">Add to Cart</button>\n    </div>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/glassmorphism-product-card/index.html","archivePath":"glassmorphism-product-card/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/glassmorphism-product-card/LICENSE","archivePath":"glassmorphism-product-card/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/glassmorphism-product-card/styles.css","archivePath":"glassmorphism-product-card/styles.css"}]}
