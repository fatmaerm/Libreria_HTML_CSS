{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Stained Glass Light Shaft</title>\n<meta name=\"description\" content=\"A leaded gothic window of jewel-toned glass throws animated god rays across a dark stone nave while dust motes drift through the light.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n\n<div class=\"nave\" aria-hidden=\"true\">\n  <div class=\"nave__stone\"></div>\n  <div class=\"nave__moon\"></div>\n  <div class=\"nave__haze\"></div>\n  <div class=\"nave__floor\"></div>\n  <div class=\"nave__rail\"></div>\n</div>\n\n<main class=\"stage\">\n\n  <div class=\"window-wrap\">\n    <div class=\"window-aura\" aria-hidden=\"true\"></div>\n    <div class=\"window-frame\" aria-hidden=\"true\"></div>\n\n    <svg class=\"window\" viewBox=\"0 0 400 460\" role=\"img\" aria-label=\"Leaded gothic stained glass window\">\n      <defs>\n        <path id=\"archShape\" d=\"M 52 434 L 52 216 C 52 120 122 62 200 32 C 278 62 348 120 348 216 L 348 434 Z\"/>\n        <clipPath id=\"archClip\">\n          <use href=\"#archShape\"/>\n        </clipPath>\n        <radialGradient id=\"sunGlow\" cx=\"50%\" cy=\"38%\" r=\"62%\">\n          <stop offset=\"0\" stop-color=\"#fff3c8\" stop-opacity=\".95\"/>\n          <stop offset=\".42\" stop-color=\"#ffcf72\" stop-opacity=\".55\"/>\n          <stop offset=\"1\" stop-color=\"#e0761f\" stop-opacity=\"0\"/>\n        </radialGradient>\n        <linearGradient id=\"glint\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#fff6dd\" stop-opacity=\"0\"/>\n          <stop offset=\".5\" stop-color=\"#fff6dd\" stop-opacity=\".5\"/>\n          <stop offset=\"1\" stop-color=\"#fff6dd\" stop-opacity=\"0\"/>\n        </linearGradient>\n        <linearGradient id=\"stoneGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#6d6559\"/>\n          <stop offset=\".5\" stop-color=\"#4a453c\"/>\n          <stop offset=\"1\" stop-color=\"#2c2823\"/>\n        </linearGradient>\n        <pattern id=\"quarry\" width=\"24\" height=\"24\" patternUnits=\"userSpaceOnUse\" patternTransform=\"rotate(45)\">\n          <rect width=\"24\" height=\"24\" fill=\"#3b2a15\"/>\n          <path d=\"M 0 12 H 24 M 12 0 V 24\" stroke=\"#c9902f\" stroke-width=\"8\" stroke-opacity=\".8\"/>\n          <path d=\"M 0 12 H 24 M 12 0 V 24\" stroke=\"#150f0a\" stroke-width=\"2.2\"/>\n        </pattern>\n        <pattern id=\"came\" width=\"30\" height=\"30\" patternUnits=\"userSpaceOnUse\">\n          <rect width=\"30\" height=\"30\" fill=\"#1d1610\"/>\n          <path d=\"M 0 0 H 30 M 0 0 V 30\" stroke=\"#0e0a07\" stroke-width=\"2.4\"/>\n        </pattern>\n        <pattern id=\"flaws\" width=\"10\" height=\"10\" patternUnits=\"userSpaceOnUse\">\n          <path d=\"M 0 3 H 10 M 0 7.4 H 10\" stroke=\"#ffe9b8\" stroke-width=\".7\" stroke-opacity=\".16\"/>\n        </pattern>\n      </defs>\n\n      <use href=\"#archShape\" fill=\"none\" stroke=\"url(#stoneGrad)\" stroke-width=\"30\" stroke-linejoin=\"round\"/>\n      <use href=\"#archShape\" fill=\"none\" stroke=\"#211d18\" stroke-width=\"34\" stroke-opacity=\".55\" stroke-linejoin=\"round\"/>\n\n      <g clip-path=\"url(#archClip)\">\n        <rect x=\"40\" y=\"20\" width=\"320\" height=\"426\" fill=\"url(#came)\"/>\n\n        <g class=\"glass\">\n          <rect x=\"40\" y=\"20\" width=\"320\" height=\"426\" fill=\"url(#quarry)\"/>\n\n          <g class=\"rose\">\n            <circle cx=\"200\" cy=\"172\" r=\"94\" fill=\"#1b2f4a\" stroke=\"#120d09\" stroke-width=\"4\"/>\n            <g stroke=\"#120d09\" stroke-width=\"3\" stroke-linejoin=\"round\">\n              <path d=\"M 200 84 C 226 106 236 140 200 168 C 164 140 174 106 200 84 Z\" fill=\"#d9962a\" transform=\"rotate(0 200 172)\"/>\n              <path d=\"M 200 84 C 226 106 236 140 200 168 C 164 140