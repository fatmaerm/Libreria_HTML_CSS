{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Memory Heap RAM Gauge</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"ram-card\">\n    <div class=\"ram-circle\">\n      <svg viewBox=\"0 0 100 100\" class=\"gauge-svg\">\n        <circle cx=\"50\" cy=\"50\" r=\"40\" class=\"track\"></circle>\n        <circle cx=\"50\" cy=\"50\" r=\"40\" class=\"val-bar\"></circle>\n      </svg>\n      <div class=\"ram-center\">\n        <span class=\"pct\">74%</span>\n        <span class=\"lbl\">HEAP</span>\n      </div>\n    </div>\n    <div class=\"ram-info\">\n      <h3>NODE.JS V8 HEAP</h3>\n      <p>1.42 GB / 2.00 GB LÍMITE</p>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/memory-heap-ram-gauge/index.html","archivePath":"memory-heap-ram-gauge/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/memory-heap-ram-gauge/LICENSE","archivePath":"memory-heap-ram-gauge/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/memory-heap-ram-gauge/styles.css","archivePath":"memory-heap-ram-gauge/styles.css"}]}
