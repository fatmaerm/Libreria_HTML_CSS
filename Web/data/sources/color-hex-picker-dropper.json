{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Color Hex Picker Dropper</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"picker-card\">\n    <div class=\"color-preview\" id=\"colorPreview\"></div>\n    <div class=\"picker-controls\">\n      <div class=\"hex-info\">\n        <span class=\"label\">COLOR ACTIVO</span>\n        <span class=\"hex-code\" id=\"hexCode\">#6366F1</span>\n      </div>\n      <div class=\"swatches\">\n        <button class=\"swatch\" style=\"background:#6366f1\" data-hex=\"#6366F1\"></button>\n        <button class=\"swatch\" style=\"background:#ec4899\" data-hex=\"#EC4899\"></button>\n        <button class=\"swatch\" style=\"background:#06b6d4\" data-hex=\"#06B6D4\"></button>\n        <button class=\"swatch\" style=\"background:#10b981\" data-hex=\"#10B981\"></button>\n      </div>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/color-hex-picker-dropper/index.html","archivePath":"color-hex-picker-dropper/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/color-hex-picker-dropper/LICENSE","archivePath":"color-hex-picker-dropper/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/color-hex-picker-dropper/script.js","archivePath":"color-hex-picker-dropper/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/color-hex-picker-dropper/styles.css","archivePath":"color-hex-picker-dropper/styles.css"}]}
