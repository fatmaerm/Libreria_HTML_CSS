{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Tab Menu Bar</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n    <link href=\"https://cdn.jsdelivr.net/npm/remixicon@4.1.0/fonts/remixicon.css\" rel=\"stylesheet\"/>\r\n</head>\r\n<body>\r\n    <div class=\"container\">\r\n        <nav class=\"nav\">\r\n            <input id=\"menu\" type=\"checkbox\">\r\n            <label for=\"menu\">Menu</label>\r\n            <ul class=\"menu\">\r\n              <li>\r\n                <a href=\"#0\">\r\n                  <span>About</span>\r\n                  <i class=\"ri-user-heart-line\"></i>\r\n                </a>\r\n              </li>\r\n              <li>\r\n                <a href=\"#0\">\r\n                  <span>Projects</span>\r\n                  <i class=\"ri-list-check-3\"></i>\r\n                </a>\r\n              </li>\r\n              <li>\r\n                <a href=\"#0\">\r\n                  <span>Clients</span>\r\n                  <i class=\"ri-team-line\"></i>\r\n                </a>\r\n              </li>\r\n              <li>\r\n                <a href=\"#0\">\r\n                  <span>Contact</span>\r\n                  <i class=\"ri-contacts-book-line\"></i>\r\n                </a>\r\n              </li>\r\n            </ul>\r\n        </nav>\r\n    </div>\r\n      \r\n    <p class=\"notification\">Click on the Menu</p>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/tab-menu-bar/index.html","archivePath":"tab-menu-bar/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/tab-menu-bar/style.css","archivePath":"tab-menu-bar/style.css"}]}
