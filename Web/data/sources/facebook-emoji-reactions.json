{"html":"<!DOCTYPE html>\n<html lang=\"en\" >\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Facebook Emoji Reactions</title>\n  <link rel=\"stylesheet\" href=\"./style.css\">\n\n</head>\n<body>\n\n  <div class=\"box\">\n    <input type=\"checkbox\" id=\"like\" class=\"field-reactions\">\n    <h3 class=\"text-desc\">Press space and after tab key to navigation</h3>\n    <label for=\"like\" class=\"label-reactions\">Like</label>\n    <div class=\"toolbox\"></div>\n    <button type=\"button\" class=\"overlay\" aria-label=\"Close reaction picker\"></button>\n    <button type=\"button\" class=\"reaction-like\"><span class=\"legend-reaction\">Like</span></button>\n    <button type=\"button\" class=\"reaction-love\"><span class=\"legend-reaction\">Love</span></button>\n    <button type=\"button\" class=\"reaction-haha\"><span class=\"legend-reaction\">Haha</span></button>\n    <button type=\"button\" class=\"reaction-wow\"><span class=\"legend-reaction\">Wow</span></button>\n    <button type=\"button\" class=\"reaction-sad\"><span class=\"legend-reaction\">Sad</span></button>\n    <button type=\"button\" class=\"reaction-angry\"><span class=\"legend-reaction\">Angry</span></button>\n  </div>\n\n  <script  src=\"./script.js\"></script>\n\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/facebook-emoji-reactions/index.html","archivePath":"facebook-emoji-reactions/index.html"},{"name":"script.js","relativePath":"script.js","path":"../BibliotecaDeHtml_CSS/facebook-emoji-reactions/script.js","archivePath":"facebook-emoji-reactions/script.js"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/facebook-emoji-reactions/style.css","archivePath":"facebook-emoji-reactions/style.css"}]}
