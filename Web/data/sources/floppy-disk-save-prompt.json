{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Floppy Disk Save Prompt</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"floppy-card\">\n    <div class=\"floppy-shutter\">\n      <div class=\"shutter-notch\"></div>\n    </div>\n    <div class=\"floppy-label\">\n      <span class=\"label-title\">SOURCE_CODE_V1.DAT</span>\n      <span class=\"label-kb\">1.44 MB HD</span>\n    </div>\n    <div class=\"save-status\">\n      <span class=\"save-led\"></span>\n      <span class=\"status-text\">GUARDANDO DATOS...</span>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/floppy-disk-save-prompt/index.html","archivePath":"floppy-disk-save-prompt/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/floppy-disk-save-prompt/LICENSE","archivePath":"floppy-disk-save-prompt/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/floppy-disk-save-prompt/styles.css","archivePath":"floppy-disk-save-prompt/styles.css"}]}
