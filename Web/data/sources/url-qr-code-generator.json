{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>URL QR Code Generator</title>\n<meta name=\"description\" content=\"Canvas-drawn QR code generator for URLs using the QR Server API.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"qr-card\">\n  <h2>QR Generator</h2>\n  <div class=\"qr-input-row\">\n    <input type=\"url\" id=\"qrUrl\" placeholder=\"https://example.com\" value=\"https://github.com\">\n    <button id=\"qrGen\">Generate</button>\n  </div>\n  <div class=\"qr-preview\" id=\"qrPreview\">\n    <img id=\"qrImg\" src=\"\" alt=\"QR Code\" hidden>\n    <p class=\"qr-hint\" id=\"qrHint\">Click generate to create QR</p>\n  </div>\n  <button class=\"dl-btn\" id=\"dlBtn\" hidden>⬇️ Download</button>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/url-qr-code-generator/index.html","archivePath":"url-qr-code-generator/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/url-qr-code-generator/LICENSE","archivePath":"url-qr-code-generator/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/url-qr-code-generator/script.js","archivePath":"url-qr-code-generator/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/url-qr-code-generator/styles.css","archivePath":"url-qr-code-generator/styles.css"}]}
