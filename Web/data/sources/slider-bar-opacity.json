{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Slider Bar Opacity Control</title>\n<meta name=\"description\" content=\"Transparency opacity slider bar with checkerboard preview.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"op-ctrl\">\n  <div class=\"preview-box\" id=\"pbox\"><div class=\"color-layer\" id=\"clayer\"></div></div>\n  <div class=\"slider-row\">\n    <span class=\"icon\">🔳</span>\n    <input type=\"range\" id=\"opSlider\" min=\"0\" max=\"100\" value=\"80\">\n    <span class=\"val\" id=\"opVal\">80%</span>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/slider-bar-opacity/index.html","archivePath":"slider-bar-opacity/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/slider-bar-opacity/LICENSE","archivePath":"slider-bar-opacity/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/slider-bar-opacity/script.js","archivePath":"slider-bar-opacity/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/slider-bar-opacity/styles.css","archivePath":"slider-bar-opacity/styles.css"}]}
