{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Tag Input Chip Form</title>\n<meta name=\"description\" content=\"Tag chip input field with add and remove animations.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"tag-card\">\n  <h3>Add Tags</h3>\n  <div class=\"tag-field\" id=\"tagField\">\n    <div class=\"tags\" id=\"tags\">\n      <span class=\"chip\" data-v=\"CSS\">CSS <button>×</button></span>\n      <span class=\"chip\" data-v=\"JavaScript\">JavaScript <button>×</button></span>\n    </div>\n    <input class=\"tag-input\" id=\"tagInput\" placeholder=\"Type and press Enter…\" autocomplete=\"off\">\n  </div>\n  <p class=\"tag-hint\">Press Enter or comma to add</p>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/tag-input-chip-form/index.html","archivePath":"tag-input-chip-form/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/tag-input-chip-form/LICENSE","archivePath":"tag-input-chip-form/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/tag-input-chip-form/script.js","archivePath":"tag-input-chip-form/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/tag-input-chip-form/styles.css","archivePath":"tag-input-chip-form/styles.css"}]}
