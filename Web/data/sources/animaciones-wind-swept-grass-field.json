{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Wind Swept Grass Field</title>\n<meta name=\"description\" content=\"A canvas grass field where thousands of blades bend under traveling wind waves and rolling gust fronts that cross the whole scene.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"field\">\n  <div class=\"sky\"></div>\n  <div class=\"sun\"></div>\n  <div class=\"hills hills--far\"></div>\n  <div class=\"hills hills--mid\"></div>\n  <div class=\"hills hills--near\"></div>\n  <div class=\"haze\"></div>\n  <div class=\"bank\"></div>\n  <canvas class=\"blades\" id=\"field\"></canvas>\n  <div class=\"vignette\"></div>\n  <div class=\"grain\"></div>\n  <p class=\"caption\">Wind Swept Grass Field</p>\n</div>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/wind-swept-grass-field/index.html","archivePath":"animaciones-wind-swept-grass-field/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/wind-swept-grass-field/script.js","archivePath":"animaciones-wind-swept-grass-field/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/wind-swept-grass-field/styles.css","archivePath":"animaciones-wind-swept-grass-field/styles.css"}]}
