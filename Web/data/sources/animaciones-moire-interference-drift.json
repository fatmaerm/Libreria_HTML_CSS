{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Moire Interference Drift</title>\n<meta name=\"description\" content=\"Two counter-rotating line lattices beat against each other in blended colour to drift a seamless interference field.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<main class=\"scene\">\n  <div class=\"backdrop\"></div>\n  <div class=\"sheen\"></div>\n  <div class=\"horizon\"></div>\n  <div class=\"floor\"></div>\n\n  <div class=\"lens\">\n    <div class=\"plate\">\n      <div class=\"grid grid-a\"></div>\n      <div class=\"grid grid-b\"></div>\n      <div class=\"grid grid-rings\"></div>\n      <div class=\"grid grid-scan\"></div>\n      <div class=\"sweep\"></div>\n      <div class=\"reticle\">\n        <span class=\"dial\"></span>\n        <span class=\"dial dial-in\"></span>\n        <span class=\"core\"></span>\n      </div>\n    </div>\n    <div class=\"rim\"></div>\n    <div class=\"halo\"></div>\n  </div>\n\n  <div class=\"grain\"></div>\n  <div class=\"vignette\"></div>\n  <div class=\"frame\"></div>\n\n  <header class=\"hud\">\n    <p class=\"kicker\">Study 03 &middot; Optics</p>\n    <h1>Moir&eacute; Drift</h1>\n    <p class=\"sub\">Two line lattices at six and seven pixels rotate against each other, their beat frequency sweeping the aperture as the fringe sets slide, lock and dissolve.</p>\n  </header>\n\n  <section class=\"readout\" aria-label=\"Interference readout\">\n    <dl class=\"stats\">\n      <div class=\"stat\"><dt>Lattice A</dt><dd>6 px</dd></div>\n      <div class=\"stat\"><dt>Lattice B</dt><dd>7 px</dd></div>\n      <div class=\"stat\"><dt>Rings</dt><dd>24 px</dd></div>\n      <div class=\"stat\"><dt>Cycle</dt><dd>64 s</dd></div>\n    </dl>\n    <div class=\"meter\" aria-hidden=\"true\"><span class=\"meter-fill\"></span></div>\n    <div class=\"tagline\">\n      <span class=\"tag\">Difference</span>\n      <span class=\"tag\">Screen</span>\n      <span class=\"tag\">Soft light</span>\n    </div>\n  </section>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/moire-interference-drift/index.html","archivePath":"animaciones-moire-interference-drift/index.html"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/moire-interference-drift/styles.css","archivePath":"animaciones-moire-interference-drift/styles.css"}]}
