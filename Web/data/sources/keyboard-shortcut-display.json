{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Keyboard Shortcut Display</title>\n<meta name=\"description\" content=\"Interactive keyboard shortcut reference card with key press highlight.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"kb-wrap\">\n  <h2>Keyboard Shortcuts</h2>\n  <div class=\"shortcuts\">\n    <div class=\"shortcut\"><div class=\"keys\"><kbd>⌘</kbd><span>+</span><kbd>K</kbd></div><span class=\"desc\">Command palette</span></div><div class=\"shortcut\"><div class=\"keys\"><kbd>⌘</kbd><span>+</span><kbd>P</kbd></div><span class=\"desc\">Quick open</span></div><div class=\"shortcut\"><div class=\"keys\"><kbd>⌘</kbd><span>+</span><kbd>⇧</kbd><span>+</span><kbd>P</kbd></div><span class=\"desc\">Run command</span></div><div class=\"shortcut\"><div class=\"keys\"><kbd>⌘</kbd><span>+</span><kbd>B</kbd></div><span class=\"desc\">Toggle sidebar</span></div><div class=\"shortcut\"><div class=\"keys\"><kbd>⌘</kbd><span>+</span><kbd>/</kbd></div><span class=\"desc\">Toggle comment</span></div>\n  </div>\n  <p class=\"hint\" id=\"kbHint\">Press any key to highlight</p>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/keyboard-shortcut-display/index.html","archivePath":"keyboard-shortcut-display/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/keyboard-shortcut-display/LICENSE","archivePath":"keyboard-shortcut-display/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/keyboard-shortcut-display/script.js","archivePath":"keyboard-shortcut-display/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/keyboard-shortcut-display/styles.css","archivePath":"keyboard-shortcut-display/styles.css"}]}
