{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Fluid Wave Radio Tuner</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"radio-card\">\n    <div class=\"wave-screen\">\n      <canvas id=\"radioWave\" width=\"340\" height=\"100\"></canvas>\n    </div>\n    <div class=\"tuner-bar\">\n      <input type=\"range\" min=\"88\" max=\"108\" step=\"0.1\" value=\"98.5\" id=\"freqSlider\">\n      <div class=\"freq-readout\"><span id=\"freqVal\">98.5</span> MHz FM</div>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/fluid-wave-radio-tuner/index.html","archivePath":"fluid-wave-radio-tuner/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/fluid-wave-radio-tuner/LICENSE","archivePath":"fluid-wave-radio-tuner/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/fluid-wave-radio-tuner/script.js","archivePath":"fluid-wave-radio-tuner/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/fluid-wave-radio-tuner/styles.css","archivePath":"fluid-wave-radio-tuner/styles.css"}]}
