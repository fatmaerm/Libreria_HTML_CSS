{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Lightbox Image Slider</title>\n<meta name=\"description\" content=\"Grid gallery that opens items in a full-screen lightbox slider.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"grid\" id=\"grid\">\n  <div class=\"thumb\" data-i=\"0\" style=\"background:#1a237e;\"><span>🌃</span></div><div class=\"thumb\" data-i=\"1\" style=\"background:#b71c1c;\"><span>🎨</span></div><div class=\"thumb\" data-i=\"2\" style=\"background:#1b5e20;\"><span>🌳</span></div><div class=\"thumb\" data-i=\"3\" style=\"background:#4a148c;\"><span>💜</span></div><div class=\"thumb\" data-i=\"4\" style=\"background:#e65100;\"><span>🔥</span></div><div class=\"thumb\" data-i=\"5\" style=\"background:#006064;\"><span>🌊</span></div>\n</div>\n<div class=\"lightbox\" id=\"lb\">\n  <button class=\"lb-close\" id=\"lbClose\">✕</button>\n  <button class=\"lb-arr lprev\" id=\"lprev\">‹</button>\n  <div class=\"lb-item\" id=\"lbItem\"></div>\n  <button class=\"lb-arr lnext\" id=\"lnext\">›</button>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/lightbox-image-slider/index.html","archivePath":"lightbox-image-slider/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/lightbox-image-slider/LICENSE","archivePath":"lightbox-image-slider/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/lightbox-image-slider/script.js","archivePath":"lightbox-image-slider/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/lightbox-image-slider/styles.css","archivePath":"lightbox-image-slider/styles.css"}]}
