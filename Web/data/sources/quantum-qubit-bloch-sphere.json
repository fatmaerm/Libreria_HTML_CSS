{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Quantum Qubit Bloch Sphere</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"bloch-container\">\n    <div class=\"bloch-sphere\">\n      <div class=\"pole pole-zero\">|0⟩</div>\n      <div class=\"ring-lat\"></div>\n      <div class=\"ring-lon\"></div>\n      <div class=\"state-vector\">\n        <div class=\"vector-arrow\"></div>\n      </div>\n      <div class=\"pole pole-one\">|1⟩</div>\n    </div>\n    <div class=\"bloch-tag\">ESFERA DE BLOCH // QUBIT ψ</div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/quantum-qubit-bloch-sphere/index.html","archivePath":"quantum-qubit-bloch-sphere/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/quantum-qubit-bloch-sphere/LICENSE","archivePath":"quantum-qubit-bloch-sphere/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/quantum-qubit-bloch-sphere/styles.css","archivePath":"quantum-qubit-bloch-sphere/styles.css"}]}
