{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Neon Toggle Switch</title>\n<meta name=\"description\" content=\"Cyberpunk neon glow toggle switch with animated track.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<label class=\"neon-toggle\">\n  <input type=\"checkbox\" id=\"nt\">\n  <div class=\"track\">\n    <div class=\"thumb\"></div>\n    <span class=\"label-off\">OFF</span>\n    <span class=\"label-on\">ON</span>\n  </div>\n</label>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/neon-toggle-switch/index.html","archivePath":"neon-toggle-switch/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/neon-toggle-switch/LICENSE","archivePath":"neon-toggle-switch/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/neon-toggle-switch/styles.css","archivePath":"neon-toggle-switch/styles.css"}]}
