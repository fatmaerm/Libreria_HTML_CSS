{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Mech Robot HUD Targeting</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"hud-frame\" aria-label=\"HUD militar de robot mech\">\n    <div class=\"reticle-box\">\n      <div class=\"bracket top-left\"></div>\n      <div class=\"bracket top-right\"></div>\n      <div class=\"bracket btm-left\"></div>\n      <div class=\"bracket btm-right\"></div>\n      <div class=\"target-cross\"></div>\n    </div>\n    <div class=\"hud-stats\">\n      <span>DIST: 840m</span>\n      <span class=\"locked\">OBJETIVO FIJADO</span>\n      <span>CALIBRE: 40mm</span>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/mech-robot-hud-targeting/index.html","archivePath":"mech-robot-hud-targeting/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/mech-robot-hud-targeting/LICENSE","archivePath":"mech-robot-hud-targeting/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/mech-robot-hud-targeting/styles.css","archivePath":"mech-robot-hud-targeting/styles.css"}]}
