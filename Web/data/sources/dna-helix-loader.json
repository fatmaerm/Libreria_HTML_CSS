{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>DNA Helix Loader</title>\n<meta name=\"description\" content=\"Pure CSS double-helix DNA strand loading animation.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"scene\">\n  <div class=\"helix\">\n    <div class=\"pair\" style=\"--i:0\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n    <div class=\"pair\" style=\"--i:1\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n    <div class=\"pair\" style=\"--i:2\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n    <div class=\"pair\" style=\"--i:3\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n    <div class=\"pair\" style=\"--i:4\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n    <div class=\"pair\" style=\"--i:5\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n    <div class=\"pair\" style=\"--i:6\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n    <div class=\"pair\" style=\"--i:7\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n    <div class=\"pair\" style=\"--i:8\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n    <div class=\"pair\" style=\"--i:9\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n    <div class=\"pair\" style=\"--i:10\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n    <div class=\"pair\" style=\"--i:11\"><span class=\"dot a\"></span><span class=\"dot b\"></span></div>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/dna-helix-loader/index.html","archivePath":"dna-helix-loader/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/dna-helix-loader/LICENSE","arch