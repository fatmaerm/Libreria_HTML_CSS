{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Polaroid Stack Gallery</title>\n<meta name=\"description\" content=\"Stacked polaroid photo cards that fan out on hover.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"polaroid-stack\">\n  <div class=\"polaroid\" style=\"--r:-12deg;z-index:1;background:#1a1a2e\"><div class=\"pol-img\">🌌</div><p>Memory</p></div><div class=\"polaroid\" style=\"--r:5deg;z-index:2;background:#1b2a4a\"><div class=\"pol-img\">🌊</div><p>Memory</p></div><div class=\"polaroid\" style=\"--r:-3deg;z-index:3;background:#2d1b1b\"><div class=\"pol-img\">🔥</div><p>Memory</p></div><div class=\"polaroid\" style=\"--r:8deg;z-index:4;background:#1a2e1a\"><div class=\"pol-img\">🌿</div><p>Memory</p></div><div class=\"polaroid\" style=\"--r:0deg;z-index:5;background:#2a1a2e\"><div class=\"pol-img\">⭐</div><p>Memory</p></div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/polaroid-stack-gallery/index.html","archivePath":"polaroid-stack-gallery/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/polaroid-stack-gallery/LICENSE","archivePath":"polaroid-stack-gallery/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/polaroid-stack-gallery/styles.css","archivePath":"polaroid-stack-gallery/styles.css"}]}
