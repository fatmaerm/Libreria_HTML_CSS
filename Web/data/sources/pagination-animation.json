{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Pagination Animation</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n    <!-- Ideally, this is gonna be rendered by backend -->\r\n<!-- But still not practical, so I wouldn't recommend this -->\r\n<div class=\"backdrop\">\r\n\t<div class=\"container\">\r\n\t\t<h1>Vegetables</h1>\r\n\t\t<div class=\"vegetables\">\r\n\t\t\t<ul class=\"list\">\r\n\t\t\t\t<li>Carrot</li>\r\n\t\t\t\t<li>Tomato</li>\r\n\t\t\t\t<li>Broccoli</li>\r\n\t\t\t\t<li>Cucumber</li>\r\n\t\t\t\t<li>Spinach</li>\r\n\t\t\t</ul>\r\n\t\t\t<!-- Page 1 -->\r\n\r\n\t\t\t<ul class=\"list\">\r\n\t\t\t\t<li>Potato</li>\r\n\t\t\t\t<li>Pepper</li>\r\n\t\t\t\t<li>Eggplant</li>\r\n\t\t\t\t<li>Lettuce</li>\r\n\t\t\t\t<li>Onion</li>\r\n\t\t\t</ul>\r\n\t\t\t<!-- Page 2 -->\r\n\r\n\t\t\t<ul class=\"list\">\r\n\t\t\t\t<li>Zucchini</li>\r\n\t\t\t\t<li>Cauliflower</li>\r\n\t\t\t\t<li>Kale</li>\r\n\t\t\t\t<li>Cabbage</li>\r\n\t\t\t\t<li>Mushroom</li>\r\n\t\t\t</ul>\r\n\t\t\t<!-- Page 3 -->\r\n\r\n\t\t\t<ul class=\"list\">\r\n\t\t\t\t<li>Asparagus</li>\r\n\t\t\t\t<li>Artichoke</li>\r\n\t\t\t\t<li>Radish</li>\r\n\t\t\t\t<li>Beet</li>\r\n\t\t\t\t<li>Okra</li>\r\n\t\t\t</ul>\r\n\t\t\t<!-- Page 4 -->\r\n\r\n\t\t\t<ul class=\"list\">\r\n\t\t\t\t<li>Brussels Sprouts</li>\r\n\t\t\t\t<li>Green Bean</li>\r\n\t\t\t\t<li>Butternut Squash</li>\r\n\t\t\t\t<li>Turnip</li>\r\n\t\t\t\t<li>Chard</li>\r\n\t\t\t</ul>\r\n\t\t\t<!-- Page 5 -->\r\n\t\t</div>\r\n\t\t<div class=\"pagination\">\r\n\t\t\t<span class=\"page-btn page-step\" data-shown=\"1\">&laquo;</span>\r\n\t\t\t<a href=\"#page-1\" class=\"page-btn page-step\" data-shown=\"2\">&laquo;</a>\r\n\t\t\t<a href=\"#page-2\" class=\"page-btn page-step\" data-shown=\"3\">&laquo;</a>\r\n\t\t\t<a href=\"#page-3\" class=\"page-btn page-step\" data-shown=\"4\">&laquo;</a>\r\n\t\t\t<a href=\"#page-4\" class=\"page-btn page-step\" data-shown=\"5\">&laquo;</a>\r\n\t\t\t<!-- Previous -->\r\n\r\n\t\t\t<a href=\"#page-1\" id=\"page-1\" class=\"page-btn\">1</a>\r\n\t\t\t<a href=\"#page-2\" id=\"page-2\" class=\"page-btn\">2</a>\r\n\t\t\t<a href=\"#page-3\" id=\"page-3\" class=\"page-btn\">3</a>\r\n\t\t\t<a href=\"#page-4\" id=\"page-4\" class=\"page-btn\">4</a>\r\n\t\t\t<a href=\"#page-5\" id=\"page-5\" class=\"page-btn\">5</a>\r\n\t\t\t<!-- Page numbers -->\r\n\r\n\t\t\t<a href=\"#page-2\" class=\"page-btn page-step\" data-shown=\"1\">&raquo;</a>\r\n\t\t\t<a href=\"#page-3\" class=\"page-btn page-step\" data-shown=\"2\">&raquo;</a>\r\n\t\t\t<a href=\"#page-4\" class=\"page-btn page-step\" data-shown=\"3\">&raquo;</a>\r\n\t\t\t<a href=\"#page-5\" class=\"page-btn page-step\" data-shown=\"4\">&raquo;</a>\r\n\t\t\t<span class=\"page-btn page-step\" data-shown=\"5\">&raquo;</span>\r\n\t\t\t<!-- Next -->\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/pagination-animation/index.html","archivePath":"pagination-animation/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/pagination-animation/style.css","archivePath":"pagination-animation/style.css"}]}
