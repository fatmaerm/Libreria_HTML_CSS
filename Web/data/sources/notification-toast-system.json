{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Notification Toast System</title>\n<meta name=\"description\" content=\"Stacking notification toast system with different types and auto-dismiss.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"demo-btns\">\n  <button class=\"trigger\" data-type=\"success\">✅ Success</button>\n  <button class=\"trigger\" data-type=\"error\">❌ Error</button>\n  <button class=\"trigger\" data-type=\"warning\">⚠️ Warning</button>\n  <button class=\"trigger\" data-type=\"info\">ℹ️ Info</button>\n</div>\n<div class=\"toast-stack\" id=\"stack\"></div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/notification-toast-system/index.html","archivePath":"notification-toast-system/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/notification-toast-system/LICENSE","archivePath":"notification-toast-system/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/notification-toast-system/script.js","archivePath":"notification-toast-system/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/notification-toast-system/styles.css","archivePath":"notification-toast-system/styles.css"}]}
