{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Code Diff Slider Preview</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"diff-container\" id=\"diffContainer\">\n    <div class=\"diff-panel before-panel\">\n      <div class=\"code-box\">\n        <span class=\"diff-badge badge-del\">- ANTES</span>\n        <pre><code><span class=\"kw\">function</span> <span class=\"fn\">fetchUser</span>(id) {\n  <span class=\"kw\">return</span> fetch(<span class=\"str\">'/api/'</span> + id)\n    .then(<span class=\"fn\">res</span> => res.json())\n    .catch(<span class=\"fn\">err</span> => {\n      console.log(err);\n    });\n}</code></pre>\n      </div>\n    </div>\n    <div class=\"diff-panel after-panel\" id=\"afterPanel\">\n      <div class=\"code-box\">\n        <span class=\"diff-badge badge-add\">+ AHORA</span>\n        <pre><code><span class=\"kw\">async function</span> <span class=\"fn\">fetchUser</span>(id) {\n  <span class=\"kw\">try</span> {\n    <span class=\"kw\">const</span> res = <span class=\"kw\">await</span> fetch(<span class=\"str\">`/api/${id}`</span>);\n    <span class=\"kw\">return await</span> res.json();\n  } <span class=\"kw\">catch</span> (err) {\n    <span class=\"fn\">logError</span>(err);\n  }\n}</code></pre>\n      </div>\n    </div>\n    <div class=\"slider-handle\" id=\"sliderHandle\">\n      <div class=\"handle-bar\"></div>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/code-diff-slider-preview/index.html","archivePath":"code-diff-slider-preview/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/code-diff-slider-preview/LICENSE","archivePath":"code-diff-slider-preview/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/code-diff-slider-preview/script.js","archivePath":"code-diff-slider-preview/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/code-diff-slider-preview/styles.css","archivePath":"code-diff-slider-preview/styles.css"}]}
