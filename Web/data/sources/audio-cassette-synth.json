{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Audio Cassette Synth</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"cassette-container\" aria-label=\"Cassette de música synthwave retro\">\n    <div class=\"cassette-body\">\n      <div class=\"screw top-left\"></div>\n      <div class=\"screw top-right\"></div>\n      <div class=\"screw bottom-left\"></div>\n      <div class=\"screw bottom-right\"></div>\n      \n      <div class=\"cassette-label\">\n        <div class=\"synth-stripes\">\n          <span></span><span></span><span></span>\n        </div>\n        <div class=\"label-header\">\n          <span class=\"side-tag\">LADO A</span>\n          <span class=\"album-title\">SYNTHWAVE DREAMS 1984</span>\n          <span class=\"eq-tag\">CHROME EQ</span>\n        </div>\n        \n        <div class=\"tape-window\">\n          <div class=\"tape-spool left-spool\">\n            <div class=\"spool-center\">\n              <span class=\"spool-teeth\"></span>\n            </div>\n            <div class=\"spool-wound wound-left\"></div>\n          </div>\n          \n          <div class=\"tape-bridge\">\n            <div class=\"tape-line\"></div>\n          </div>\n          \n          <div class=\"tape-spool right-spool\">\n            <div class=\"spool-center\">\n              <span class=\"spool-teeth\"></span>\n            </div>\n            <div class=\"spool-wound wound-right\"></div>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"cassette-bottom\">\n        <div class=\"guide-hole left-hole\"></div>\n        <div class=\"tape-head-window\"></div>\n        <div class=\"guide-hole right-hole\"></div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/audio-cassette-synth/index.html","archivePath":"audio-cassette-synth/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/audio-cassette-synth/LICENSE","archivePath":"audio-cassette-synth/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/audio-cassette-synth/styles.css","archivePath":"audio-cassette-synth/styles.css"}]}
