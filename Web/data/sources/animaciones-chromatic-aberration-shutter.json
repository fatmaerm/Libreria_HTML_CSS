{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Chromatic Aberration Shutter</title>\n<meta name=\"description\" content=\"Nine aperture blades stop down and reopen while RGB channel fringing splits the edges of a faceted subject and the focus racks as the iris closes.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"stage\">\n  <header class=\"mast\">\n    <span class=\"kicker\">Lens Bay 03</span>\n    <h1>Chromatic Aberration Shutter</h1>\n    <p class=\"lede\">Nine blades swing through their arc with a per-blade stagger, splitting the subject into red, green and blue planes while the follow focus lags behind the iris and the lateral fringing spikes on every fast move.</p>\n  </header>\n\n  <section class=\"view\" id=\"view\">\n    <div class=\"sweep\" aria-hidden=\"true\">\n      <span class=\"blob b1\"></span>\n      <span class=\"blob b2\"></span>\n      <span class=\"sweepline\"></span>\n      <span class=\"table\"></span>\n    </div>\n\n    <div class=\"barrel\" aria-hidden=\"true\">\n      <span class=\"ticks fine\"></span>\n      <span class=\"ticks coarse\"></span>\n      <span class=\"lip\"></span>\n    </div>\n\n    <div class=\"iris\" aria-hidden=\"true\">\n      <span class=\"blade\"></span>\n      <span class=\"blade\"></span>\n      <span class=\"blade\"></span>\n      <span class=\"blade\"></span>\n      <span class=\"blade\"></span>\n      <span class=\"blade\"></span>\n      <span class=\"blade\"></span>\n      <span class=\"blade\"></span>\n      <span class=\"blade\"></span>\n    </div>\n\n    <div class=\"subject\" aria-hidden=\"true\">\n      <span class=\"ca caR\"></span>\n      <span class=\"ca caG\"></span>\n      <span class=\"ca caB\"></span>\n    </div>\n\n    <div class=\"reflection\" aria-hidden=\"true\"></div>\n    <div class=\"veil\" aria-hidden=\"true\"></div>\n\n    <div class=\"vf\" aria-hidden=\"true\">\n      <span class=\"br tl\"></span><span class=\"br tr\"></span>\n      <span class=\"br bl\"></span><span class=\"br br2\"></span>\n      <span class=\"rule v1\"></span><span class=\"rule v2\"></span>\n      <span class=\"rule h1\"></span><span class=\"rule h2\"></span>\n      <span class=\"retic\"></span>\n      <span class=\"recdot\"></span>\n    </div>\n\n    <div class=\"hudtop\" aria-hidden=\"true\">\n      <span>FRAME 04</span><span id=\"tcode\">00:00:00</span><span id=\"tshutter\">1/48</span><span>ISO 800</span>\n    </div>\n    <div class=\"hudbot\" aria-hidden=\"true\">\n      <span id=\"tiris\">T1.4</span>\n      <span class=\"scale\"><i class=\"tick\"></i><i class=\"tick\"></i><i class=\"tick\"></i><i class=\"tick\"></i><i class=\"tick\"></i><i class=\"mark\" id=\"fmark\"></i></span>\n      <span id=\"tdist\">0.35 m</span>\n    </div>\n    <div class=\"badge\" aria-hidden=\"true\">Rack Focus</div>\n    <div class=\"lenslabel top\" aria-hidden=\"true\">Multi Coated Optics</div>\n    <div class=\"lenslabel bl\" aria-hidden=\"true\">1:1.4 / 85 mm</div>\n    <div class=\"lenslabel br\" aria-hidden=\"true\">Aspherical 9 Blade</div>\n\n    <div class=\"vignette\" aria-hidden=\"true\"></div>\n    <div class=\"grain\" aria-hidden=\"true\"></div>\n  </section>\n\n  <div class=\"hud\">\n    <div class=\"stat\"><span class=\"k\">Aperture</span><span class=\"v\" id=\"fstop\">T1.4</span></div>\n    <div class=\"stat\"><span class=\"k\">Focus</span><span class=\"v\" id=\"focus\">0.35 m</span></div>\n    <div class=\"stat\"><span class=\"k\">Channel Split</span><span class=\"v\" id=\"split\">0.0 px</span></div>\n    <div class=\"stat\"><span class=\"k\">Blades</span><span class=\"v\">9</span></div>\n    <div class=\"meter\"><span id=\"bar\"></span></div>\n  </div>\n\n  <p class=\"hint\">Move the pointer to orbit the subject, press it to force a full stop down</p>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/chromatic-aberration-shutter/index.html","archivePath":"animaciones-chromatic-aberration-shutter/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/chromatic-aberration-shutter/script.js","archivePath":"animaciones-chromatic-aberration-shutter/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/chromatic-aberration-shutter/styles.css","archivePath":"animaciones-chromatic-aberration-shutter/styles.css"}]}
