{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Pomodoro Timer Widget</title>\n<meta name=\"description\" content=\"Minimal Pomodoro productivity timer with work/break cycle tracking.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"pomo\">\n  <div class=\"pomo-mode\" id=\"modeLabel\">Work</div>\n  <svg class=\"pomo-ring\" viewBox=\"0 0 120 120\">\n    <circle class=\"ring-bg\" cx=\"60\" cy=\"60\" r=\"52\"/>\n    <circle class=\"ring-fill\" cx=\"60\" cy=\"60\" r=\"52\" id=\"ringFill\"/>\n  </svg>\n  <div class=\"pomo-time\" id=\"pomoTime\">25:00</div>\n  <div class=\"pomo-controls\">\n    <button id=\"pStart\">▶</button>\n    <button id=\"pReset\">↺</button>\n    <button id=\"pSkip\">⏭</button>\n  </div>\n  <div class=\"pomo-sessions\">Session <span id=\"sess\">1</span>/4</div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/pomodoro-timer-widget/index.html","archivePath":"pomodoro-timer-widget/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/pomodoro-timer-widget/LICENSE","archivePath":"pomodoro-timer-widget/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/pomodoro-timer-widget/script.js","archivePath":"pomodoro-timer-widget/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/pomodoro-timer-widget/styles.css","archivePath":"pomodoro-timer-widget/styles.css"}]}
