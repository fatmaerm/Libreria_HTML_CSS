{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Color Swatch Toggle</title>\n<meta name=\"description\" content=\"Color theme swatch picker with animated selection ring.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"picker\">\n  <h3>Choose Theme</h3>\n  <div class=\"swatches\" id=\"swatches\">\n    <button class=\"swatch active\" style=\"--c:#6366f1\" data-color=\"#6366f1\"></button><button class=\"swatch\" style=\"--c:#10b981\" data-color=\"#10b981\"></button><button class=\"swatch\" style=\"--c:#f59e0b\" data-color=\"#f59e0b\"></button><button class=\"swatch\" style=\"--c:#ef4444\" data-color=\"#ef4444\"></button><button class=\"swatch\" style=\"--c:#06b6d4\" data-color=\"#06b6d4\"></button><button class=\"swatch\" style=\"--c:#a855f7\" data-color=\"#a855f7\"></button><button class=\"swatch\" style=\"--c:#ec4899\" data-color=\"#ec4899\"></button><button class=\"swatch\" style=\"--c:#84cc16\" data-color=\"#84cc16\"></button>\n  </div>\n  <div class=\"preview\" id=\"preview\">Selected: #6366f1</div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/color-swatch-toggle/index.html","archivePath":"color-swatch-toggle/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/color-swatch-toggle/LICENSE","archivePath":"color-swatch-toggle/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/color-swatch-toggle/script.js","archivePath":"color-swatch-toggle/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/color-swatch-toggle/styles.css","archivePath":"color-swatch-toggle/styles.css"}]}
