{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Server Rack LED Blinker</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"rack-cabinet\" aria-label=\"Gabinete de servidores con LEDs\">\n    <div class=\"blade blade-1\">\n      <div class=\"blade-handle\"></div><span class=\"blade-tag\">NODE 01</span>\n      <div class=\"led-array\"><span class=\"led led-green l1\"></span><span class=\"led led-green l2\"></span><span class=\"led led-blue l3\"></span><span class=\"led led-amber l4\"></span></div>\n    </div>\n    <div class=\"blade blade-2\">\n      <div class=\"blade-handle\"></div><span class=\"blade-tag\">NODE 02</span>\n      <div class=\"led-array\"><span class=\"led led-green l5\"></span><span class=\"led led-blue l6\"></span><span class=\"led led-green l7\"></span><span class=\"led led-green l8\"></span></div>\n    </div>\n    <div class=\"blade blade-3\">\n      <div class=\"blade-handle\"></div><span class=\"blade-tag\">NODE 03</span>\n      <div class=\"led-array\"><span class=\"led led-blue l9\"></span><span class=\"led led-green l10\"></span><span class=\"led led-amber l11\"></span><span class=\"led led-green l12\"></span></div>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/server-rack-led-blinker/index.html","archivePath":"server-rack-led-blinker/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/server-rack-led-blinker/LICENSE","archivePath":"server-rack-led-blinker/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/server-rack-led-blinker/styles.css","archivePath":"server-rack-led-blinker/styles.css"}]}
