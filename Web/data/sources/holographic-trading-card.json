{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Holographic Trading Card</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"card-wrap\" id=\"cardWrap\">\n    <div class=\"holo-card\" id=\"holoCard\">\n      <div class=\"card-foil\"></div>\n      <div class=\"card-glare\"></div>\n      <div class=\"card-content\">\n        <div class=\"card-header\">\n          <span class=\"rarity-badge\">★ ULTRA RARE</span>\n          <span class=\"hp-stat\">HP 950</span>\n        </div>\n        <div class=\"card-art-box\">\n          <div class=\"art-sphere\"></div>\n          <div class=\"art-ring\"></div>\n        </div>\n        <div class=\"card-info\">\n          <h2 class=\"creature-name\">CHRONO DRAGON</h2>\n          <p class=\"creature-type\">Dragón de Plasma Temporal</p>\n          <div class=\"attack-row\">\n            <span class=\"atk-name\">SUPERNOVA BURST</span>\n            <span class=\"atk-dmg\">320</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/holographic-trading-card/index.html","archivePath":"holographic-trading-card/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/holographic-trading-card/LICENSE","archivePath":"holographic-trading-card/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/holographic-trading-card/script.js","archivePath":"holographic-trading-card/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/holographic-trading-card/styles.css","archivePath":"holographic-trading-card/styles.css"}]}
