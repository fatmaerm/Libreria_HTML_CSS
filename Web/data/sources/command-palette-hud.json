{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Command Palette HUD</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"palette-modal\">\n    <div class=\"search-input-row\">\n      <span class=\"search-icon\">🔍</span>\n      <input type=\"text\" class=\"search-field\" placeholder=\"Escribe un comando o archivo...\" id=\"cmdInput\">\n      <span class=\"cmd-shortcut\">ESC</span>\n    </div>\n    <div class=\"results-list\" id=\"resultsList\">\n      <div class=\"result-item active\">\n        <span class=\"r-icon\">⚡</span>\n        <div class=\"r-text\"><span class=\"r-title\">Desplegar en Vercel (Producción)</span><span class=\"r-sub\">vercel --prod</span></div>\n        <span class=\"r-badge\">↵ Ejecutar</span>\n      </div>\n      <div class=\"result-item\">\n        <span class=\"r-icon\">🔄</span>\n        <div class=\"r-text\"><span class=\"r-title\">Regenerar Catálogo de Componentes</span><span class=\"r-sub\">node scripts/generate-catalog.mjs</span></div>\n        <span class=\"r-badge\">↵ Ejecutar</span>\n      </div>\n      <div class=\"result-item\">\n        <span class=\"r-icon\">🧪</span>\n        <div class=\"r-text\"><span class=\"r-title\">Ejecutar Suite de Pruebas</span><span class=\"r-sub\">npm test --watch</span></div>\n        <span class=\"r-badge\">↵ Ejecutar</span>\n      </div>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/command-palette-hud/index.html","archivePath":"command-palette-hud/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/command-palette-hud/LICENSE","archivePath":"command-palette-hud/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/command-palette-hud/script.js","archivePath":"command-palette-hud/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/command-palette-hud/styles.css","archivePath":"command-palette-hud/styles.css"}]}
