{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Koi Pond Ripple Trail</title>\n<meta name=\"description\" content=\"Amber and cream koi steer beneath a dark reflective pond surface, trailing fading ripple rings through drifting caustic light.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"pond\">\n  <canvas class=\"pond__water\" id=\"water\" aria-hidden=\"true\"></canvas>\n  <div class=\"pond__shafts\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></div>\n  <div class=\"pond__sheen\" aria-hidden=\"true\"></div>\n  <div class=\"pond__rim\" aria-hidden=\"true\"></div>\n  <div class=\"pond__vignette\" aria-hidden=\"true\"></div>\n  <div class=\"pond__grain\" aria-hidden=\"true\"></div>\n  <div class=\"plate\">\n    <p class=\"plate__eyebrow\">Pond Study No. 01</p>\n    <h1 class=\"plate__title\">Koi Ripple Trail</h1>\n    <p class=\"plate__rule\"></p>\n    <p class=\"plate__meta\">Steering shoal &middot; caustic veil &middot; surface rings</p>\n  </div>\n</div>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/koi-pond-ripple-trail/index.html","archivePath":"animaciones-koi-pond-ripple-trail/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/koi-pond-ripple-trail/script.js","archivePath":"animaciones-koi-pond-ripple-trail/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/koi-pond-ripple-trail/styles.css","archivePath":"animaciones-koi-pond-ripple-trail/styles.css"}]}
