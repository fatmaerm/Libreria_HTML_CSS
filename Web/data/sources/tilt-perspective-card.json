{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Tilt Perspective Card</title>\n<meta name=\"description\" content=\"Mouse-tracking 3D tilt card with specular highlight.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"scene\">\n  <div class=\"tilt-card\" id=\"tc\">\n    <div class=\"shine\" id=\"shine\"></div>\n    <div class=\"tilt-content\">\n      <div class=\"tc-icon\">🌌</div>\n      <h2>Tilt Card</h2>\n      <p>Move your cursor over me</p>\n    </div>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/tilt-perspective-card/index.html","archivePath":"tilt-perspective-card/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/tilt-perspective-card/LICENSE","archivePath":"tilt-perspective-card/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/tilt-perspective-card/script.js","archivePath":"tilt-perspective-card/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/tilt-perspective-card/styles.css","archivePath":"tilt-perspective-card/styles.css"}]}
