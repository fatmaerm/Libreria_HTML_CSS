{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Wave Accordion Stack</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"stack\">\n    <details open>\n      <summary>Ola 01</summary>\n      <p>Panel que se despliega con curva animada.</p>\n    </details>\n    <details>\n      <summary>Ola 02</summary>\n      <p>Segundo bloque con retardo escalonado.</p>\n    </details>\n    <details>\n      <summary>Ola 03</summary>\n      <p>Tercer bloque para completar la cascada.</p>\n    </details>\n  </div>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/wave-accordion-stack/index.html","archivePath":"wave-accordion-stack/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/wave-accordion-stack/LICENSE","archivePath":"wave-accordion-stack/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/wave-accordion-stack/styles.css","archivePath":"wave-accordion-stack/styles.css"}]}
