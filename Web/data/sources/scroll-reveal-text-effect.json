{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Scroll Reveal Text Effect</title>\n<meta name=\"description\" content=\"Words that fade and slide into view as you scroll down the page.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"hero-space\"><p>↓ Scroll down</p></div>\n<div class=\"reveal-section\">\n  <span class=\"reveal-word\">Design</span> <span class=\"reveal-word\">beautifully.</span> <span class=\"reveal-word\">Build</span> <span class=\"reveal-word\">efficiently.</span> <span class=\"reveal-word\">Ship</span> <span class=\"reveal-word\">confidently.</span>\n</div>\n<div class=\"hero-space\"></div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/scroll-reveal-text-effect/index.html","archivePath":"scroll-reveal-text-effect/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/scroll-reveal-text-effect/LICENSE","archivePath":"scroll-reveal-text-effect/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/scroll-reveal-text-effect/script.js","archivePath":"scroll-reveal-text-effect/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/scroll-reveal-text-effect/styles.css","archivePath":"scroll-reveal-text-effect/styles.css"}]}
