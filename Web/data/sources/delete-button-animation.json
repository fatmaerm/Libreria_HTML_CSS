{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n    <title>Delete Button Animation</title>\r\n</head>\r\n<body>\r\n    <button class=\"button\">\r\n        <div class=\"trash\">\r\n            <div class=\"top\">\r\n                <div class=\"paper\"></div>\r\n            </div>\r\n            <div class=\"box\"></div>\r\n            <div class=\"check\">\r\n                <svg viewBox=\"0 0 8 6\">\r\n                    <polyline points=\"1 3.4 2.71428571 5 7 1\"></polyline>\r\n                </svg>\r\n            </div>\r\n        </div>\r\n        <span>Delete Item</span>\r\n    </button>\r\n    <script src=\"script.js\"></script>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/delete-button-animation/index.html","archivePath":"delete-button-animation/index.html"},{"name":"script.js","relativePath":"script.js","path":"../BibliotecaDeHtml_CSS/delete-button-animation/script.js","archivePath":"delete-button-animation/script.js"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/delete-button-animation/style.css","archivePath":"delete-button-animation/style.css"}]}
