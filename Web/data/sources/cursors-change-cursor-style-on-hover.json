{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Change Cursor Style On Hover</title>\r\n\r\n    <link rel=\"stylesheet\" href=\"styles.css\">\r\n</head>\r\n<body>\r\n    <ul>\r\n        <li><a href=\"#\">Home</a></li>\r\n        <li><a href=\"#\">About</a></li>\r\n        <li><a href=\"#\">Portfolio</a></li>\r\n        <li><a href=\"#\">Team</a></li>\r\n        <li><a href=\"#\">Contact</a></li>\r\n\r\n        <div class=\"cursor\"></div>\r\n    </ul>\r\n\r\n    <script>\r\n        let cursor = document.querySelector('.cursor');\r\n        document.addEventListener('mousemove' , (e) => {\r\n            cursor.style.left = e.pageX + 'px';\r\n            cursor.style.top = e.pageY + 'px';\r\n        })\r\n\r\n    </script>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":["let cursor = document.querySelector('.cursor');\r\n        document.addEventListener('mousemove' , (e) => {\r\n            cursor.style.left = e.pageX + 'px';\r\n            cursor.style.top = e.pageY + 'px';\r\n        })"],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/cursors/change-cursor-style-on-hover/index.html","archivePath":"cursors-change-cursor-style-on-hover/index.html"},{"name":"styles.css","relativePath":"styles.css","path":"../BibliotecaDeHtml_CSS/cursors/change-cursor-style-on-hover/styles.css","archivePath":"cursors-change-cursor-style-on-hover/styles.css"}]}
