{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Fiber Optic Light Stream</title>\n<meta name=\"description\" content=\"Pulses of light enter a branching fibre bundle, split at every junction and bloom where each strand ends.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"scene\">\n  <div class=\"glow-a\"></div>\n  <div class=\"glow-b\"></div>\n  <div class=\"bench\"></div>\n  <div class=\"bench-grid\"></div>\n  <canvas class=\"stage\" id=\"stage\" role=\"img\" aria-label=\"Light pulses travel a branching bundle of fibre optic strands and glow at each terminal end\"></canvas>\n  <div class=\"grain\"></div>\n  <div class=\"vignette\"></div>\n  <div class=\"frame\"></div>\n\n  <header class=\"hud\">\n    <p class=\"kicker\">Network 04 &middot; Photonics</p>\n    <h1>Light&nbsp;Stream</h1>\n    <p class=\"sub\">Pulses enter a single trunk, then divide at every junction and travel the full length of the bundle, flaring to white where a strand terminates.</p>\n  </header>\n\n  <section class=\"readout\" aria-label=\"Bundle readout\">\n    <dl class=\"stats\">\n      <div class=\"stat\"><dt>Strands</dt><dd id=\"rStrands\">&mdash;</dd></div>\n      <div class=\"stat\"><dt>Junctions</dt><dd id=\"rJunc\">&mdash;</dd></div>\n      <div class=\"stat\"><dt>In flight</dt><dd id=\"rLive\">&mdash;</dd></div>\n      <div class=\"stat\"><dt>State</dt><dd id=\"rState\">Running</dd></div>\n    </dl>\n    <div class=\"meter\" aria-hidden=\"true\"><span class=\"meter-fill\" id=\"rBar\"></span></div>\n    <div class=\"controls\">\n      <button class=\"btn\" type=\"button\" data-rate=\"0.5\">Half rate</button>\n      <button class=\"btn is-on\" type=\"button\" data-rate=\"1\">Nominal</button>\n      <button class=\"btn\" type=\"button\" data-rate=\"1.9\">Surge</button>\n    </div>\n  </section>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/fiber-optic-light-stream/index.html","archivePath":"animaciones-fiber-optic-light-stream/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/fiber-optic-light-stream/script.js","archivePath":"animaciones-fiber-optic-light-stream/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/fiber-optic-light-stream/styles.css","archivePath":"animaciones-fiber-optic-light-stream/styles.css"}]}
