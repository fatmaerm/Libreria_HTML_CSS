{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Weather Forecast Card</title>\n<meta name=\"description\" content=\"Beautiful animated weather card with temperature and forecast strip.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"weather-card\">\n  <div class=\"weather-main\">\n    <div class=\"weather-icon\">⛅</div>\n    <div class=\"temp\">18°</div>\n    <div class=\"condition\">Partly Cloudy</div>\n    <div class=\"location\">📍 Madrid, ES</div>\n  </div>\n  <div class=\"forecast\">\n    <div class=\"day\"><span>Mon</span><span>☀️</span><span>22°</span></div><div class=\"day\"><span>Tue</span><span>⛅</span><span>18°</span></div><div class=\"day\"><span>Wed</span><span>🌧️</span><span>15°</span></div><div class=\"day\"><span>Thu</span><span>⛅</span><span>17°</span></div><div class=\"day\"><span>Fri</span><span>☀️</span><span>24°</span></div>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/weather-forecast-card/index.html","archivePath":"weather-forecast-card/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/weather-forecast-card/LICENSE","archivePath":"weather-forecast-card/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/weather-forecast-card/styles.css","archivePath":"weather-forecast-card/styles.css"}]}
