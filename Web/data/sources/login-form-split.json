{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Login Form Split</title>\n<meta name=\"description\" content=\"Split-panel login form with branded illustration side.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"login-wrap\">\n  <div class=\"login-brand\">\n    <div class=\"brand-icon\">⟨/⟩</div>\n    <h1>ComponentField</h1>\n    <p>The web's component library</p>\n  </div>\n  <div class=\"login-form-side\">\n    <h2>Welcome back</h2>\n    <p class=\"sub\">Sign in to your account</p>\n    <div class=\"lfield\"><label>Email</label><input type=\"email\" placeholder=\"you@example.com\"></div>\n    <div class=\"lfield\"><label>Password</label><input type=\"password\" placeholder=\"••••••••\"></div>\n    <div class=\"options\"><label><input type=\"checkbox\"> Remember me</label><a href=\"#\">Forgot password?</a></div>\n    <button class=\"lbtn\">Sign In</button>\n    <p class=\"lalt\">Don't have an account? <a href=\"#\">Sign up</a></p>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/login-form-split/index.html","archivePath":"login-form-split/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/login-form-split/LICENSE","archivePath":"login-form-split/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/login-form-split/styles.css","archivePath":"login-form-split/styles.css"}]}
