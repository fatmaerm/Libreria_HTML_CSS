{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Pixel Mosaic Dissolve</title>\n<meta name=\"description\" content=\"A procedurally generated gradient-and-shape landscape shatters into a staggered grid of squares and reforms along a glowing wavefront.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"aurora\" aria-hidden=\"true\"></div>\n<main class=\"mosaic\">\n  <canvas class=\"mosaic-canvas\" id=\"mosaic\" role=\"img\" aria-label=\"Animated pixel mosaic that dissolves into a grid of squares and reforms.\"></canvas>\n  <div class=\"mosaic-scan\" aria-hidden=\"true\"></div>\n  <div class=\"mosaic-edge\" aria-hidden=\"true\"></div>\n  <header class=\"mosaic-head\">\n    <span class=\"eyebrow\">Procedural Field</span>\n    <h1>Pixel Mosaic Dissolve</h1>\n    <p>Every square is a sampled gradient. The wavefront scatters them outward, then gathers them back.</p>\n  </header>\n  <div class=\"mosaic-hud\">\n    <div class=\"hud-line\">\n      <span class=\"hud-key\">State</span>\n      <span class=\"hud-val\" id=\"phaseLabel\">Assembled</span>\n    </div>\n    <div class=\"hud-bar\"><i id=\"barFill\"></i></div>\n    <div class=\"hud-line hud-foot\">\n      <span class=\"hud-dim\" id=\"cellCount\">0 cells</span>\n      <span class=\"hud-dim\" id=\"pctLabel\">0%</span>\n    </div>\n  </div>\n  <div class=\"mosaic-stamp\" aria-hidden=\"true\">\n    <span>Grid</span>\n    <span id=\"gridStamp\">00 x 00</span>\n  </div>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/pixel-mosaic-dissolve/index.html","archivePath":"animaciones-pixel-mosaic-dissolve/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/pixel-mosaic-dissolve/script.js","archivePath":"animaciones-pixel-mosaic-dissolve/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/pixel-mosaic-dissolve/styles.css","archivePath":"animaciones-pixel-mosaic-dissolve/styles.css"}]}
