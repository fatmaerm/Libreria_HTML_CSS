{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Elastic Toggle Switch</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n    <div class=\"toggle\">\r\n\r\n        <input type=\"checkbox\" id=\"btn\">\r\n        <label for=\"btn\">\r\n          <span class=\"thumb\"></span>\r\n        </label>\r\n        <div class=\"lights\">\r\n          <span class=\"light-off\"></span>\r\n          <span class=\"light-on\"></span>\r\n        </div>\r\n      \r\n    </div>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/elastic-toggle-switch/index.html","archivePath":"elastic-toggle-switch/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/elastic-toggle-switch/style.css","archivePath":"elastic-toggle-switch/style.css"}]}
