{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Terminal Syntax Highlighter</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"editor-window\">\n    <div class=\"editor-titlebar\">\n      <div class=\"window-controls\">\n        <span class=\"ctrl-close\"></span><span class=\"ctrl-min\"></span><span class=\"ctrl-max\"></span>\n      </div>\n      <span class=\"doc-tab\">server.ts</span>\n    </div>\n    <div class=\"code-area\">\n      <div class=\"line-nums\"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span></div>\n      <div class=\"code-lines\">\n        <div><span class=\"kwd\">import</span> { <span class=\"cls\">FastifyInstance</span> } <span class=\"kwd\">from</span> <span class=\"str\">'fastify'</span>;</div>\n        <div></div>\n        <div><span class=\"kwd\">export async function</span> <span class=\"fn\">routes</span>(<span class=\"var\">app</span>: <span class=\"cls\">FastifyInstance</span>) {</div>\n        <div>&nbsp;&nbsp;<span class=\"var\">app</span>.<span class=\"fn\">get</span>(<span class=\"str\">'/health'</span>, <span class=\"kwd\">async</span> () => ({</div>\n        <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"prop\">status</span>: <span class=\"str\">'online'</span>,</div>\n        <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"prop\">timestamp</span>: <span class=\"fn\">Date</span>.<span class=\"fn\">now</span>()</div>\n        <div>&nbsp;&nbsp;}));<span class=\"caret\"></span></div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/terminal-syntax-highlighter/index.html","archivePath":"terminal-syntax-highlighter/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/terminal-syntax-h