{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Kinetic Fluid Slider</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"fluid-slider-box\">\n    <div class=\"slider-header\">\n      <span class=\"label\">VOLUMEN BIÓNICO</span>\n      <span class=\"value-display\" id=\"valDisplay\">65%</span>\n    </div>\n    <div class=\"slider-track\" id=\"sliderTrack\">\n      <div class=\"track-fill\" id=\"trackFill\"></div>\n      <div class=\"fluid-thumb\" id=\"fluidThumb\">\n        <div class=\"thumb-glow\"></div>\n      </div>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/kinetic-fluid-slider/index.html","archivePath":"kinetic-fluid-slider/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/kinetic-fluid-slider/LICENSE","archivePath":"kinetic-fluid-slider/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/kinetic-fluid-slider/script.js","archivePath":"kinetic-fluid-slider/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/kinetic-fluid-slider/styles.css","archivePath":"kinetic-fluid-slider/styles.css"}]}
