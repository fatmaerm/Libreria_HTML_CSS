{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Docker Container Pod Status</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"pod-card\">\n    <div class=\"pod-header\">\n      <div class=\"pod-title-box\">\n        <span class=\"whale-icon\">🐳</span>\n        <h3>redis-cache-cluster</h3>\n      </div>\n      <span class=\"replica-badge\">3 / 3 LISTO</span>\n    </div>\n    <div class=\"pod-replicas\">\n      <div class=\"replica-node healthy\">\n        <span class=\"node-indicator\"></span><span class=\"node-id\">pod-01</span>\n      </div>\n      <div class=\"replica-node healthy\">\n        <span class=\"node-indicator\"></span><span class=\"node-id\">pod-02</span>\n      </div>\n      <div class=\"replica-node healthy\">\n        <span class=\"node-indicator\"></span><span class=\"node-id\">pod-03</span>\n      </div>\n    </div>\n    <div class=\"pod-metrics\">\n      <div class=\"metric\"><span class=\"m-label\">CPU</span><span class=\"m-val\">12%</span></div>\n      <div class=\"metric\"><span class=\"m-label\">MEMORIA</span><span class=\"m-val\">184MB</span></div>\n      <div class=\"metric\"><span class=\"m-label\">UPTIME</span><span class=\"m-val\">14d 8h</span></div>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/docker-container-pod-status/index.html","archivePath":"docker-container-pod-status/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/docker-container-pod-status/LICENSE","archivePath":"docker-container-pod-status/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/docker-container-pod-status/styles.css","archivePath":"docker-container-pod-status/styles.css"}]}
