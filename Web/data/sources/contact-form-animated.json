{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Contact Form Animated</title>\n<meta name=\"description\" content=\"Minimal contact form with send animation and success state.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<form class=\"cform\" id=\"cform\" novalidate>\n  <h2>Get in Touch</h2>\n  <div class=\"cfield\"><input type=\"text\" placeholder=\"Your name\" required id=\"cname\"></div>\n  <div class=\"cfield\"><input type=\"email\" placeholder=\"Email address\" required id=\"cemail\"></div>\n  <div class=\"cfield\"><textarea rows=\"4\" placeholder=\"Your message…\" required id=\"cmsg\"></textarea></div>\n  <button type=\"submit\" class=\"csend\" id=\"csend\"><span id=\"cslbl\">Send Message</span><span class=\"arrow\">→</span></button>\n  <div class=\"success\" id=\"csuccess\" hidden>✅ Message sent! I'll reply soon.</div>\n</form>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/contact-form-animated/index.html","archivePath":"contact-form-animated/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/contact-form-animated/LICENSE","archivePath":"contact-form-animated/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/contact-form-animated/script.js","archivePath":"contact-form-animated/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/contact-form-animated/styles.css","archivePath":"contact-form-animated/styles.css"}]}
