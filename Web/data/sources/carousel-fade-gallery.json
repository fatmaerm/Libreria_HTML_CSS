{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Carousel Fade Gallery</title>\n<meta name=\"description\" content=\"Auto-advancing image carousel with crossfade transition and dot controls.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"carousel\">\n  <div class=\"slides\" id=\"slides\">\n    <div class=\"slide\" style=\"background:#1a1a2e;opacity:1\" aria-hidden=\"false\"><span>🌌 Galaxy</span></div><div class=\"slide\" style=\"background:#16213e;opacity:0\" aria-hidden=\"true\"><span>🏔️ Mountains</span></div><div class=\"slide\" style=\"background:#0f3460;opacity:0\" aria-hidden=\"true\"><span>🌊 Ocean</span></div><div class=\"slide\" style=\"background:#1e293b;opacity:0\" aria-hidden=\"true\"><span>🌇 City</span></div><div class=\"slide\" style=\"background:#14532d;opacity:0\" aria-hidden=\"true\"><span>🌿 Forest</span></div>\n  </div>\n  <div class=\"dots\" id=\"dots\">\n    <button class=\"cdot active\" data-i=\"0\"></button><button class=\"cdot\" data-i=\"1\"></button><button class=\"cdot\" data-i=\"2\"></button><button class=\"cdot\" data-i=\"3\"></button><button class=\"cdot\" data-i=\"4\"></button>\n  </div>\n  <button class=\"arr prev\" id=\"prev\">‹</button>\n  <button class=\"arr next\" id=\"next\">›</button>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/carousel-fade-gallery/index.html","archivePath":"carousel-fade-gallery/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/carousel-fade-gallery/LICENSE","archivePath":"carousel-fade-gallery/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/carousel-fade-gallery/script.js","archivePath":"carousel-fade-gallery/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/carousel-fade-gallery/styles.css","archivePath":"carousel-fade-gallery/styles.css"}]}
