{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Subscription Form</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n    <div class=\"subscribe\">\r\n        <h2 class=\"subscribe__title\">Let's keep in touch</h2>\r\n        <p class=\"subscribe__copy\">Subscribe to keep up with fresh news and exciting updates. We promise not to spam you!</p>\r\n        <div class=\"form\">\r\n            <input type=\"email\" class=\"form__email\" placeholder=\"Enter your email address\" />\r\n            <button class=\"form__button\">Send</button>\r\n        </div>\r\n        <div class=\"notice\">\r\n            <input type=\"checkbox\">\r\n            <span class=\"notice__copy\">I agree to my email address being stored and uses to recieve monthly newsletter.</span>\r\n        </div>\r\n    </div>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/subscription-form/index.html","archivePath":"subscription-form/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/subscription-form/style.css","archivePath":"subscription-form/style.css"}]}
