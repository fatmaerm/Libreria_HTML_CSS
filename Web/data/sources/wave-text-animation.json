{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Wave Text Animation</title>\n<meta name=\"description\" content=\"Individual letter wave bounce animation with staggered delays.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<h1 class=\"wave-text\" aria-label=\"Wave Animation\">\n  <span style=\"--i:0\">W</span><span style=\"--i:1\">a</span><span style=\"--i:2\">v</span><span style=\"--i:3\">e</span>&nbsp;<span style=\"--i:5\">A</span><span style=\"--i:6\">n</span><span style=\"--i:7\">i</span><span style=\"--i:8\">m</span><span style=\"--i:9\">a</span><span style=\"--i:10\">t</span><span style=\"--i:11\">i</span><span style=\"--i:12\">o</span><span style=\"--i:13\">n</span>\n</h1>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/wave-text-animation/index.html","archivePath":"wave-text-animation/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/wave-text-animation/LICENSE","archivePath":"wave-text-animation/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/wave-text-animation/styles.css","archivePath":"wave-text-animation/styles.css"}]}
