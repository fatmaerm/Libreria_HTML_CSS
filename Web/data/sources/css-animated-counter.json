{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>CSS Animated Counter</title>\n<meta name=\"description\" content=\"Number count-up animation triggered by Intersection Observer.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"hero-stats\">\n  <div class=\"stat\"><span class=\"count\" data-target=\"10000\">0</span><span class=\"unit\">+</span><p>Components</p></div>\n  <div class=\"stat\"><span class=\"count\" data-target=\"500\">0</span><span class=\"unit\">K</span><p>Downloads</p></div>\n  <div class=\"stat\"><span class=\"count\" data-target=\"99\">0</span><span class=\"unit\">%</span><p>Satisfaction</p></div>\n  <div class=\"stat\"><span class=\"count\" data-target=\"48\">0</span><span class=\"unit\">h</span><p>Support</p></div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/css-animated-counter/index.html","archivePath":"css-animated-counter/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/css-animated-counter/LICENSE","archivePath":"css-animated-counter/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/css-animated-counter/script.js","archivePath":"css-animated-counter/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/css-animated-counter/styles.css","archivePath":"css-animated-counter/styles.css"}]}
