{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Modern Contact Card</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\"\r\n        integrity=\"sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==\"\r\n        crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\" />\r\n</head>\r\n<body>\r\n    <div class=\"container\">\r\n        <button class=\"see_content\">\r\n            See Contact\r\n        </button>\r\n        <div class=\"developer\">\r\n            <div class=\"pic\">\r\n                <img src=\"moshed-2023-10-17-13-58-25.gif\" alt=\"\">\r\n            </div>\r\n            <div class=\"dev_name\">\r\n                <h3>GevStack</h3>\r\n                <div class=\"badge\">\r\n                    <span>Web Developer</span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"divider\"></div>\r\n        <div class=\"contact_details\">\r\n            <div class=\"icon_info\">\r\n                <div class=\"icon\">\r\n                    <i class=\"fa-solid fa-envelope\"></i>\r\n                </div>\r\n                <div class=\"details\">\r\n                    <div class=\"details_name\">\r\n                        <p>email</p>\r\n                    </div>\r\n                    <div class=\"info\">\r\n                        <span>gevendra04@gmail.com</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"icon_info\">\r\n                <div class=\"icon\">\r\n                    <i class=\"fa-solid fa-phone\"></i>\r\n                </div>\r\n                <div class=\"details\">\r\n                    <div class=\"details_name\">\r\n                        <p>phone</p>\r\n                    </div>\r\n                    <div class=\"info\">\r\n                        <span>+91 0987654321</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"icon_info\">\r\n                <div class=\"icon\">\r\n                    <i class=\"fa-solid fa-calendar-days\"></i>\r\n                </div>\r\n                <div class=\"details\">\r\n                    <div class=\"details_name\">\r\n                        <p>birthday</p>\r\n                    </div>\r\n                    <div class=\"info\">\r\n                        <span>June 08, 2004</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"icon_info\">\r\n                <div class=\"icon\">\r\n                    <i class=\"fa-solid fa-location-dot\"></i>\r\n                </div>\r\n                <div class=\"details\">\r\n                    <div class=\"details_name\">\r\n                        <p>location</p>\r\n                    </div>\r\n                    <div class=\"info\">\r\n                        <span>Chhattishgarh Bharat</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"divider\"></div>\r\n            <div class=\"social_media\">\r\n                <div class=\"social\">\r\n                <div class=\"facebook\">\r\n                    <a href=\"#\">\r\n                        <i class=\"fa-brands fa-facebook-f\"></i>\r\n                    </a>\r\n                </div>\r\n                <div class=\"x\">\r\n                    <a href=\"#\">\r\n                        <i class=\"fa-brands fa-x-twitter\"></i>\r\n                    </a>\r\n\r\n                </div>\r\n                <div class=\"instagram\">\r\n                    <a href=\"#\">\r\n                        <i class=\"fa-brands fa-instagram\"></i>\r\n                    </a>\r\n\r\n                </div>\r\n            </div>\r\n            <div class=\"made_by\">\r\n                <span>made by gevstack</span>\r\n            </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <script src=\"main.js\"></script>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"creation-demo.otf","relativePath":"font/creation-demo.otf","path":"../BibliotecaDeHtml_CSS/modern-contact-card/font/creation-demo.otf","archivePath":"modern-contact-card/font/creation-demo.otf"},{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/modern-contact-card/index.html","archivePath":"modern-contact-card/index.html"},{"name":"logo.jpg","relativePath":"logo.jpg","path":"../BibliotecaDeHtml_CSS/modern-contact-card/logo.jpg","archivePath":"modern-contact-card/logo.jpg"},{"name":"main.js","relativePath":"main.js","path":"../BibliotecaDeHtml_CSS/modern-contact-card/main.js","archivePath":"modern-contact-card/main.js"},{"name":"moshed-2023-10-17-13-58-25.gif","relativePath":"moshed-2023-10-17-13-58-25.gif","path":"../BibliotecaDeHtml_CSS/modern-contact-card/moshed-2023-10-17-13-58-25.gif","archivePath":"modern-contact-card/moshed-2023-10-17-13-58-25.gif"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/modern-contact-card/style.css","archivePath":"modern-contact-card/style.css"}]}
