{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Env Variables Secret Toggle</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"env-card\">\n    <div class=\"env-header\">\n      <span class=\"file-tag\">.env.production</span>\n      <span class=\"lock-icon\">🔒 ENCRIPTADO</span>\n    </div>\n    <div class=\"env-row\">\n      <span class=\"env-key\">DATABASE_URL</span>\n      <span class=\"env-val masked\" id=\"envVal\">••••••••••••••••••••••••</span>\n      <button class=\"toggle-eye-btn\" id=\"eyeBtn\" aria-label=\"Mostrar secreto\">👁</button>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/env-variables-secret-toggle/index.html","archivePath":"env-variables-secret-toggle/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/env-variables-secret-toggle/LICENSE","archivePath":"env-variables-secret-toggle/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/env-variables-secret-toggle/script.js","archivePath":"env-variables-secret-toggle/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/env-variables-secret-toggle/styles.css","archivePath":"env-variables-secret-toggle/styles.css"}]}
