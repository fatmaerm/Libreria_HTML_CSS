{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>CPU Core Load Matrix</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"cpu-monitor\">\n    <div class=\"monitor-header\">\n      <span class=\"cpu-name\">RYZEN 9 // 8 CORES</span>\n      <span class=\"freq-tag\">4.85 GHz</span>\n    </div>\n    <div class=\"core-grid\" id=\"coreGrid\">\n      <div class=\"core-bar\"><div class=\"fill\" style=\"height:45%\"></div><span>C1</span></div>\n      <div class=\"core-bar\"><div class=\"fill\" style=\"height:78%\"></div><span>C2</span></div>\n      <div class=\"core-bar\"><div class=\"fill\" style=\"height:32%\"></div><span>C3</span></div>\n      <div class=\"core-bar\"><div class=\"fill\" style=\"height:92%\"></div><span>C4</span></div>\n      <div class=\"core-bar\"><div class=\"fill\" style=\"height:60%\"></div><span>C5</span></div>\n      <div class=\"core-bar\"><div class=\"fill\" style=\"height:25%\"></div><span>C6</span></div>\n      <div class=\"core-bar\"><div class=\"fill\" style=\"height:84%\"></div><span>C7</span></div>\n      <div class=\"core-bar\"><div class=\"fill\" style=\"height:55%\"></div><span>C8</span></div>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/cpu-core-load-matrix/index.html","archivePath":"cpu-core-load-matrix/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/cpu-core-load-matrix/LICENSE","archivePath":"cpu-core-load-matrix/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/cpu-core-load-matrix/script.js","archivePath":"cpu-core-load-matrix/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/cpu-core-load-matrix/styles.css","archivePath":"cpu-core-load-matrix/styles.css"}]}
