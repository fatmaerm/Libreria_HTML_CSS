{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Dot Step Pagination</title>\n<meta name=\"description\" content=\"Animated dot stepper pagination with progress fill.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"stepper\">\n  <div class=\"steps\" id=\"steps\">\n    <div class=\"step\" data-n=\"1\"><div class=\"dot\"></div><span>Start</span></div><div class=\"step\" data-n=\"2\"><div class=\"dot\"></div><span>Details</span></div><div class=\"step\" data-n=\"3\"><div class=\"dot\"></div><span>Review</span></div><div class=\"step\" data-n=\"4\"><div class=\"dot\"></div><span>Payment</span></div><div class=\"step\" data-n=\"5\"><div class=\"dot\"></div><span>Done</span></div>\n    <div class=\"progress-line\"><div class=\"progress-fill\" id=\"pf\"></div></div>\n  </div>\n  <div class=\"step-nav\">\n    <button id=\"prev\" disabled>← Back</button>\n    <button id=\"next\">Next →</button>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/dot-step-pagination/index.html","archivePath":"dot-step-pagination/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/dot-step-pagination/LICENSE","archivePath":"dot-step-pagination/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/dot-step-pagination/script.js","archivePath":"dot-step-pagination/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/dot-step-pagination/styles.css","archivePath":"dot-step-pagination/styles.css"}]}
