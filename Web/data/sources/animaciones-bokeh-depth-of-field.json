{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Bokeh Depth Of Field</title>\n<meta name=\"description\" content=\"Night city lights float through eight depth planes as out-of-focus bokeh discs, and moving the pointer racks the focus plane to blur or sharpen each layer.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"stage\">\n  <header class=\"mast\">\n    <span class=\"kicker\">Night Study 04</span>\n    <h1>Bokeh Depth Of Field</h1>\n    <p class=\"lede\">Eight depth planes of city lights drift with parallax, each carrying a soft and a defocused copy, so sliding the focus plane cross-fades every disc from tack sharp to fully bloomed.</p>\n  </header>\n\n  <section class=\"view\" id=\"view\">\n    <div class=\"sky\" aria-hidden=\"true\">\n      <span class=\"cityglow a\"></span>\n      <span class=\"cityglow b\"></span>\n      <span class=\"cityglow c\"></span>\n      <span class=\"haze h1\"></span>\n      <span class=\"haze h2\"></span>\n    </div>\n\n    <div class=\"skyline\" id=\"skyline\" aria-hidden=\"true\">\n      <span class=\"bld b1\"></span>\n      <span class=\"bld b2\"></span>\n      <span class=\"bld b3\"></span>\n      <span class=\"bld b4\"></span>\n      <span class=\"bld b5\"></span>\n      <span class=\"bld b6\"></span>\n      <span class=\"ant a1\"></span>\n      <span class=\"ant a2\"></span>\n      <span class=\"beacon\"></span>\n      <span class=\"street\"></span>\n    </div>\n\n    <div class=\"city\" id=\"city\" aria-hidden=\"true\"></div>\n\n    <div class=\"veil\" aria-hidden=\"true\"></div>\n    <div class=\"vf\" aria-hidden=\"true\">\n      <span class=\"br tl\"></span><span class=\"br tr\"></span>\n      <span class=\"br bl\"></span><span class=\"br br2\"></span>\n    </div>\n    <div class=\"topline\" aria-hidden=\"true\"><span>Night Plate</span><span id=\"tstop\">T1.2</span><span>1/8 s</span><span>ISO 1600</span></div>\n    <div class=\"rail\" aria-hidden=\"true\">\n      <span class=\"railbar\"></span>\n      <span class=\"railticks\"></span>\n      <span class=\"railmark\" id=\"railmark\"></span>\n      <span class=\"raillabel\">Focus Plane</span>\n    </div>\n    <div class=\"vignette\" aria-hidden=\"true\"></div>\n    <div class=\"grain\" aria-hidden=\"true\"></div>\n  </section>\n\n  <div class=\"hud\">\n    <div class=\"stat\"><span class=\"k\">Focus Plane</span><span class=\"v\" id=\"zval\">0.50</span></div>\n    <div class=\"stat\"><span class=\"k\">Subject</span><span class=\"v\" id=\"dist\">1.20 m</span></div>\n    <div class=\"stat\"><span class=\"k\">Aperture</span><span class=\"v\" id=\"ap\">T1.2</span></div>\n    <div class=\"stat\"><span class=\"k\">Bokeh Discs</span><span class=\"v\" id=\"count\">0</span></div>\n    <div class=\"meter\"><span id=\"bar\"></span></div>\n  </div>\n\n  <p class=\"hint\">Move the pointer left and right to rack the focus plane across the scene</p>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/bokeh-depth-of-field/index.html","archivePath":"animaciones-bokeh-depth-of-field/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/bokeh-depth-of-field/script.js","archivePath":"animaciones-bokeh-depth-of-field/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/bokeh-depth-of-field/styles.css","archivePath":"animaciones-bokeh-depth-of-field/styles.css"}]}
