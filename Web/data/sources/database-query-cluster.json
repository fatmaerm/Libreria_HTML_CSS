{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Database Query Cluster</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"db-scene\">\n    <div class=\"db-stack\">\n      <div class=\"db-layer layer-1\">\n        <div class=\"db-top\"></div>\n        <div class=\"pulse-beam beam-1\"></div>\n      </div>\n      <div class=\"db-layer layer-2\">\n        <div class=\"db-top\"></div>\n        <div class=\"pulse-beam beam-2\"></div>\n      </div>\n      <div class=\"db-layer layer-3\">\n        <div class=\"db-top\"></div>\n        <div class=\"pulse-beam beam-3\"></div>\n      </div>\n    </div>\n    <div class=\"db-status\">\n      <span class=\"status-name\">POSTGRES // READ CLUSTER</span>\n      <span class=\"status-qps\">1,420 QPS</span>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/database-query-cluster/index.html","archivePath":"database-query-cluster/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/database-query-cluster/LICENSE","archivePath":"database-query-cluster/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/database-query-cluster/styles.css","archivePath":"database-query-cluster/styles.css"}]}
