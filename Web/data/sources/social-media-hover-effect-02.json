{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Social Media Hover Effect 02</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css\" integrity=\"sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\" />\r\n</head>\r\n<body>\r\n    <div class=\"social-buttons\">\r\n        <a href=\"#\" class=\"social-button social-button--facebook\" aria-label=\"Facebook\">\r\n          <i class=\"fab fa-facebook-f\"></i>\r\n        </a>\r\n        <a href=\"#\" class=\"social-button social-button--linkedin\" aria-label=\"LinkedIn\">\r\n          <i class=\"fab fa-linkedin-in\"></i>\r\n        </a>\r\n        <a href=\"#\" class=\"social-button social-button--snapchat\" aria-label=\"Snapchat\">\r\n          <i class=\"fab fa-snapchat-ghost\"></i>\r\n        </a>\r\n        <a href=\"#\" class=\"social-button social-button--github\" aria-label=\"GitHub\">\r\n          <i class=\"fab fa-github\"></i>\r\n        </a>\r\n        <a href=\"#\" class=\"social-button social-button--codepen\" aria-label=\"CodePen\">\r\n          <i class=\"fab fa-codepen\"></i>\r\n        </a>\r\n      </div>      \r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/social-media-hover-effect-02/index.html","archivePath":"social-media-hover-effect-02/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/social-media-hover-effect-02/style.css","archivePath":"social-media-hover-effect-02/style.css"}]}
