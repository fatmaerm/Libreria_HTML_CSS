{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Lens Flare Anamorphic</title>\n<meta name=\"description\" content=\"A pulsing light source drives a full cinema flare stack with a blue anamorphic streak, polygonal aperture ghosts on the optical axis and drifting iris rings.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"stage\">\n  <header class=\"mast\">\n    <span class=\"kicker\">Optics Bench 02</span>\n    <h1>Lens Flare Anamorphic</h1>\n    <p class=\"lede\">A single pulsing source feeds the whole stack: a bloomed core, a horizontal blue anamorphic streak, eleven polygonal ghosts mirrored along the optical axis, and slow iris rings.</p>\n  </header>\n\n  <section class=\"cine\" id=\"cine\">\n    <div class=\"backdrop\" aria-hidden=\"true\">\n      <span class=\"haze h1\"></span>\n      <span class=\"haze h2\"></span>\n      <span class=\"haze h3\"></span>\n      <span class=\"haze h4\"></span>\n      <span class=\"horizon\"></span>\n      <span class=\"band b1\"></span>\n      <span class=\"band b2\"></span>\n    </div>\n\n    <div class=\"element\" aria-hidden=\"true\">\n      <span class=\"coating\"></span>\n      <span class=\"coating2\"></span>\n    </div>\n\n    <div class=\"flarefield\">\n      <div class=\"optical\">\n        <div class=\"halo\" aria-hidden=\"true\"></div>\n\n        <div class=\"rings\" aria-hidden=\"true\">\n          <span class=\"ring r1\"></span>\n          <span class=\"ring r2\"></span>\n          <span class=\"ring r3\"></span>\n          <span class=\"irisring\"></span>\n        </div>\n\n        <div class=\"anamorphic\" aria-hidden=\"true\">\n          <span class=\"str haze\"></span>\n          <span class=\"str wide\"></span>\n          <span class=\"str mid\"></span>\n          <span class=\"str core\"></span>\n          <span class=\"str spike\"></span>\n        </div>\n\n        <div class=\"stack\" aria-hidden=\"true\">\n          <span class=\"slot sA\"><i class=\"ghost gA\"></i></span>\n          <span class=\"slot sB\"><i class=\"ghost gB\"></i></span>\n          <span class=\"slot sC\"><i class=\"ghost gC\"></i></span>\n          <span class=\"slot sD\"><i class=\"ghost gD\"></i></span>\n          <span class=\"slot sE\"><i class=\"ghost gE\"></i></span>\n          <span class=\"slot sF\"><i class=\"ghost gF\"></i></span>\n          <span class=\"slot sG\"><i class=\"ghost gG\"></i></span>\n          <span class=\"slot sH\"><i class=\"ghost gH\"></i></span>\n          <span class=\"slot sI\"><i class=\"ghost gI\"></i></span>\n          <span class=\"slot sJ\"><i class=\"ghost gJ\"></i></span>\n          <span class=\"slot sK\"><i class=\"ghost gK\"></i></span>\n        </div>\n\n        <div class=\"source\" aria-hidden=\"true\">\n          <span class=\"srcGlow\"></span>\n          <span class=\"srcSpikeH\"></span>\n          <span class=\"srcSpikeV\"></span>\n          <span class=\"srcHot\"></span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"reticle\" aria-hidden=\"true\">\n      <span class=\"tick tk1\"></span><span class=\"tick tk2\"></span>\n      <span class=\"tick tk3\"></span><span class=\"tick tk4\"></span>\n      <span class=\"axisline\"></span>\n    </div>\n    <div class=\"vignette\" aria-hidden=\"true\"></div>\n    <div class=\"grain\" aria-hidden=\"true\"></div>\n    <div class=\"bar top\" aria-hidden=\"true\"></div>\n    <div class=\"bar bottom\" aria-hidden=\"true\"></div>\n    <div class=\"mark tl\" aria-hidden=\"true\"></div>\n    <div class=\"mark tr\" aria-hidden=\"true\"></div>\n    <div class=\"mark bl\" aria-hidden=\"true\"></div>\n    <div class=\"mark br\" aria-hidden=\"true\"></div>\n  </section>\n\n  <div class=\"hud\">\n    <div class=\"stat\"><span class=\"k\">Source Output</span><span class=\"v\" id=\"out\">50%</span></div>\n    <div class=\"stat\"><span class=\"k\">Ghost Chain</span><span class=\"v\" id=\"ghosts\">11</span></div>\n    <div class=\"stat\"><span class=\"k\">Anamorphic</span><span class=\"v\" id=\"ana\">2.00x</span></div>\n    <div class=\"stat\"><span class=\"k\">Bloom</span><span class=\"v\" id=\"bloom\">1.0</span></div>\n    <div class=\"meter\"><span id=\"bar\"></span></div>\n  </div>\n\n  <p class=\"hint\">Move the pointer to steer the light source through the ghost chain</p>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/lens-flare-anamorphic/index.html","archivePath":"animaciones-lens-flare-anamorphic/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/lens-flare-anamorphic/script.js","archivePath":"animaciones-lens-flare-anamorphic/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/lens-flare-anamorphic/styles.css","archivePath":"animaciones-lens-flare-anamorphic/styles.css"}]}
