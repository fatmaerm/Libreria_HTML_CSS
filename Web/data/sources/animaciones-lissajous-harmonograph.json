{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Lissajous Harmonograph</title>\n<meta name=\"description\" content=\"Two damped pendulums of drifting phase superpose their motion to ink Lissajous figures that reveal themselves through an animated stroke dash.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"scene\">\n  <div class=\"mesh\" aria-hidden=\"true\"></div>\n  <div class=\"halo halo-a\" aria-hidden=\"true\"></div>\n  <div class=\"halo halo-b\" aria-hidden=\"true\"></div>\n\n  <header class=\"masthead\">\n    <p class=\"eyebrow\"><span class=\"pip\"></span>Dual pendulum plotter</p>\n    <h1>Lissajous Harmonograph</h1>\n    <p class=\"lede\">Two independent oscillators swing with their own periods, phase offsets and damping. The pen rides the superposition, and because the amplitudes bleed away the figure closes on itself instead of repeating forever.</p>\n  </header>\n\n  <section class=\"stage\">\n    <div class=\"plate\">\n      <canvas id=\"plot\"></canvas>\n      <div class=\"layer mesh-fine\" aria-hidden=\"true\"></div>\n      <div class=\"layer scan\" aria-hidden=\"true\"></div>\n      <div class=\"layer grain\" aria-hidden=\"true\"></div>\n      <div class=\"layer vignette\" aria-hidden=\"true\"></div>\n      <div class=\"tags\" aria-hidden=\"true\">\n        <span class=\"tag tag-a\">Arm X &middot; 1.00 Hz</span>\n        <span class=\"tag tag-b\">Arm Y &middot; 1.00 Hz</span>\n        <span class=\"tag tag-p\">Pen carriage</span>\n      </div>\n      <div class=\"carriage\" aria-hidden=\"true\"></div>\n    </div>\n\n    <div class=\"readout\">\n      <div class=\"stat\"><span class=\"sk\">Ratio</span><span class=\"sv\" id=\"sRatio\">0 : 0</span></div>\n      <div class=\"stat\"><span class=\"sk\">Phase drift</span><span class=\"sv\" id=\"sPhase\">0&deg;</span></div>\n      <div class=\"stat\"><span class=\"sk\">Damping</span><span class=\"sv\" id=\"sDamp\">0.00</span></div>\n      <div class=\"stat\"><span class=\"sk\">Ink laid</span><span class=\"sv\" id=\"sInk\">0%</span></div>\n      <div class=\"stat wide\"><span class=\"sk\">Figure</span><span class=\"sv\" id=\"sFig\">I / IV</span></div>\n    </div>\n  </section>\n\n  <footer class=\"footing\">\n    <ul class=\"legend\">\n      <li><span class=\"swatch sw-x\"></span>Horizontal arm</li>\n      <li><span class=\"swatch sw-y\"></span>Vertical arm</li>\n      <li><span class=\"swatch sw-p\"></span>Superposed trace</li>\n    </ul>\n    <p class=\"note\">Each figure is etched over fifteen seconds, held, then allowed to fade while the next ratio is wound in.</p>\n  </footer>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/lissajous-harmonograph/index.html","archivePath":"animaciones-lissajous-harmonograph/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/lissajous-harmonograph/script.js","archivePath":"animaciones-lissajous-harmonograph/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/lissajous-harmonograph/styles.css","archivePath":"animaciones-lissajous-harmonograph/styles.css"}]}
