{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Firefly Swarm Meadow</title>\n<meta name=\"description\" content=\"A canvas firefly swarm wandering a dark meadow of layered grass silhouettes with soft glow sprites, blinking phases and out-of-focus foreground bokeh.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"meadow\">\n  <div class=\"sky\"></div>\n  <div class=\"stars stars--far\"></div>\n  <div class=\"stars stars--mid\"></div>\n  <div class=\"moon\"></div>\n  <div class=\"treeline treeline--far\"></div>\n  <div class=\"treeline treeline--near\"></div>\n  <div class=\"mist\"></div>\n  <canvas class=\"swarm\" id=\"swarm\"></canvas>\n  <div class=\"grass grass--far\"></div>\n  <div class=\"grass grass--mid\"></div>\n  <canvas class=\"swarm swarm--front\" id=\"swarm-front\"></canvas>\n  <div class=\"grass grass--near\"></div>\n  <div class=\"fore fore--a\"></div>\n  <div class=\"fore fore--b\"></div>\n  <div class=\"vignette\"></div>\n  <div class=\"grain\"></div>\n  <p class=\"caption\">Firefly Swarm Meadow</p>\n</div>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/firefly-swarm-meadow/index.html","archivePath":"animaciones-firefly-swarm-meadow/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/firefly-swarm-meadow/script.js","archivePath":"animaciones-firefly-swarm-meadow/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/firefly-swarm-meadow/styles.css","archivePath":"animaciones-firefly-swarm-meadow/styles.css"}]}
