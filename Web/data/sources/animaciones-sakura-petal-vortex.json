{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Sakura Petal Vortex</title>\n<meta name=\"description\" content=\"Cherry blossom petals tumble in three dimensions across a blurred grove, drifting from hazy far depths to large motion-streaked near petals, and gather into a swirling vortex around the pointer.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"sakura\" id=\"scene\">\n  <div class=\"sakura__sky\" aria-hidden=\"true\"></div>\n  <div class=\"sakura__sun\" aria-hidden=\"true\"></div>\n  <div class=\"sakura__trunks\" aria-hidden=\"true\"></div>\n  <div class=\"sakura__canopy\" aria-hidden=\"true\"></div>\n  <div class=\"sakura__bokeh sakura__bokeh--a\" aria-hidden=\"true\"></div>\n  <div class=\"sakura__bokeh sakura__bokeh--b\" aria-hidden=\"true\"></div>\n  <div class=\"sakura__bokeh sakura__bokeh--c\" aria-hidden=\"true\"></div>\n  <div class=\"sakura__ring\" aria-hidden=\"true\"><i></i><i></i></div>\n  <div class=\"sakura__field\" id=\"field\" aria-hidden=\"true\"></div>\n  <div class=\"sakura__floor\" aria-hidden=\"true\"></div>\n  <div class=\"sakura__vignette\" aria-hidden=\"true\"></div>\n  <div class=\"sakura__grain\" aria-hidden=\"true\"></div>\n  <div class=\"plate\">\n    <p class=\"plate__eyebrow\">Hanami Drift</p>\n    <h1 class=\"plate__title\">Sakura Petal Vortex</h1>\n    <p class=\"plate__rule\"></p>\n    <p class=\"plate__meta\">Depth-graded petals &middot; bokeh grove &middot; pointer vortex</p>\n  </div>\n</div>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/sakura-petal-vortex/index.html","archivePath":"animaciones-sakura-petal-vortex/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/sakura-petal-vortex/script.js","archivePath":"animaciones-sakura-petal-vortex/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/sakura-petal-vortex/styles.css","archivePath":"animaciones-sakura-petal-vortex/styles.css"}]}
