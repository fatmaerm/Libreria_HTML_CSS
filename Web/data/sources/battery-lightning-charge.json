{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Battery Lightning Charge</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"battery-scene\">\n    <div class=\"battery-terminal\"></div>\n    <div class=\"battery-casing\">\n      <div class=\"liquid-charge\">\n        <div class=\"bubbles\">\n          <span></span><span></span><span></span><span></span>\n        </div>\n      </div>\n      <div class=\"lightning-icon\">\n        <svg viewBox=\"0 0 24 24\" width=\"40\" height=\"40\" fill=\"#ffffff\">\n          <path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/>\n        </svg>\n      </div>\n    </div>\n    <div class=\"battery-stats\">\n      <span class=\"stat-pct\">98% CARGANDO</span>\n      <span class=\"stat-volt\">4.2V // SUPERCARGA</span>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/battery-lightning-charge/index.html","archivePath":"battery-lightning-charge/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/battery-lightning-charge/LICENSE","archivePath":"battery-lightning-charge/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/battery-lightning-charge/styles.css","archivePath":"battery-lightning-charge/styles.css"}]}
