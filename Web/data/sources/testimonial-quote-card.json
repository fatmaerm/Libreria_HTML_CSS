{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Testimonial Quote Card</title>\n<meta name=\"description\" content=\"Elegant animated testimonial quote card with rotating author switcher.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"quote-card\">\n  <div class=\"quotemark\">\"</div>\n  <p class=\"quote-text\" id=\"quoteText\"></p>\n  <div class=\"author\">\n    <div class=\"avatar\" id=\"authorAvatar\"></div>\n    <div>\n      <strong id=\"authorName\"></strong>\n      <span id=\"authorRole\"></span>\n    </div>\n  </div>\n  <div class=\"dots\" id=\"dots\"></div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/testimonial-quote-card/index.html","archivePath":"testimonial-quote-card/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/testimonial-quote-card/LICENSE","archivePath":"testimonial-quote-card/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/testimonial-quote-card/script.js","archivePath":"testimonial-quote-card/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/testimonial-quote-card/styles.css","archivePath":"testimonial-quote-card/styles.css"}]}
