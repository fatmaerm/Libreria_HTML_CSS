{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Markdown Preview Live</title>\n<meta name=\"description\" content=\"Split-pane live Markdown editor and preview panel.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"md-wrap\">\n  <div class=\"md-pane editor-pane\">\n    <div class=\"pane-header\"><span>📝 Markdown</span></div>\n    <textarea id=\"mdInput\" spellcheck=\"false\"># Hello World\n\n## Features\n- **Bold text**\n- *Italic text*\n- `inline code`\n\n> A blockquote here\n\n```\nconst x = 42;\n```</textarea>\n  </div>\n  <div class=\"md-pane preview-pane\">\n    <div class=\"pane-header\"><span>👁️ Preview</span></div>\n    <div class=\"md-preview\" id=\"mdPreview\"></div>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/markdown-preview-live/index.html","archivePath":"markdown-preview-live/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/markdown-preview-live/LICENSE","archivePath":"markdown-preview-live/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/markdown-preview-live/script.js","archivePath":"markdown-preview-live/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/markdown-preview-live/styles.css","archivePath":"markdown-preview-live/styles.css"}]}
