{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Sierpinski Fractal Growth</title>\n<meta name=\"description\" content=\"A Sierpinski triangle assembles itself one recursive generation at a time, glowing edges fading into the depths before the whole structure collapses back to a single cell.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"scene\">\n  <div class=\"mesh\" aria-hidden=\"true\"></div>\n  <div class=\"halo halo-a\" aria-hidden=\"true\"></div>\n  <div class=\"halo halo-b\" aria-hidden=\"true\"></div>\n\n  <header class=\"masthead\">\n    <p class=\"eyebrow\"><span class=\"pip\"></span>Recursive subdivision</p>\n    <h1>Sierpinski Fractal Growth</h1>\n    <p class=\"lede\">Every cell splits into three half scale copies while its parent dims. Each generation arrives with a hotter edge and settles a shade deeper, so the finished gasket reads as a solid rather than a wireframe.</p>\n  </header>\n\n  <section class=\"stage\">\n    <div class=\"plate\">\n      <canvas id=\"plot\"></canvas>\n      <div class=\"layer mesh-fine\" aria-hidden=\"true\"></div>\n      <div class=\"layer scan\" aria-hidden=\"true\"></div>\n      <div class=\"layer grain\" aria-hidden=\"true\"></div>\n      <div class=\"layer vignette\" aria-hidden=\"true\"></div>\n      <div class=\"tags\" aria-hidden=\"true\">\n        <span class=\"tag tag-t\">Recursive gasket</span>\n        <span class=\"tag tag-b\" id=\"sGen\">Generation 0 / 5</span>\n      </div>\n    </div>\n\n    <div class=\"readout\">\n      <div class=\"stat\"><span class=\"sk\">Generation</span><span class=\"sv\" id=\"sGenN\">0</span></div>\n      <div class=\"stat\"><span class=\"sk\">Cells drawn</span><span class=\"sv\" id=\"sCells\">1</span></div>\n      <div class=\"stat\"><span class=\"sk\">In flight</span><span class=\"sv\" id=\"sLive\">0</span></div>\n      <div class=\"stat\"><span class=\"sk\">Integrity</span><span class=\"sv\" id=\"sInt\">100%</span></div>\n      <div class=\"stat wide\"><span class=\"sk\">Phase</span><span class=\"sv\" id=\"sPhase\">Divergence</span></div>\n    </div>\n  </section>\n\n  <footer class=\"footing\">\n    <ul class=\"legend\">\n      <li><span class=\"swatch sw-a\"></span>Fresh cell</li>\n      <li><span class=\"swatch sw-b\"></span>Intermediate</li>\n      <li><span class=\"swatch sw-c\"></span>Settled lattice</li>\n    </ul>\n    <p class=\"note\">The build is mirrored in reverse, so the loop closes on the same empty frame it started from.</p>\n  </footer>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/sierpinski-fractal-growth/index.html","archivePath":"animaciones-sierpinski-fractal-growth/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/sierpinski-fractal-growth/script.js","archivePath":"animaciones-sierpinski-fractal-growth/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/sierpinski-fractal-growth/styles.css","archivePath":"animaciones-sierpinski-fractal-growth/styles.css"}]}
