{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>CI/CD Pipeline Flow</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"pipeline-card\">\n    <div class=\"pipe-header\">\n      <span class=\"pipe-branch\">main // #3842</span>\n      <span class=\"pipe-status\">COMPLETADO CON ÉXITO</span>\n    </div>\n    <div class=\"pipe-track\">\n      <div class=\"pipe-step done\">\n        <div class=\"step-circle\">✓</div>\n        <span class=\"step-label\">Lint</span>\n      </div>\n      <div class=\"step-connector active-bar\"></div>\n      <div class=\"pipe-step done\">\n        <div class=\"step-circle\">✓</div>\n        <span class=\"step-label\">Test</span>\n      </div>\n      <div class=\"step-connector active-bar\"></div>\n      <div class=\"pipe-step done\">\n        <div class=\"step-circle\">✓</div>\n        <span class=\"step-label\">Build</span>\n      </div>\n      <div class=\"step-connector active-bar\"></div>\n      <div class=\"pipe-step done\">\n        <div class=\"step-circle\">✓</div>\n        <span class=\"step-label\">Deploy</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/ci-cd-pipeline-flow/index.html","archivePath":"ci-cd-pipeline-flow/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/ci-cd-pipeline-flow/LICENSE","archivePath":"ci-cd-pipeline-flow/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/ci-cd-pipeline-flow/styles.css","archivePath":"ci-cd-pipeline-flow/styles.css"}]}
