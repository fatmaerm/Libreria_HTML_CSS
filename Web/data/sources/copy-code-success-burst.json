{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Copy Code Success Burst</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"code-wrapper\">\n    <div class=\"code-topbar\">\n      <span class=\"file-name\">install.sh</span>\n      <button class=\"copy-btn\" id=\"copyBtn\" aria-label=\"Copiar código\">\n        <span class=\"btn-text\">Copiar</span>\n        <svg class=\"icon-copy\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n          <rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect>\n          <path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>\n        </svg>\n      </button>\n    </div>\n    <div class=\"code-body\">\n      <code>npm install @quantum/core --save-prod</code>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/copy-code-success-burst/index.html","archivePath":"copy-code-success-burst/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/copy-code-success-burst/LICENSE","archivePath":"copy-code-success-burst/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/copy-code-success-burst/script.js","archivePath":"copy-code-success-burst/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/copy-code-success-burst/styles.css","archivePath":"copy-code-success-burst/styles.css"}]}
