{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Cyber Shield Passcode Keypad</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"keypad-card\">\n    <div class=\"code-dots\" id=\"dotsRow\">\n      <span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span>\n    </div>\n    <div class=\"keys-grid\">\n      <button class=\"key\">1</button><button class=\"key\">2</button><button class=\"key\">3</button>\n      <button class=\"key\">4</button><button class=\"key\">5</button><button class=\"key\">6</button>\n      <button class=\"key\">7</button><button class=\"key\">8</button><button class=\"key\">9</button>\n      <button class=\"key clear\" id=\"clearBtn\">C</button><button class=\"key\">0</button><button class=\"key enter\" id=\"enterBtn\">↵</button>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/cyber-shield-passcode-keypad/index.html","archivePath":"cyber-shield-passcode-keypad/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/cyber-shield-passcode-keypad/LICENSE","archivePath":"cyber-shield-passcode-keypad/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/cyber-shield-passcode-keypad/script.js","archivePath":"cyber-shield-passcode-keypad/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/cyber-shield-passcode-keypad/styles.css","archivePath":"cyber-shield-passcode-keypad/styles.css"}]}
