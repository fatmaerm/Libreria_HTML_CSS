{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Star Rating Button</title>\n<meta name=\"description\" content=\"Interactive animated star rating button component.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"rating\" id=\"rating\" aria-label=\"Star rating\">\n  <button class=\"star\" data-v=\"1\" aria-label=\"1 star\">★</button><button class=\"star\" data-v=\"2\" aria-label=\"2 star\">★</button><button class=\"star\" data-v=\"3\" aria-label=\"3 star\">★</button><button class=\"star\" data-v=\"4\" aria-label=\"4 star\">★</button><button class=\"star\" data-v=\"5\" aria-label=\"5 star\">★</button>\n</div>\n<p class=\"hint\" id=\"hint\">Select a rating</p>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/star-rating-button/index.html","archivePath":"star-rating-button/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/star-rating-button/LICENSE","archivePath":"star-rating-button/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/star-rating-button/script.js","archivePath":"star-rating-button/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/star-rating-button/styles.css","archivePath":"star-rating-button/styles.css"}]}
