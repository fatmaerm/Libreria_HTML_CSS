{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Countdown Submit Button</title>\n<meta name=\"description\" content=\"Submit button with animated countdown progress arc before submission.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<button class=\"cd-btn\" id=\"cdBtn\">\n  <svg class=\"cd-ring\" viewBox=\"0 0 48 48\">\n    <circle class=\"track\" cx=\"24\" cy=\"24\" r=\"20\"/>\n    <circle class=\"arc\" cx=\"24\" cy=\"24\" r=\"20\" id=\"arc\"/>\n  </svg>\n  <span id=\"cdLabel\">Hold to Submit</span>\n</button>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/countdown-submit-button/index.html","archivePath":"countdown-submit-button/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/countdown-submit-button/LICENSE","archivePath":"countdown-submit-button/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/countdown-submit-button/script.js","archivePath":"countdown-submit-button/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/countdown-submit-button/styles.css","archivePath":"countdown-submit-button/styles.css"}]}
