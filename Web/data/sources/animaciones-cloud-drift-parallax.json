{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Cloud Drift Parallax</title>\n<meta name=\"description\" content=\"Four parallax cloud decks built from layered radial gradients drifting across a warm dusk sky with a low sun bloom.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"sky\">\n  <div class=\"sun\"></div>\n  <div class=\"band band--cirrus\"></div>\n  <div class=\"band band--high\"></div>\n  <div class=\"band band--mid\"></div>\n  <div class=\"band band--low\"></div>\n  <div class=\"haze\"></div>\n  <div class=\"vignette\"></div>\n  <div class=\"grain\"></div>\n  <p class=\"caption\">Cloud Drift Parallax</p>\n</div>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/cloud-drift-parallax/index.html","archivePath":"animaciones-cloud-drift-parallax/index.html"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/cloud-drift-parallax/styles.css","archivePath":"animaciones-cloud-drift-parallax/styles.css"}]}
