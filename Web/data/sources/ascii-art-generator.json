{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>ASCII Art Generator</title>\n<meta name=\"description\" content=\"Simple ASCII art banner generator from text input.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"ascii-wrap\">\n  <h2>ASCII Banner</h2>\n  <div class=\"ascii-input-row\">\n    <input id=\"aInput\" type=\"text\" value=\"HELLO\" maxlength=\"8\" placeholder=\"Type here…\">\n    <button id=\"aGen\">Generate</button>\n  </div>\n  <pre id=\"aOutput\" class=\"ascii-out\"></pre>\n  <button id=\"aCopy\" class=\"copy-btn\">Copy</button>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/ascii-art-generator/index.html","archivePath":"ascii-art-generator/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/ascii-art-generator/LICENSE","archivePath":"ascii-art-generator/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/ascii-art-generator/script.js","archivePath":"ascii-art-generator/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/ascii-art-generator/styles.css","archivePath":"ascii-art-generator/styles.css"}]}
