{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Paper Origami Fold Card</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"card-scene\">\n    <div class=\"origami-card\">\n      <div class=\"card-base\">\n        <h3>ACCESO CONCEDIDO</h3>\n        <p>Cumbre de Diseño 2026</p>\n        <span class=\"card-code\">PASS #8849</span>\n      </div>\n      \n      <div class=\"flap flap-left\">\n        <div class=\"flap-face front\"></div>\n        <div class=\"flap-face back\"></div>\n      </div>\n      <div class=\"flap flap-right\">\n        <div class=\"flap-face front\"></div>\n        <div class=\"flap-face back\"></div>\n      </div>\n    </div>\n    <div class=\"hover-hint\">Pasa el cursor para desplegar</div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/paper-origami-fold-card/index.html","archivePath":"paper-origami-fold-card/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/paper-origami-fold-card/LICENSE","archivePath":"paper-origami-fold-card/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/paper-origami-fold-card/styles.css","archivePath":"paper-origami-fold-card/styles.css"}]}
