{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Circular Progress Loader</title>\n<meta name=\"description\" content=\"SVG circular progress spinner with gradient stroke.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"wrap\">\n  <svg class=\"ring\" viewBox=\"0 0 100 100\">\n    <circle class=\"track\" cx=\"50\" cy=\"50\" r=\"42\"/>\n    <circle class=\"progress\" cx=\"50\" cy=\"50\" r=\"42\"/>\n  </svg>\n  <span class=\"label\">Loading…</span>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/circular-progress-loader/index.html","archivePath":"circular-progress-loader/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/circular-progress-loader/LICENSE","archivePath":"circular-progress-loader/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/circular-progress-loader/styles.css","archivePath":"circular-progress-loader/styles.css"}]}
