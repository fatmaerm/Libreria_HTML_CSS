{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Truchet Tile Morph</title>\n<meta name=\"description\" content=\"A grid of Truchet tiles whose glowing quarter circle arcs rotate ninety degrees and re-connect into a new continuous labyrinth.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"scene\">\n  <div class=\"field\"></div>\n  <div class=\"nebula nebula-a\"></div>\n  <div class=\"nebula nebula-b\"></div>\n  <div class=\"grid\"></div>\n\n  <div class=\"stage\">\n    <div class=\"board\">\n      <div class=\"corner corner-a\"></div>\n      <div class=\"corner corner-b\"></div>\n      <div class=\"corner corner-c\"></div>\n      <div class=\"corner corner-d\"></div>\n      <svg class=\"labyrinth\" id=\"lab\" role=\"group\" aria-label=\"Labyrinth of Truchet tiles, activate a tile to rotate its arcs\">\n        <defs>\n          <linearGradient id=\"g0\" gradientUnits=\"userSpaceOnUse\" x1=\"0\" y1=\"0\" x2=\"100\" y2=\"100\">\n            <stop offset=\"0\" stop-color=\"#22d3ee\"></stop>\n            <stop offset=\".52\" stop-color=\"#4f8cf7\"></stop>\n            <stop offset=\"1\" stop-color=\"#a970f2\"></stop>\n          </linearGradient>\n          <linearGradient id=\"g1\" gradientUnits=\"userSpaceOnUse\" x1=\"0\" y1=\"0\" x2=\"100\" y2=\"100\">\n            <stop offset=\"0\" stop-color=\"#38bdf8\"></stop>\n            <stop offset=\".52\" stop-color=\"#7c74f4\"></stop>\n            <stop offset=\"1\" stop-color=\"#e879b9\"></stop>\n          </linearGradient>\n          <linearGradient id=\"g2\" gradientUnits=\"userSpaceOnUse\" x1=\"0\" y1=\"0\" x2=\"100\" y2=\"100\">\n            <stop offset=\"0\" stop-color=\"#2dd4bf\"></stop>\n            <stop offset=\".52\" stop-color=\"#5f8ef0\"></stop>\n            <stop offset=\"1\" stop-color=\"#c084fc\"></stop>\n          </linearGradient>\n          <linearGradient id=\"g3\" gradientUnits=\"userSpaceOnUse\" x1=\"0\" y1=\"0\" x2=\"100\" y2=\"100\">\n            <stop offset=\"0\" stop-color=\"#67e8f9\"></stop>\n            <stop offset=\".52\" stop-color=\"#6d7cf6\"></stop>\n            <stop offset=\"1\" stop-color=\"#f472b6\"></stop>\n          </linearGradient>\n          <linearGradient id=\"g4\" gradientUnits=\"userSpaceOnUse\" x1=\"0\" y1=\"0\" x2=\"100\" y2=\"100\">\n            <stop offset=\"0\" stop-color=\"#22d3ee\"></stop>\n            <stop offset=\".52\" stop-color=\"#8b7bf7\"></stop>\n            <stop offset=\"1\" stop-color=\"#fbbf24\"></stop>\n          </linearGradient>\n        </defs>\n      </svg>\n    </div>\n  </div>\n\n  <svg class=\"grain\" viewBox=\"0 0 800 500\" preserveAspectRatio=\"none\" aria-hidden=\"true\" focusable=\"false\">\n    <defs>\n      <filter id=\"trGrain\">\n        <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.85\" numOctaves=\"2\" stitchTiles=\"stitch\"></feTurbulence>\n        <feColorMatrix type=\"saturate\" values=\"0\"></feColorMatrix>\n      </filter>\n    </defs>\n    <rect width=\"800\" height=\"500\" filter=\"url(#trGrain)\"></rect>\n  </svg>\n\n  <div class=\"vignette\"></div>\n\n  <header class=\"hud\">\n    <p class=\"eyebrow\">Truchet / Tile Morph</p>\n    <p class=\"lede\">Two quarter arcs per tile. Turn ninety degrees and the labyrinth finds a new way through itself.</p>\n  </header>\n\n  <section class=\"panel\">\n    <div class=\"row\"><span class=\"k\">Tiles</span><span class=\"v\" id=\"tileOut\">0</span></div>\n    <div class=\"row\"><span class=\"k\">Links</span><span class=\"v\" id=\"linkOut\" aria-live=\"polite\">0</span></div>\n    <div class=\"row\"><span class=\"k\">Loops</span><span class=\"v\" id=\"loopOut\">0</span></div>\n    <div class=\"meter\"><i id=\"linkBar\"></i></div>\n    <div class=\"row\"><span class=\"k\">Turns</span><span class=\"v\" id=\"turnOut\">0</span></div>\n    <div class=\"actions\">\n      <button type=\"button\" class=\"btn is-on\" id=\"flowBtn\" aria-pressed=\"true\">Flow</button>\n      <button type=\"button\" class=\"btn\" id=\"shuffleBtn\">Shuffle</button>\n    </div>\n  </section>\n\n  <footer class=\"legend\">\n    <span class=\"hint\">Tap a tile to turn it</span>\n    <span class=\"readout\">arcs radius 70.71 / one-sided grid</span>\n  </footer>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/truchet-tile-morph/index.html","archivePath":"animaciones-truchet-tile-morph/index.html"}]}
