{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Receipt Ticket Card</title>\n<meta name=\"description\" content=\"Retro receipt-style info card with perforated edge decoration.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"receipt\">\n  <div class=\"receipt-top\">\n    <p class=\"shop\">COMPONENT STORE</p>\n    <h2>Order #2047</h2>\n    <p class=\"date\">2026-09-26 17:00</p>\n  </div>\n  <hr class=\"dashed\">\n  <ul class=\"items\">\n    <li><span>Neon Button ×1</span><span>$12.00</span></li>\n    <li><span>Glass Card ×2</span><span>$24.00</span></li>\n    <li><span>Dark Toggle ×1</span><span>$8.00</span></li>\n  </ul>\n  <hr class=\"dashed\">\n  <div class=\"total\"><span>TOTAL</span><span>$44.00</span></div>\n  <div class=\"perforation\"></div>\n  <p class=\"thanks\">Thank you! ★</p>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/receipt-ticket-card/index.html","archivePath":"receipt-ticket-card/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/receipt-ticket-card/LICENSE","archivePath":"receipt-ticket-card/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/receipt-ticket-card/styles.css","archivePath":"receipt-ticket-card/styles.css"}]}
