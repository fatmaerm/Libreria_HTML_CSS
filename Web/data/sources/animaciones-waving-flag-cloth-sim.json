{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Waving Flag Cloth Sim</title>\n<meta name=\"description\" content=\"A verlet-integrated cloth lattice pinned to a mast ripples under layered wind with a woven emblem.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"scene\">\n  <div class=\"sky\"></div>\n  <div class=\"sun\"></div>\n  <div=\"ridge ridge-far\"></div>\n  <div class=\"ridge ridge-near\"></div>\n  <div class=\"haze\"></div>\n  <div class=\"ground\"></div>\n  <canvas class=\"stage\" id=\"stage\" role=\"img\" aria-label=\"A crimson banner simulated as a springy cloth lattice, rippling in the wind on a steel mast\"></canvas>\n  <div class=\"grain\"></div>\n  <div class=\"vignette\"></div>\n  <div class=\"frame\"></div>\n\n  <header class=\"hud\">\n    <p class=\"kicker\">Simulation 01 &middot; Textile Dynamics</p>\n    <h1>Cloth&nbsp;In&nbsp;Motion</h1>\n    <p class=\"sub\">A twenty-two by fifteen verlet lattice, pinned to the hoist and pulled by three superimposed wind bands. Every link is solved six times per frame.</p>\n  </header>\n\n  <section class=\"readout\" aria-label=\"Simulation readout\">\n    <dl class=\"stats\">\n      <div class=\"stat\"><dt>Lattice</dt><dd id=\"rGrid\">&mdash;</dd></div>\n      <div class=\"stat\"><dt>Links</dt><dd id=\"rLinks\">&mdash;</dd></div>\n      <div class=\"stat\"><dt>Wind</dt><dd id=\"rWind\">&mdash;</dd></div>\n      <div class=\"stat\"><dt>State</dt><dd id=\"rState\">Running</dd></div>\n    </dl>\n    <div class=\"meter\" aria-hidden=\"true\"><span class=\"meter-fill\" id=\"rBar\"></span></div>\n    <div class=\"controls\">\n      <button class=\"btn\" type=\"button\" data-wind=\"0.45\">Calm</button>\n      <button class=\"btn is-on\" type=\"button\" data-wind=\"1\">Breeze</button>\n      <button class=\"btn\" type=\"button\" data-wind=\"2.1\">Gale</button>\n    </div>\n  </section>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/waving-flag-cloth-sim/index.html","archivePath":"animaciones-waving-flag-cloth-sim/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/waving-flag-cloth-sim/script.js","archivePath":"animaciones-waving-flag-cloth-sim/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/waving-flag-cloth-sim/styles.css","archivePath":"animaciones-waving-flag-cloth-sim/styles.css"}]}
