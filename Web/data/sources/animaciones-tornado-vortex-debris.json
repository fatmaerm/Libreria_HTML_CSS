{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Tornado Vortex Debris</title>\n<meta name=\"description\" content=\"A leaning storm funnel sweeps dust, grit and torn debris along spiralling paths while lightning flickers inside the column over a scarred plain.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"storm\">\n  <div class=\"storm__sky\" aria-hidden=\"true\"></div>\n  <div class=\"storm__shelf storm__shelf--a\" aria-hidden=\"true\"></div>\n  <div class=\"storm__shelf storm__shelf--b\" aria-hidden=\"true\"></div>\n  <div class=\"storm__shelf storm__shelf--c\" aria-hidden=\"true\"></div>\n  <div class=\"storm__rain storm__rain--back\" aria-hidden=\"true\"><i></i></div>\n  <div class=\"storm__ground\" aria-hidden=\"true\"></div>\n  <canvas class=\"storm__fx\" id=\"fx\" aria-hidden=\"true\"></canvas>\n  <div class=\"storm__flash\" id=\"flash\" aria-hidden=\"true\"></div>\n  <div class=\"storm__rain storm__rain--front\" aria-hidden=\"true\"><i></i></div>\n  <div class=\"storm__vignette\" aria-hidden=\"true\"></div>\n  <div class=\"storm__grain\" aria-hidden=\"true\"></div>\n  <div class=\"hud\" aria-hidden=\"true\">\n    <span class=\"hud__i\"><span class=\"hud__k\">Rating</span><span class=\"hud__v\" id=\"hud-ef\">EF3</span></span>\n    <span class=\"hud__i\"><span class=\"hud__k\">Peak</span><span class=\"hud__v\" id=\"hud-wind\">0 km/h</span></span>\n    <span class=\"hud__i\"><span class=\"hud__k\">Mesocyclone</span><span class=\"hud__v\" id=\"hud-meso\">0.00</span></span>\n    <span class=\"hud__i\"><span class=\"hud__k\">Debris</span><span class=\"hud__v\" id=\"hud-debris\">0</span></span>\n  </div>\n  <div class=\"plate\">\n    <p class=\"plate__eyebrow\">Supercell Tracking</p>\n    <h1 class=\"plate__title\">Tornado Vortex Debris</h1>\n    <p class=\"plate__rule\"></p>\n    <p class=\"plate__meta\">Funnel spiral &middot; depth-sorted debris &middot; inner lightning</p>\n  </div>\n</div>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/tornado-vortex-debris/index.html","archivePath":"animaciones-tornado-vortex-debris/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/tornado-vortex-debris/script.js","archivePath":"animaciones-tornado-vortex-debris/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/tornado-vortex-debris/styles.css","archivePath":"animaciones-tornado-vortex-debris/styles.css"}]}
