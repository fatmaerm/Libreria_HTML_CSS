{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Liquid Hourglass Timer</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"hourglass-wrap\">\n    <div class=\"cap top-cap\"></div>\n    <div class=\"glass-chamber\">\n      <div class=\"bulb top-bulb\">\n        <div class=\"liquid-top\"></div>\n      </div>\n      \n      <div class=\"neck\">\n        <div class=\"stream-line\"></div>\n        <div class=\"drip drip-1\"></div>\n        <div class=\"drip drip-2\"></div>\n      </div>\n      \n      <div class=\"bulb bottom-bulb\">\n        <div class=\"liquid-bottom\"></div>\n      </div>\n    </div>\n    <div class=\"cap bottom-cap\"></div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/liquid-hourglass-timer/index.html","archivePath":"liquid-hourglass-timer/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/liquid-hourglass-timer/LICENSE","archivePath":"liquid-hourglass-timer/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/liquid-hourglass-timer/styles.css","archivePath":"liquid-hourglass-timer/styles.css"}]}
