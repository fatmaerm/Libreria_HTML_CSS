{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>NPM Package Stat Card</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"npm-card\">\n    <div class=\"card-head\">\n      <div class=\"pkg-title\">\n        <span class=\"npm-logo\">npm</span>\n        <h3>@kindred/ui-motion</h3>\n      </div>\n      <span class=\"ver-badge\">v1.4.2</span>\n    </div>\n    <p class=\"pkg-desc\">Librería de microanimaciones y efectos UI modernos en CSS y JS vanilla.</p>\n    <div class=\"card-stats\">\n      <div class=\"stat\"><span class=\"val\">142K/mes</span><span class=\"lbl\">DESCARGAS</span></div>\n      <div class=\"stat\"><span class=\"val\">3.4 kB</span><span class=\"lbl\">MIN + GZIP</span></div>\n      <div class=\"stat\"><span class=\"val\">MIT</span><span class=\"lbl\">LICENCIA</span></div>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/npm-package-stat-card/index.html","archivePath":"npm-package-stat-card/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/npm-package-stat-card/LICENSE","archivePath":"npm-package-stat-card/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/npm-package-stat-card/styles.css","archivePath":"npm-package-stat-card/styles.css"}]}
