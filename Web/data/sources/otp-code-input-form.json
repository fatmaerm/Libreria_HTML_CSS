{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>OTP Code Input Form</title>\n<meta name=\"description\" content=\"Six-digit OTP verification code input with auto-advance and paste support.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"otp-wrap\">\n  <h2>Verification Code</h2>\n  <p>Enter the 6-digit code sent to your device.</p>\n  <div class=\"otp-inputs\" id=\"otpInputs\">\n    <input class=\"otp-cell\" maxlength=\"1\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]\" data-i=\"0\"><input class=\"otp-cell\" maxlength=\"1\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]\" data-i=\"1\"><input class=\"otp-cell\" maxlength=\"1\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]\" data-i=\"2\"><input class=\"otp-cell\" maxlength=\"1\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]\" data-i=\"3\"><input class=\"otp-cell\" maxlength=\"1\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]\" data-i=\"4\"><input class=\"otp-cell\" maxlength=\"1\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]\" data-i=\"5\">\n  </div>\n  <button class=\"otp-btn\" id=\"otpBtn\">Verify</button>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/otp-code-input-form/index.html","archivePath":"otp-code-input-form/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/otp-code-input-form/LICENSE","archivePath":"otp-code-input-form/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/otp-code-input-form/script.js","archivePath":"otp-code-input-form/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/otp-code-input-form/styles.css","archivePath":"otp-code-input-form/styles.css"}]}
