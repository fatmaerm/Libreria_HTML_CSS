{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Tesseract Hypercube 4D</title>\n<meta name=\"description\" content=\"A true four dimensional tesseract of sixteen vertices and thirty two edges rotating on two planes and projected through perspective.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"scene\">\n  <div class=\"field\"></div>\n  <div class=\"nebula nebula-a\"></div>\n  <div class=\"nebula nebula-b\"></div>\n  <div class=\"floor\"></div>\n  <canvas id=\"hyper\" aria-label=\"A rotating four dimensional tesseract rendered on canvas\"></canvas>\n  <svg class=\"grain\" viewBox=\"0 0 800 500\" preserveAspectRatio=\"none\" aria-hidden=\"true\" focusable=\"false\">\n    <defs>\n      <filter id=\"tessGrain\">\n        <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.88\" numOctaves=\"2\" stitchTiles=\"stitch\"></feTurbulence>\n        <feColorMatrix type=\"saturate\" values=\"0\"></feColorMatrix>\n      </filter>\n    </defs>\n    <rect width=\"800\" height=\"500\" filter=\"url(#tessGrain)\"></rect>\n  </svg>\n  <div class=\"vignette\"></div>\n\n  <header class=\"hud\">\n    <p class=\"eyebrow\">Tesseract / 4D Hypercube</p>\n    <p class=\"lede\">Sixteen vertices, thirty two edges, eight cubic cells resolved through two rotating planes of the fourth dimension.</p>\n  </header>\n\n  <section class=\"panel\">\n    <div class=\"row\"><span class=\"k\">Vertices</span><span class=\"v\">16</span></div>\n    <div class=\"row\"><span class=\"k\">Edges</span><span class=\"v\">32</span></div>\n    <div class=\"row\"><span class=\"k\">Cells</span><span class=\"v\">8</span></div>\n    <div class=\"row\"><span class=\"k\">XW plane</span><span class=\"v\" id=\"angXw\">0&deg;</span></div>\n    <div class=\"row\"><span class=\"k\">YW plane</span><span class=\"v\" id=\"angYw\">0&deg;</span></div>\n    <div class=\"row\"><span class=\"k\">W depth</span><span class=\"v\" id=\"wDepth\">0.000</span></div>\n    <div class=\"meter\"><i id=\"wBar\"></i></div>\n    <div class=\"row\"><span class=\"k\">Frames</span><span class=\"v\" id=\"fps\">60 fps</span></div>\n  </section>\n\n  <footer class=\"legend\">\n    <span class=\"hint\">Drag to orbit</span>\n    <span class=\"readout\">4D to 3D to 2D / perspective 3.4</span>\n  </footer>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/tesseract-hypercube-4d/index.html","archivePath":"animaciones-tesseract-hypercube-4d/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/tesseract-hypercube-4d/script.js","archivePath":"animaciones-tesseract-hypercube-4d/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/tesseract-hypercube-4d/styles.css","archivePath":"animaciones-tesseract-hypercube-4d/styles.css"}]}
