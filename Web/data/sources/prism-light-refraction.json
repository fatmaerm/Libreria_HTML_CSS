{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Prism Light Refraction</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"prism-scene\" aria-label=\"Refracción de haz de luz blanca a través de un prisma\">\n    <div class=\"laser-beam white-beam\"></div>\n    <div class=\"glass-prism\">\n      <div class=\"prism-internal-glow\"></div>\n    </div>\n    <div class=\"rainbow-beam\">\n      <div class=\"spectrum-band band-red\"></div>\n      <div class=\"spectrum-band band-orange\"></div>\n      <div class=\"spectrum-band band-yellow\"></div>\n      <div class=\"spectrum-band band-green\"></div>\n      <div class=\"spectrum-band band-cyan\"></div>\n      <div class=\"spectrum-band band-blue\"></div>\n      <div class=\"spectrum-band band-violet\"></div>\n    </div>\n    <div class=\"prism-title\">DISPERSIÓN ÓPTICA // ESPECTRO VISIBLE</div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/prism-light-refraction/index.html","archivePath":"prism-light-refraction/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/prism-light-refraction/LICENSE","archivePath":"prism-light-refraction/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/prism-light-refraction/styles.css","archivePath":"prism-light-refraction/styles.css"}]}
