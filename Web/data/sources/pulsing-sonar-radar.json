{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pulsing Sonar Radar</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"sonar-wrapper\">\n    <div class=\"radar-scope\" aria-label=\"Pantalla de radar táctico\">\n      <div class=\"ring ring-1\"></div>\n      <div class=\"ring ring-2\"></div>\n      <div class=\"ring ring-3\"></div>\n      <div class=\"ring ring-4\"></div>\n      <div class=\"axis axis-x\"></div>\n      <div class=\"axis axis-y\"></div>\n      <div class=\"sweep-beam\"></div>\n      \n      <div class=\"blip blip-1\" style=\"top: 28%; left: 66%;\"></div>\n      <div class=\"blip blip-2\" style=\"top: 72%; left: 34%;\"></div>\n      <div class=\"blip blip-3\" style=\"top: 22%; left: 30%;\"></div>\n      \n      <div class=\"scope-hub\"></div>\n      <div class=\"radar-info\">\n        <span class=\"tag\">SONAR DEEP // 45kHz</span>\n        <span class=\"coords\">ECOS ACTIVOS: 3</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/pulsing-sonar-radar/index.html","archivePath":"pulsing-sonar-radar/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/pulsing-sonar-radar/LICENSE","archivePath":"pulsing-sonar-radar/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/pulsing-sonar-radar/styles.css","archivePath":"pulsing-sonar-radar/styles.css"}]}
