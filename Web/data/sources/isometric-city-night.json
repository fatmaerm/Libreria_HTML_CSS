{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Isometric City Night</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"city-scene\" aria-label=\"Ciudad isométrica cyberpunk de noche\">\n    <div class=\"iso-plane\">\n      <!-- Rascacielos 1 -->\n      <div class=\"building b1\">\n        <div class=\"face roof\">\n          <div class=\"antenna\">\n            <span class=\"beacon\"></span>\n          </div>\n        </div>\n        <div class=\"face wall-left\">\n          <div class=\"windows\"></div>\n        </div>\n        <div class=\"face wall-right\">\n          <div class=\"windows\"></div>\n        </div>\n      </div>\n      \n      <!-- Rascacielos 2 -->\n      <div class=\"building b2\">\n        <div class=\"face roof\"></div>\n        <div class=\"face wall-left\">\n          <div class=\"windows\"></div>\n        </div>\n        <div class=\"face wall-right\">\n          <div class=\"windows\"></div>\n        </div>\n      </div>\n\n      <!-- Calles luminosas -->\n      <div class=\"street street-h\">\n        <div class=\"car-light car-1\"></div>\n      </div>\n      <div class=\"street street-v\">\n        <div class=\"car-light car-2\"></div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/isometric-city-night/index.html","archivePath":"isometric-city-night/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/isometric-city-night/LICENSE","archivePath":"isometric-city-night/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/isometric-city-night/styles.css","archivePath":"isometric-city-night/styles.css"}]}
