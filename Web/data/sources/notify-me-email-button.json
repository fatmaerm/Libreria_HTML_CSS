{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Notify Me Email Button</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n    <input class=\"c-checkbox\" type=\"checkbox\" id=\"checkbox\">\r\n    <div class=\"c-formContainer\">\r\n      <form class=\"c-form\" action=\"\">\r\n        <input class=\"c-form__input\" placeholder=\"E-mail\" type=\"email\" pattern=\"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{1,63}$\" required>\r\n        <label class=\"c-form__buttonLabel\" for=\"checkbox\">\r\n          <button class=\"c-form__button\" type=\"button\">Send</button>\r\n        </label>\r\n        <label class=\"c-form__toggle\" for=\"checkbox\" data-title=\"Notify me\"></label>\r\n      </form>\r\n    </div>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/notify-me-email-button/index.html","archivePath":"notify-me-email-button/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/notify-me-email-button/style.css","archivePath":"notify-me-email-button/style.css"}]}
