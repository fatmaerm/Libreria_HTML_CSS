{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Profile Card 02</title>\r\n\r\n    <link rel=\"stylesheet\" href=\"styles.css\">\r\n</head>\r\n<body>\r\n   <div class=\"container\">\r\n    <article class=\"card\">\r\n        <div class=\"background\">\r\n            <img src=\"assets/peakpx-removebg-preview.png\" alt=\"profile\">\r\n        </div>\r\n\r\n        <div class=\"content\">\r\n            <h2>Peter Parker</h2>\r\n\r\n            <p> \r\n                Junior full-stack engineer at\r\n                <a href=\"\" class=\"link\" title=\"Gevstack\">GevStack</a>\r\n            </p>\r\n            <p>Helping with:</p>\r\n            <ul class=\"chips\">\r\n                <li class=\"chip\">MERN Stack</li>\r\n                <li class=\"chip\">Node.js</li>\r\n                <li class=\"chip\">Graphics Designing</li>\r\n            </ul>\r\n\r\n            <div class=\"action-button\">\r\n                <a href=\"#book-a-mentor\" title=\"Book a Session\">Book a Session</a>\r\n                <a href=\"#learn-more\" title=\"Learn More\">Learn More</a>\r\n            </div>\r\n        </div>\r\n    </article>\r\n   </div> \r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"instagram.svg","relativePath":"assets/instagram.svg","path":"../BibliotecaDeHtml_CSS/profile-card-02/assets/instagram.svg","archivePath":"profile-card-02/assets/instagram.svg"},{"name":"linkedin.svg","relativePath":"assets/linkedin.svg","path":"../BibliotecaDeHtml_CSS/profile-card-02/assets/linkedin.svg","archivePath":"profile-card-02/assets/linkedin.svg"},{"name":"peakpx-removebg-preview.png","relativePath":"assets/peakpx-removebg-preview.png","path":"../BibliotecaDeHtml_CSS/profile-card-02/assets/peakpx-removebg-preview.png","archivePath":"profile-card-02/assets/peakpx-removebg-preview.png"},{"name":"threads.svg","relativePath"