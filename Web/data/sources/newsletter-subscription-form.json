{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Newsletter Subscription Form</title>\n<meta name=\"description\" content=\"Animated newsletter email subscription form with success animation.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"nl-card\">\n  <div class=\"nl-icon\">✉️</div>\n  <h2>Stay in the loop</h2>\n  <p>Get the latest components, tips and inspiration.</p>\n  <form class=\"nl-form\" id=\"nlForm\" novalidate>\n    <input type=\"email\" class=\"nl-input\" id=\"nlEmail\" placeholder=\"you@example.com\" required>\n    <button type=\"submit\" class=\"nl-btn\" id=\"nlBtn\">Subscribe</button>\n  </form>\n  <p class=\"nl-small\">No spam. Unsubscribe anytime.</p>\n  <div class=\"nl-success\" id=\"nlSuccess\" hidden>🎉 You're subscribed!</div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/newsletter-subscription-form/index.html","archivePath":"newsletter-subscription-form/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/newsletter-subscription-form/LICENSE","archivePath":"newsletter-subscription-form/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/newsletter-subscription-form/script.js","archivePath":"newsletter-subscription-form/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/newsletter-subscription-form/styles.css","archivePath":"newsletter-subscription-form/styles.css"}]}
