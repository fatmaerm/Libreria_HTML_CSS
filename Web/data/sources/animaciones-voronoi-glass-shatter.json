{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Voronoi Glass Shatter</title>\n<meta name=\"description\" content=\"A tempered pane fractures along branching crack fronts into Voronoi shards that separate, spin, fall away and leave a glowing residual rim.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"stage\">\n  <header class=\"mast\">\n    <span class=\"kicker\">Fracture Study 01</span>\n    <h1>Voronoi Glass Shatter</h1>\n    <p class=\"lede\">Crack fronts propagate by random walk across the pane until every cell is bounded by a bisector, then the shards unlock, drift outward and fall through the frame.</p>\n  </header>\n\n  <section class=\"rig\">\n    <div class=\"window\">\n      <div class=\"glassroom\" aria-hidden=\"true\">\n        <span class=\"orb o1\"></span>\n        <span class=\"orb o2\"></span>\n        <span class=\"orb o3\"></span>\n        <span class=\"orb o4\"></span>\n        <span class=\"orb o5\"></span>\n        <span class=\"orb o6\"></span>\n        <span class=\"shaft\"></span>\n        <span class=\"floorline\"></span>\n      </div>\n      <canvas class=\"pane\" id=\"pane\" role=\"img\" aria-label=\"A glass pane that fractures into Voronoi shards, which separate, rotate and fall away while their edges glow.\"></canvas>\n      <div class=\"sheen\" aria-hidden=\"true\"></div>\n      <div class=\"vignette\" aria-hidden=\"true\"></div>\n      <div class=\"grain\" aria-hidden=\"true\"></div>\n      <span class=\"corner tl\" aria-hidden=\"true\"></span>\n      <span class=\"corner tr\" aria-hidden=\"true\"></span>\n      <span class=\"corner bl\" aria-hidden=\"true\"></span>\n      <span class=\"corner br\" aria-hidden=\"true\"></span>\n    </div>\n  </section>\n\n  <div class=\"hud\">\n    <div class=\"stat\"><span class=\"k\">Phase</span><span class=\"v\" id=\"phase\">Intact</span></div>\n    <div class=\"stat\"><span class=\"k\">Shards</span><span class=\"v\" id=\"cells\">0</span></div>\n    <div class=\"stat\"><span class=\"k\">Crack Fronts</span><span class=\"v\" id=\"fronts\">0</span></div>\n    <div class=\"stat\"><span class=\"k\">Integrity</span><span class=\"v\" id=\"integrity\">100%</span></div>\n    <div class=\"meter\"><span id=\"bar\"></span></div>\n  </div>\n\n  <p class=\"hint\">Press anywhere on the pane to trigger the fracture from that point</p>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/voronoi-glass-shatter/index.html","archivePath":"animaciones-voronoi-glass-shatter/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/voronoi-glass-shatter/script.js","archivePath":"animaciones-voronoi-glass-shatter/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/voronoi-glass-shatter/styles.css","archivePath":"animaciones-voronoi-glass-shatter/styles.css"}]}
