{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Grid Image Slider</title>\n<meta name=\"description\" content=\"3-column CSS grid-based image reveal slider with staggered entry.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"gslider\">\n  <div class=\"gtrack\" id=\"gtrack\">\n    <div class=\"gslide\"><div class=\"gcell\" style=\"background:#1e1b4b\"><span>🪐</span></div><div class=\"gcell\" style=\"background:#14532d\"><span>🌋</span></div><div class=\"gcell\" style=\"background:#1c1917\"><span>🌲</span></div></div><div class=\"gslide\"><div class=\"gcell\" style=\"background:#1c3547\"><span>🌊</span></div><div class=\"gcell\" style=\"background:#3b0764\"><span>⭐</span></div><div class=\"gcell\" style=\"background:#1a2035\"><span>🔥</span></div></div><div class=\"gslide\"><div class=\"gcell\" style=\"background:#7f1d1d\"><span>🌙</span></div><div class=\"gcell\" style=\"background:#064e3b\"><span>🌿</span></div><div class=\"gcell\" style=\"background:#1e3a5f\"><span>❄️</span></div></div><div class=\"gslide\"><div class=\"gcell\" style=\"background:#3b1c8c\"><span>⚡</span></div><div class=\"gcell\" style=\"background:#065f46\"><span>🎯</span></div><div class=\"gcell\" style=\"background:#1e1e1e\"><span>🌌</span></div></div>\n  </div>\n  <div class=\"gcontrols\">\n    <button id=\"gprev\">‹</button>\n    <button class=\"gdot active\" data-i=\"0\"></button><button class=\"gdot\" data-i=\"1\"></button><button class=\"gdot\" data-i=\"2\"></button><button class=\"gdot\" data-i=\"3\"></button>\n    <button id=\"gnext\">›</button>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/grid-image-slider/index.html","archivePath":"grid-image-slider/index.html"},{"name":"LICENSE","relativePath":"