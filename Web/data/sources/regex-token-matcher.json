{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>RegEx Token Matcher</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"regex-card\">\n    <div class=\"regex-pattern\">\n      <span class=\"delim\">/</span><span class=\"p-group\">([a-zA-Z0-9._%+-]+)</span><span class=\"p-at\">@</span><span class=\"p-domain\">([a-zA-Z0-9.-]+)</span><span class=\"delim\">/g</span>\n    </div>\n    <div class=\"regex-sample\">\n      <span>Email: </span><span class=\"match user\">dev_alex</span><span class=\"match at\">@</span><span class=\"match domain\">quantum.io</span>\n    </div>\n    <div class=\"token-legend\">\n      <span class=\"tag-group\">Grupo 1: Usuario</span>\n      <span class=\"tag-domain\">Grupo 2: Dominio</span>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/regex-token-matcher/index.html","archivePath":"regex-token-matcher/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/regex-token-matcher/LICENSE","archivePath":"regex-token-matcher/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/regex-token-matcher/script.js","archivePath":"regex-token-matcher/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/regex-token-matcher/styles.css","archivePath":"regex-token-matcher/styles.css"}]}
