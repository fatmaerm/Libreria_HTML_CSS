{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Email Validation Form</title>\n<meta name=\"description\" content=\"Real-time email validation form with animated feedback indicators.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"val-card\">\n  <h2>Email Validation</h2>\n  <div class=\"vfield\" id=\"vfield\">\n    <input type=\"email\" class=\"vinput\" id=\"vemail\" placeholder=\"Enter your email\">\n    <span class=\"vstatus\" id=\"vstatus\"></span>\n  </div>\n  <ul class=\"vhints\" id=\"vhints\">\n    <li data-rule=\"nonempty\">Not empty</li>\n    <li data-rule=\"atsign\">Contains @</li>\n    <li data-rule=\"domain\">Has valid domain</li>\n    <li data-rule=\"tld\">Has TLD (.com etc.)</li>\n  </ul>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/email-validation-form/index.html","archivePath":"email-validation-form/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/email-validation-form/LICENSE","archivePath":"email-validation-form/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/email-validation-form/script.js","archivePath":"email-validation-form/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/email-validation-form/styles.css","archivePath":"email-validation-form/styles.css"}]}
