{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Markdown Checklist Strike</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"task-card\">\n    <div class=\"task-header\">\n      <span class=\"task-title\">RELEASE SPRINT // V2.0</span>\n      <span class=\"progress-pct\" id=\"progressPct\">2 / 3</span>\n    </div>\n    <div class=\"task-list\">\n      <label class=\"task-item checked\">\n        <input type=\"checkbox\" checked>\n        <span class=\"checkmark\">✓</span>\n        <span class=\"task-text\">Optimizar bundle con compresión Brotli</span>\n      </label>\n      <label class=\"task-item checked\">\n        <input type=\"checkbox\" checked>\n        <span class=\"checkmark\">✓</span>\n        <span class=\"task-text\">Migrar endpoints REST a WebSockets</span>\n      </label>\n      <label class=\"task-item\">\n        <input type=\"checkbox\">\n        <span class=\"checkmark\">✓</span>\n        <span class=\"task-text\">Validación de accesibilidad WCAG AAA</span>\n      </label>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/markdown-checklist-strike/index.html","archivePath":"markdown-checklist-strike/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/markdown-checklist-strike/LICENSE","archivePath":"markdown-checklist-strike/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/markdown-checklist-strike/script.js","archivePath":"markdown-checklist-strike/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/markdown-checklist-strike/styles.css","archivePath":"markdown-checklist-strike/styles.css"}]}
