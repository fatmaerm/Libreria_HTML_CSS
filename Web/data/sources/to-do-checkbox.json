{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>To Do Checkbox</title>\r\n\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n    <div class=\"container\">\r\n        <div class=\"checkboxes\">\r\n            <div class=\"checkbox-wrapper-11\">\r\n                <input id=\"02-11\" type=\"checkbox\" name=\"r\" value=\"2\">\r\n                <label for=\"02-11\">Sherni ke sath chill ❤︎</label>\r\n            </div>\r\n    \r\n            <div class=\"checkbox-wrapper-11\">\r\n                <input id=\"03-11\" type=\"checkbox\" name=\"r\" value=\"3\">\r\n                <label for=\"03-11\">Gym 🦾 </label>\r\n            </div>\r\n    \r\n            <div class=\"checkbox-wrapper-11\">\r\n                <input id=\"04-11\" type=\"checkbox\" name=\"r\" value=\"4\">\r\n                <label for=\"04-11\"><p>Padhayi <span style=\"color: red;\">✘</span> ye kya hota hai</p></label>\r\n            </div>\r\n    \r\n            <div class=\"checkbox-wrapper-11\">\r\n                <input id=\"05-11\" type=\"checkbox\" name=\"r\" value=\"5\">\r\n                <label for=\"05-11\">Trip to Thailand ✈</label>\r\n            </div>\r\n    \r\n            <div class=\"checkbox-wrapper-11\">\r\n                <input id=\"06-11\" type=\"checkbox\" name=\"r\" value=\"6\">\r\n                <label for=\"06-11\">Paise kamane ke Sapne 💸 </label>\r\n            </div>\r\n        </div>\r\n    </div>    \r\n</body>\r\n</html>\r\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/to-do-checkbox/index.html","archivePath":"to-do-checkbox/index.html"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/to-do-checkbox/style.css","archivePath":"to-do-checkbox/style.css"}]}
