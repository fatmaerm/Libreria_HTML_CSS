{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Circuit Board Energy Pulse</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"pcb-scene\">\n    <div class=\"pcb-chip\">\n      <span class=\"chip-label\">AI CORE</span>\n    </div>\n    \n    <!-- Pistas de circuito con pulsos de datos -->\n    <div class=\"trace trace-top\">\n      <div class=\"pulse\"></div>\n    </div>\n    <div class=\"trace trace-right\">\n      <div class=\"pulse\"></div>\n    </div>\n    <div class=\"trace trace-bottom\">\n      <div class=\"pulse\"></div>\n    </div>\n    <div class=\"trace trace-left\">\n      <div class=\"pulse\"></div>\n    </div>\n    \n    <div class=\"pcb-status\">BUS DE DATOS // ENERGÍA ÓPTIMA</div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/circuit-board-energy-pulse/index.html","archivePath":"circuit-board-energy-pulse/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/circuit-board-energy-pulse/LICENSE","archivePath":"circuit-board-energy-pulse/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/circuit-board-energy-pulse/styles.css","archivePath":"circuit-board-energy-pulse/styles.css"}]}
