{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Image Reveal Hover Effect</title>\n<meta name=\"description\" content=\"Circular spotlight image reveal following the cursor on hover.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"reveal-wrap\" id=\"rw\">\n  <div class=\"layer dark\"><h2>Before</h2><p>Default state</p></div>\n  <div class=\"layer light\" id=\"lightLayer\"><h2>Revealed</h2><p>Hover spotlight</p></div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/image-reveal-hover-effect/index.html","archivePath":"image-reveal-hover-effect/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/image-reveal-hover-effect/LICENSE","archivePath":"image-reveal-hover-effect/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/image-reveal-hover-effect/script.js","archivePath":"image-reveal-hover-effect/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/image-reveal-hover-effect/styles.css","archivePath":"image-reveal-hover-effect/styles.css"}]}
