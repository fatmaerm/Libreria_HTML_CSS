{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Mandelbrot Fractal Zoom</title>\n<meta name=\"description\" content=\"An uninterrupted dive into the Mandelbrot boundary, shaded by escape time on a low resolution buffer that is upscaled smoothly to hold a steady frame rate.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<main class=\"scene\">\n  <div class=\"mesh\" aria-hidden=\"true\"></div>\n  <div class=\"halo halo-a\" aria-hidden=\"true\"></div>\n  <div class=\"halo halo-b\" aria-hidden=\"true\"></div>\n\n  <header class=\"masthead\">\n    <p class=\"eyebrow\"><span class=\"pip\"></span>Escape time field</p>\n    <h1>Mandelbrot Fractal Zoom</h1>\n    <p class=\"lede\">Every cell of a tiny offscreen buffer is iterated against the escape radius, shaded by how many steps it survives, then stretched across the plate by the compositor. The camera descends to a filament on the boundary and climbs straight back out.</p>\n  </header>\n\n  <section class=\"stage\">\n    <div class=\"plate\">\n      <canvas id=\"plot\"></canvas>\n      <div class=\"layer scan\" aria-hidden=\"true\"></div>\n      <div class=\"layer grain\" aria-hidden=\"true\"></div>\n      <div class=\"layer vignette\" aria-hidden=\"true\"></div>\n      <div class=\"hudlayer\" aria-hidden=\"true\">\n        <span class=\"tag tag-tl\">c = <b id=\"sC\">-0.7436 + 0.1318i</b></span>\n        <span class=\"tag tag-tr\">iters <b id=\"sIter\">90</b></span>\n        <span class=\"tag tag-bl\">buffer <b id=\"sBuf\">150 &times; 94</b></span>\n        <span class=\"tag tag-br\"><b id=\"sFps\">60</b> fps</span>\n      </div>\n    </div>\n\n    <div class=\"readout\">\n      <div class=\"stat\"><span class=\"sk\">Magnification</span><span class=\"sv\" id=\"sZoom\">1&times;</span></div>\n      <div class=\"stat\"><span class=\"sk\">Half height</span><span class=\"sv\" id=\"sSpan\">0.000e+0</span></div>\n      <div class=\"stat\"><span class=\"sk\">Re centre</span><span class=\"sv\" id=\"sDrift\">0.0&times;</span></div>\n      <div class=\"stat\"><span class=\"sk\">Rows / frame</span><span class=\"sv\" id=\"sRows\">0</span></div>\n      <div class=\"stat wide\"><span class=\"sk\">Phase</span><span class=\"sv\" id=\"sPhase\">Descent</span></div>\n    </div>\n  </section>\n\n  <footer class=\"footing\">\n    <ul class=\"legend\">\n      <li><span class=\"swatch sw-1\"></span>Short escape</li>\n      <li><span class=\"swatch sw-2\"></span>Boundary band</li>\n      <li><span class=\"swatch sw-3\"></span>Interior</li>\n    </ul>\n    <p class=\"note\">Move the pointer across the plate to sample the escape count under the reticle.</p>\n  </footer>\n</main>\n</body>\n</html>\n","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../creaciones-primium/animaciones/mandelbrot-fractal-zoom/index.html","archivePath":"animaciones-mandelbrot-fractal-zoom/index.html"},{"name":"script.js","relativePath":"script.js","path":"../creaciones-primium/animaciones/mandelbrot-fractal-zoom/script.js","archivePath":"animaciones-mandelbrot-fractal-zoom/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../creaciones-primium/animaciones/mandelbrot-fractal-zoom/styles.css","archivePath":"animaciones-mandelbrot-fractal-zoom/styles.css"}]}
