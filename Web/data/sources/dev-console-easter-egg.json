{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Dev Console Easter Egg</title>\n<meta name=\"description\" content=\"Fun ASCII art console easter egg that triggers on the Konami code.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"page\">\n  <h1>🥚 Easter Egg</h1>\n  <p>Type the Konami Code: ↑ ↑ ↓ ↓ ← → ← → B A</p>\n  <div class=\"konami-hint\" id=\"kh\"></div>\n  <div class=\"unlocked\" id=\"unlocked\" hidden>\n    <div class=\"egg\">🎉 You found it! +30 lives</div>\n  </div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/dev-console-easter-egg/index.html","archivePath":"dev-console-easter-egg/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/dev-console-easter-egg/LICENSE","archivePath":"dev-console-easter-egg/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/dev-console-easter-egg/script.js","archivePath":"dev-console-easter-egg/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/dev-console-easter-egg/styles.css","archivePath":"dev-console-easter-egg/styles.css"}]}
