{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Stagger Fade-in Animation</title>\n<meta name=\"description\" content=\"Card grid with staggered CSS fade-in reveal on page load.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<div class=\"stag-grid\">\n  <div class=\"stag-card\" style=\"--d:0s\"><div class=\"stag-icon\">⚡</div><p>Item 1</p></div><div class=\"stag-card\" style=\"--d:0.1s\"><div class=\"stag-icon\">🌌</div><p>Item 2</p></div><div class=\"stag-card\" style=\"--d:0.2s\"><div class=\"stag-icon\">🎯</div><p>Item 3</p></div><div class=\"stag-card\" style=\"--d:0.30000000000000004s\"><div class=\"stag-icon\">💡</div><p>Item 4</p></div><div class=\"stag-card\" style=\"--d:0.4s\"><div class=\"stag-icon\">🔥</div><p>Item 5</p></div><div class=\"stag-card\" style=\"--d:0.5s\"><div class=\"stag-icon\">🌊</div><p>Item 6</p></div><div class=\"stag-card\" style=\"--d:0.6000000000000001s\"><div class=\"stag-icon\">🪐</div><p>Item 7</p></div><div class=\"stag-card\" style=\"--d:0.7000000000000001s\"><div class=\"stag-icon\">💎</div><p>Item 8</p></div><div class=\"stag-card\" style=\"--d:0.8s\"><div class=\"stag-icon\">🎨</div><p>Item 9</p></div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/stagger-fade-in-animation/index.html","archivePath":"stagger-fade-in-animation/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/stagger-fade-in-animation/LICENSE","archivePath":"stagger-fade-in-animation/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/stagger-fade-in-animation/styles.css","archivePath":"stagger-fade-in-animation/styles.css"}]}
