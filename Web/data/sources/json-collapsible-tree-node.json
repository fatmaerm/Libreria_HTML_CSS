{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>JSON Collapsible Tree Node</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"json-card\">\n    <div class=\"json-header\">\n      <span>config.json</span>\n      <span class=\"badge\">JSON TREE</span>\n    </div>\n    <div class=\"json-body\">\n      <div class=\"json-line\">\n        <span class=\"toggle-arrow\" id=\"toggleObj\">▼</span>\n        <span class=\"json-key\">\"cluster\"</span>: {\n      </div>\n      <div class=\"json-nested\" id=\"nestedContent\">\n        <div class=\"json-line\"><span class=\"json-key\">\"nodes\"</span>: <span class=\"json-num\">12</span>,</div>\n        <div class=\"json-line\"><span class=\"json-key\">\"region\"</span>: <span class=\"json-str\">\"us-central-1\"</span>,</div>\n        <div class=\"json-line\"><span class=\"json-key\">\"ssl\"</span>: <span class=\"json-bool\">true</span>,</div>\n        <div class=\"json-line\"><span class=\"json-key\">\"version\"</span>: <span class=\"json-str\">\"v2.14.0\"</span></div>\n      </div>\n      <div class=\"json-line\">}</div>\n    </div>\n  </div>\n  <script src=\"script.js\"></script>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/json-collapsible-tree-node/index.html","archivePath":"json-collapsible-tree-node/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/json-collapsible-tree-node/LICENSE","archivePath":"json-collapsible-tree-node/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/json-collapsible-tree-node/script.js","archivePath":"json-collapsible-tree-node/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/json-collapsible-tree-node/styles.css","archivePath":"json-collapsible-tree-node/styles.css"}]}
