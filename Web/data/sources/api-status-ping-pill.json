{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>API Status Ping Pill</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"status-stack\">\n    <div class=\"status-pill pill-prod\">\n      <span class=\"ping-circle\"><span class=\"ping-wave\"></span></span>\n      <span class=\"cluster-name\">API PRODUCTION // EU-WEST</span>\n      <span class=\"ping-ms\">18ms</span>\n      <span class=\"status-label\">100% OPERACIONAL</span>\n    </div>\n    <div class=\"status-pill pill-staging\">\n      <span class=\"ping-circle\"><span class=\"ping-wave\"></span></span>\n      <span class=\"cluster-name\">STAGING // US-EAST</span>\n      <span class=\"ping-ms\">42ms</span>\n      <span class=\"status-label\">99.8% ESTABLE</span>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/api-status-ping-pill/index.html","archivePath":"api-status-ping-pill/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/api-status-ping-pill/LICENSE","archivePath":"api-status-ping-pill/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/api-status-ping-pill/styles.css","archivePath":"api-status-ping-pill/styles.css"}]}
