{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Git Branch Graph Visualizer</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"git-card\">\n    <div class=\"git-header\">\n      <span class=\"repo-badge\">git log --graph --oneline</span>\n      <span class=\"branch-tag\">main</span>\n    </div>\n    <div class=\"graph-tree\">\n      <div class=\"node-row\">\n        <div class=\"lane-col\">\n          <div class=\"git-dot dot-main active-pulse\"></div>\n          <div class=\"line line-main\"></div>\n        </div>\n        <div class=\"commit-info\">\n          <span class=\"commit-hash\">c850d09</span>\n          <span class=\"commit-msg\">feat: merge branch 'feat/auth-v2' into main</span>\n        </div>\n      </div>\n      <div class=\"node-row\">\n        <div class=\"lane-col double-lane\">\n          <div class=\"git-dot dot-main\"></div>\n          <div class=\"line line-main\"></div>\n          <div class=\"git-dot dot-feat\"></div>\n          <div class=\"line line-feat\"></div>\n        </div>\n        <div class=\"commit-info\">\n          <span class=\"commit-hash\">8f21bc4</span>\n          <span class=\"commit-msg\">refactor(jwt): implement refresh token rotation</span>\n        </div>\n      </div>\n      <div class=\"node-row\">\n        <div class=\"lane-col double-lane\">\n          <div class=\"git-dot dot-main\"></div>\n          <div class=\"line line-main\"></div>\n          <div class=\"git-dot dot-feat\"></div>\n          <div class=\"curve-in\"></div>\n        </div>\n        <div class=\"commit-info\">\n          <span class=\"commit-hash\">4a921d0</span>\n          <span class=\"commit-msg\">feat: add oauth2 github provider endpoint</span>\n        </div>\n      </div>\n      <div class=\"node-row\">\n        <div class=\"lane-col\">\n          <div class=\"git-dot dot-main\"></div>\n        </div>\n        <div class=\"commit-info\">\n          <span class=\"commit-hash\">11ef882</span>\n          <span class=\"commit-msg\">initial: setup project architecture & router</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/git-branch-graph-visualizer/index.html","archivePath":"git-branch-graph-visualizer/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/git-branch-graph-visualizer/LICENSE","archivePath":"git-branch-graph-visualizer/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/git-branch-graph-visualizer/styles.css","archivePath":"git-branch-graph-visualizer/styles.css"}]}
