{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Border Draw Button</title>\n<meta name=\"description\" content=\"Button whose border is drawn around it on hover using SVG stroke dash trick.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<button class=\"draw-btn\">\n  <svg class=\"border-svg\" viewBox=\"0 0 200 56\">\n    <rect class=\"border-rect\" x=\"1\" y=\"1\" width=\"198\" height=\"54\" rx=\"6\"/>\n  </svg>\n  <span>Get Started</span>\n</button>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/border-draw-button/index.html","archivePath":"border-draw-button/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/border-draw-button/LICENSE","archivePath":"border-draw-button/LICENSE"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/border-draw-button/styles.css","archivePath":"border-draw-button/styles.css"}]}
