{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Knob Rotary Switch</title>\n<meta name=\"description\" content=\"Draggable rotary knob control with value readout.\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script defer src=\"script.js\"></script>\n</head>\n<body>\n<div class=\"knob-panel\">\n  <div class=\"knob\" id=\"knob\">\n    <div class=\"knob-body\">\n      <div class=\"knob-mark\"></div>\n    </div>\n    <svg class=\"knob-arc\" viewBox=\"0 0 100 100\">\n      <circle class=\"arc-track\" cx=\"50\" cy=\"50\" r=\"40\"/>\n      <circle class=\"arc-fill\" cx=\"50\" cy=\"50\" r=\"40\" id=\"arcFill\"/>\n    </svg>\n  </div>\n  <div class=\"knob-label\" id=\"knobLbl\">50</div>\n  <div class=\"knob-name\">Volume</div>\n</div>\n</body>\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../CreacionesNuevas/knob-rotary-switch/index.html","archivePath":"knob-rotary-switch/index.html"},{"name":"LICENSE","relativePath":"LICENSE","path":"../CreacionesNuevas/knob-rotary-switch/LICENSE","archivePath":"knob-rotary-switch/LICENSE"},{"name":"script.js","relativePath":"script.js","path":"../CreacionesNuevas/knob-rotary-switch/script.js","archivePath":"knob-rotary-switch/script.js"},{"name":"styles.css","relativePath":"styles.css","path":"../CreacionesNuevas/knob-rotary-switch/styles.css","archivePath":"knob-rotary-switch/styles.css"}]}
