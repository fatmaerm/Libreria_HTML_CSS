{"html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Tic Tac Toe</title>\r\n    <!-- Google Fonts -->\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Raleway:wght@700&display=swap\" rel=\"stylesheet\">\r\n    <!-- Stylesheet -->\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n   <div class=\"wrapper\">\r\n       <div class=\"container\">\r\n           <button class=\"button-option\"></button>\r\n           <button class=\"button-option\"></button>\r\n           <button class=\"button-option\"></button>\r\n           <button class=\"button-option\"></button>\r\n           <button class=\"button-option\"></button>\r\n           <button class=\"button-option\"></button>\r\n           <button class=\"button-option\"></button>\r\n           <button class=\"button-option\"></button>\r\n           <button class=\"button-option\"></button>\r\n       </div>\r\n       <button id=\"restart\">Restart</button>\r\n   </div>\r\n\r\n   <div class=\"popup hide\">\r\n       <p id=\"message\">Sample Message</p>\r\n       <button id=\"new-game\">New Game</button>\r\n   </div>\r\n   \r\n    <!-- Script -->\r\n    <script src=\"script.js\"></script>\r\n</body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/tic-tac-toe/index.html","archivePath":"tic-tac-toe/index.html"},{"name":"script.js","relativePath":"script.js","path":"../BibliotecaDeHtml_CSS/tic-tac-toe/script.js","archivePath":"tic-tac-toe/script.js"},{"name":"style.css","relativePath":"style.css","path":"../BibliotecaDeHtml_CSS/tic-tac-toe/style.css","archivePath":"tic-tac-toe/style.css"}]}
