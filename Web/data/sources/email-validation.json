{"html":"<!DOCTYPE html>\r\n   <html lang=\"en\">\r\n   <head>\r\n      <meta charset=\"UTF-8\">\r\n      <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\r\n      <!--=============== REMIXICONS ===============-->\r\n      <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css\">\r\n\r\n      <!--=============== CSS ===============-->\r\n      <link rel=\"stylesheet\" href=\"assets/css/styles.css\">\r\n\r\n      <title>Email Validation</title>\r\n   </head>\r\n   <body>\r\n       <div class=\"container\">\r\n         <form action=\"\" class=\"form\" id=\"form\">\r\n            <div class=\"form__field\">\r\n               <label for=\"email\" class=\"form__label\">Email Address</label>\r\n               <input type=\"email\" placeholder=\"Write your email\"required id=\"email\" class=\"form__input\">\r\n               \r\n               <i class=\"ri-mail-line form__icon\"></i>\r\n\r\n               <div class=\"form__error\">\r\n                  <i class=\"ri-information-fill\"></i>\r\n                  <span>Invalid email format.</span>\r\n               </div>\r\n            </div>\r\n         </form>\r\n       </div>\r\n      \r\n      <!--=============== MAIN JS ===============-->\r\n      <script src=\"assets/js/main.js\"></script>\r\n   </body>\r\n</html>","inlineCss":[],"inlineJavaScript":[],"files":[{"name":"styles.css","relativePath":"assets/css/styles.css","path":"../BibliotecaDeHtml_CSS/email-validation/assets/css/styles.css","archivePath":"email-validation/assets/css/styles.css"},{"name":"main.js","relativePath":"assets/js/main.js","path":"../BibliotecaDeHtml_CSS/email-validation/assets/js/main.js","archivePath":"email-validation/assets/js/main.js"},{"name":"index.html","relativePath":"index.html","path":"../BibliotecaDeHtml_CSS/email-validation/index.html","archivePath":"email-validation/index.html"}]}
